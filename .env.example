# AI Studio keeps the default port. Render supplies PORT automatically.
PORT=3000
NODE_ENV=development
GEMINI_API_KEY=

# Gemini Flash-Lite quota guard. The app uses one rolling-window queue per
# model and keeps one request in reserve by default, so a configured 15 RPM
# quota starts at most 14 requests per rolling minute in this server process.
GEMINI_FLASH_LITE_RPM=15
GEMINI_FLASH_LITE_RPM_RESERVE=1
GEMINI_RATE_LIMIT_WINDOW_MS=60000
GEMINI_RATE_LIMIT_MAX_WAIT_MS=180000
# Legacy Google AI Studio export alias; prefer GEMINI_API_KEY.
API_KEY=

# Optional local/self-hosted AI. Production requests can only use these exact
# server-configured base URLs (comma-separate additional trusted endpoints).
OLLAMA_BASE_URL=
OLLAMA_ALLOWED_BASE_URLS=

# Set a stable random value (32+ characters) on every deployed instance.
# Current grading revision locks are process-local: run one writable server
# process until the persistence layer provides transactional compare-and-swap.
SESSION_SECRET=
COOKIE_SECURE=
TRUST_PROXY=
HEALTH_DETAILS=false
MAX_REQUEST_BODY_SIZE=25mb

# Explicit test/sandbox switch. Never enable demo auth on a public deployment.
ALLOW_DEMO_AUTH=false

# Firebase Admin is required on Render before deploying the restrictive rules.
FIREBASE_PROJECT_ID=
FIRESTORE_DATABASE_ID=(default)
FIREBASE_ADMIN_ENABLED=true
# Defaults on only when NODE_ENV=production and RENDER is enabled. Leave blank
# for local/AI Studio fallback behavior, or set true/false explicitly.
REQUIRE_FIRESTORE=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_BASE64=
GOOGLE_APPLICATION_CREDENTIALS=

# The web-SDK fallback preserves older AI Studio environments, but only works
# while their Firestore rules permit it. Admin credentials are preferred.
FIREBASE_WEB_FALLBACK=true
FIRESTORE_STARTUP_TIMEOUT_MS=15000

# Optional mounted-disk/local-test paths. Defaults to ./data.
QUIZMOKO_DATA_DIR=
QUIZMOKO_RECOVERY_DIR=
LOCAL_SAVE_DEBOUNCE_MS=250
