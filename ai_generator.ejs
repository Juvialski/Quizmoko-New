                <a href="/" class="mode-tab active">
                    <span>🤖</span>
                    AI GEN
                </a>
                <a href="/worksheet" class="mode-tab">
                    <span>📄</span>
                    WORKSHEET
                </a>
                <a href="/worksheet_answers" class="mode-tab">
                    <span>🔑</span>
                    ANSWERS
                </a>
                <% if (is_rmx_authorized) { %>
                <a href="/rmxflash" class="mode-tab">
                    <span>⚡</span>
                    RMXFLASH
                </a>
                <% } %>
            </div>
            <div class="card" style="border-top-left-radius: 0; border-top-right-radius: 0;">
                <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--hairline); padding-bottom: 16px; margin-bottom: 20px;">
                    <h3 style="margin:0; font-size: 18px; text-transform: none;">
                        <i data-lucide="sparkles" style="display:inline-block; vertical-align:middle; margin-right:8px; width:20px;"></i> AI Generator
                    </h3>
                    <button type="button" onclick="openApiKeyModal()" class="btn-secondary" id="api-key-btn"><i data-lucide="key" style="display:inline-block; vertical-align:middle; margin-right:6px; width:16px;"></i> API Key</button>
                </div>

                <form action="/generate_ai" method="POST" onsubmit="return handleAILoading(event, this)">

                    <!-- HIDDEN API KEY INPUT -->
                    <input type="hidden" name="api_key" id="hidden_api_key" required>
                    <input type="hidden" name="ollama_url" id="hidden_ollama_url" value="http://127.0.0.1:11434">
                    
                    <label style="margin-top:0;">Select AI Model</label>
                    <div style="display: grid; grid-template-columns: 1fr 140px; gap: 10px; align-items: center; margin-bottom: 16px;">
                        <select name="model_name" id="model_select" style="margin-bottom: 0;" onchange="updateCounterUI()">
                            <option value="gemini-3.6-flash">Gemini 3.6 Flash</option>
                            <option value="gemini-3.5-flash">Gemini 3.5 Flash</option>
                            <option value="gemini-3.5-flash-lite" selected>Gemini 3.5 Flash Lite (Best limits)</option>
                            <option value="gemini-3.1-flash-lite">Gemini 3.1 Flash Lite</option>
                            <option value="gemini-3.0-flash">Gemini 3.0 Flash</option>
                            <option value="gemini-2.5-flash">Gemini 2.5 Flash</option>
                            <option value="gemini-2.5-flash-lite">Gemini 2.5 Flash Lite</option>
                            <optgroup label="Local Models (Ollama)">
                                <option value="ollama:llama3">Llama 3 (Local)</option>
                                <option value="ollama:mistral">Mistral (Local)</option>
                                <option value="__install_ollama__">📥 Install Local Models...</option>
                            </optgroup>
                        </select>
                        
                        <div id="api-counter-badge" style="background: var(--surface-soft); color: var(--on-dark); padding: 8px 12px; border: 1px solid var(--hairline); font-weight: 700; white-space: nowrap; font-size: 11px; text-align: center; text-transform: uppercase;">
                            Loading...
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px;">
                        <div>
                            <label style="margin-top:0;">Quiz Topic</label>
                            <input type="text" name="topic" placeholder="e.g. Linear Equations" required id="topic-input" style="margin-bottom: 0;">
                        </div>
                        <div>
                            <label style="margin-top:0;">Subject / Folder</label>
                            <select name="subject" onchange="toggleCustomSubject(this)" required style="margin-bottom: 0;">
                                <% for (let s of (all_subjects || [])) { %>
                                    <option value="<%= typeof s !== 'undefined' ? s : '' %>" <% if (s == 'General') { %>selected<% } %>><%= typeof s !== 'undefined' ? s : '' %></option>
                                <% } %>
                                <option value="__custom__">➕ Custom...</option>
                            </select>
                            <input type="text" name="custom_subject" class="custom-subject-input" style="display:none; margin-top:5px; box-sizing: border-box;" placeholder="Enter folder name">
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px;">
                        <div>
                            <label style="margin-top:0;">Question Style</label>
                            <select name="question_style" required style="margin-bottom: 0;">
                                <option value="Simple / Direct">Simple / Direct</option>
                                <option value="Word Problems">Word Problems</option>
                                <option value="Mixed" selected>Mixed</option>
                            </select>
                        </div>
                        <div>
                            <label style="margin-top:0;">Test Type</label>
                            <select name="test_type" id="test_type_select" required onchange="toggleTypeDistribution()" style="margin-bottom: 0;">
                                <option value="Multiple Choice">Multiple Choice Only</option>
                                <option value="True/False">True/False Only</option>
                                <option value="Identification">Identification Only</option>
                                <option value="Open Ended">Open Ended Only</option>
                                <option value="Graphing">Graphing / Drawing Only</option>
                                <option value="Mixed" selected>Mixed (All Types)</option>
                            </select>
                        </div>
                    </div>

                    <!-- Granular Mixed Distribution -->
                    <div id="mixed-distribution-group" style="margin-bottom: 12px;">
                        <label style="margin-top:0;">
                            Mixed Distribution <span id="type-total" class="limit-status-green" style="font-size:10px; margin-left:5px; text-transform:none;">(Total: 10)</span>
                        </label>
                        <div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px;">
                            <div>
                                <label style="margin-top:0; color:var(--primary); font-size:9px;">MC</label>
                                <input type="number" name="mc_count" value="2" oninput="updateTypeTotal()" required min="0" style="margin-bottom: 0; padding: 8px;">
                            </div>
                            <div>
                                <label style="margin-top:0; color:var(--primary); font-size:9px;">T/F</label>
                                <input type="number" name="tf_count" value="2" oninput="updateTypeTotal()" required min="0" style="margin-bottom: 0; padding: 8px;">
                            </div>
                            <div>
                                <label style="margin-top:0; color:var(--primary); font-size:9px;">ID</label>
                                <input type="number" name="id_count" value="2" oninput="updateTypeTotal()" required min="0" style="margin-bottom: 0; padding: 8px;">
                            </div>
                            <div>
                                <label style="margin-top:0; color:var(--primary); font-size:9px;">OE</label>
                                <input type="number" name="oe_count" value="2" oninput="updateTypeTotal()" required min="0" style="margin-bottom: 0; padding: 8px;">
                            </div>
                            <div>
                                <label style="margin-top:0; color:var(--primary); font-size:9px;">GR</label>
                                <input type="number" name="gr_count" value="2" oninput="updateTypeTotal()" required min="0" style="margin-bottom: 0; padding: 8px;">
                            </div>
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; margin-bottom: 12px;" id="limits-group">
                        <div>
                            <label style="margin-top:0;">Total Qs</label>
                            <input type="number" name="num_items" value="10" required style="margin-bottom: 0;">
                        </div>
                        <div>
                            <label style="margin-top:0;">Total Sec</label>
                            <input type="number" name="time_limit" value="200" required style="margin-bottom: 0;">
                        </div>
                        <div>
                            <label style="margin-top:0;">Images</label>
                            <input type="number" name="images_count" value="0" min="0" required style="margin-bottom: 0;">
                        </div>
                        <div>
                            <label style="margin-top:0;">Batch</label>
                            <input type="number" name="batch_size" value="3" min="1" max="10" required style="margin-bottom: 0;">
                        </div>
                    </div>

                    <div style="margin-bottom: 12px;">
                        <label style="margin-top:0;">Quiz Mode</label>
                        <select name="quiz_mode" style="margin-bottom: 0;">
                            <option value="sequential">Sequential (Standard)</option>
                            <option value="back_and_forth" selected>Back-and-Forth (Unified Timer)</option>
                        </select>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-bottom: 12px;">
                        <div>
                            <label style="margin-top:0;">Difficulty <span id="pct-total" class="limit-status-green" style="font-size:10px; margin-left:5px; text-transform:none;">(Total: 100%)</span></label>
                            <div class="difficulty-grid" style="margin-bottom: 0;">
                                <div>
                                    <label style="margin-top:0; color:var(--success); font-size:10px;">Easy</label>
                                    <input type="number" name="easy_pct" value="50" oninput="updateTotal()" required style="margin-bottom: 0;">
                                </div>
                                <div>
                                    <label style="margin-top:0; color:var(--warning); font-size:10px;">Avg</label>
                                    <input type="number" name="avg_pct" value="25" oninput="updateTotal()" required style="margin-bottom: 0;">
                                </div>
                                <div>
                                    <label style="margin-top:0; color:var(--m-red); font-size:10px;">Hard</label>
                                    <input type="number" name="hard_pct" value="25" oninput="updateTotal()" required style="margin-bottom: 0;">
                                </div>
