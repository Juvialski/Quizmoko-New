    {"severity": "low", "area": "realtime", "detail": "Socket.IO CORS origin is '*'."},
    {"severity": "operational", "area": "scaling", "detail": "Attempt/revision/rate/live/AI coordination is process-local."},
    {"severity": "maintainability", "area": "frontend", "detail": "Large EJS files contain substantial inline client JavaScript."},
