  "flows": {
    "auth": ["Firebase ID token", "verified server-side", "persist user", "signed session cookie", "role/ownership guards"],
    "manual_authoring": ["dashboard", "create/edit/duplicate/merge", "canonical normalization", "verification/draft gate", "persist", "sanitized public quiz"],
    "ai_authoring": ["AI request", "AI work guard", "Gemini RPM queue", "structured draft", "canonical + LaTeX validation", "answerless dual solve", "adjudicate disagreement", "verified/review_required", "editor/publication"],
    "worksheet": ["PDF/image upload", "page rasterize", "structured extraction", "source provenance", "reconcile/order", "optional golden key", "bounded dual-model solve", "adjudicate", "teacher review/publication gate", "persist quiz"],
    "attempt": ["published quiz", "crypto session ID", "answer revisions/digests", "individual grade", "progress save", "live telemetry", "final attempt lock", "authoritative final grade", "durable result", "capability token"],
    "results": ["UID/owner/capability access", "display historical grade", "optional share token", "teacher recheck", "question-version acknowledgement", "audited regrade"],
    "live": ["student ping/socket", "live session update", "persisted score authority", "room broadcast", "teacher controls"]
  },
  "persistence": {
    "write_path": "memory -> secret redaction -> coalesced atomic local JSON -> ordered/deduplicated Firestore",
    "startup": "local recovery -> Firestore configure/hydrate -> REQUIRE_FIRESTORE readiness -> listen",
    "shutdown": "HTTP/Socket drain -> pending persistence flush",
    "browser_firestore": "read-only owner/admin under rules; writes denied",
    "ai_studio": "in-memory only; Firestore/local persistence disabled"
  },
  "ai": {
    "hosted_models": ["gemini-3.5-flash-lite", "gemini-3.1-flash-lite"],
    "thinking": "high for every task profile",
    "tasks": ["document_extraction", "answer_key_extraction", "question_drafting", "question_solving", "question_adjudication", "latex_polish", "semantic_grading", "student_explanation"],
    "default_rpm_per_model": 15,
    "reserved_rpm": 1,
    "student_grading_key": "quiz creator stored server-side key or environment; never student request key"
  },
  "invariants": [
    "Public quiz payloads strip answer keys, solutions, verification evidence, and private worksheet provenance.",
    "Server canonical question/type/answer/points are authoritative for grading.",
    "Only semantic question types can invoke semantic grading; AI/infrastructure failure never becomes an academic zero.",
    "AI drafts fail closed to review_required/invalid unless independently verified.",
    "Worksheet original_index is immutable printed metadata; source_index is temporary batch mapping only.",
    "Repeated printed worksheet IDs may be preserved across different source locations; publication still requires unique canonical question IDs or explicit resolution.",
    "Same answer revision with different answer/snapshot identity is rejected.",
    "Finalized attempts are idempotent by session and do not silently rescore after later quiz edits.",
    "SESSION_SECRET is stable in production and exactly one writable process is used.",
    "Secrets are stripped before persistence; raw result access tokens are not persisted."
  ],
  "known_boundaries": [
