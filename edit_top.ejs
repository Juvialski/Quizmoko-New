<body>
    <div class="container">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px;">
            <div style="display: flex; gap: 12px; align-items: center;">
                <a href="/" class="back-link" style="margin-bottom: 0;">🔙 Back to Dashboard</a>
                <form action="/delete/<%= typeof quiz.id !== 'undefined' ? quiz.id : '' %>" method="POST" onsubmit="return confirm('Discard this quiz? This will delete it permanently.');" style="display: inline;">
                    <button type="submit" class="btn btn-danger" style="font-size: 11px; padding: 6px 12px;">🗑️ DISCARD QUIZ</button>
                </form>
                <% if (quiz.golden_reference || quiz.worksheet_source) { %>
                <button class="btn" onclick="toggleGoldenSidebar()" style="background: var(--warning); color: black; border: none; font-size: 11px; padding: 6px 12px;">🛡️ VIEW REFERENCE</button>
                <% } %>
            </div>
            <button onclick="toggleTheme()" title="Toggle Theme" style="background: transparent; border: none; font-size: 24px; cursor: pointer; opacity: 0.8; transition: 0.2s;">🌓</button>
        </div>
        
        <div class="card share-card">
            <label class="share-label">🔗 Student Share Link</label>
            <input type="text" id="share-link" class="share-input" readonly onclick="this.select(); document.execCommand('copy'); alert('Copied!');">
        </div>

        <div class="card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                <h2 style="margin: 0;">✏️ Edit Details</h2>
                <div style="display: flex; gap: 8px;">
                    <button class="btn btn-secondary" onclick="openImportModal()" title="Import multiple questions from other quizzes" style="background: var(--primary); color: white; border: none;"><i data-lucide="rocket" style="display:inline-block; vertical-align:middle; margin-right:6px; width:20px;"></i> IMPORT QUESTIONS</button>
                    <button class="btn btn-secondary" onclick="shuffleQuestions()" title="Randomize question order">🔄 Shuffle Questions</button>
                    <button class="btn btn-secondary" onclick="shuffleChoices()" title="Randomize choices for Multiple Choice questions">🔀 Shuffle Choices (MC Only)</button>
                    <button class="btn btn-secondary" onclick="manualPolish()" id="manual-polish-btn" title="Exhaustively fix LaTeX math formatting and fractions">✨ Polish Math (AI)</button>
                    <button class="btn btn-secondary" onclick="recheckAllAnswers()" id="recheck-ans-btn" title="Check for missing or incorrect answers using AI Judge" style="border-color: var(--warning); color: var(--warning); background: transparent;">🔍 Re-Check Answers</button>
                </div>
            </div>
            <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 24px; margin-bottom: 24px;">
                <div><label>Quiz Title</label><input type="text" id="quiz-title"></div>
                <div><label>Time Limit (Seconds)</label><input type="number" id="quiz-time"></div>
                <div>
                    <label>Quiz Mode</label>
                    <select id="quiz-mode" style="width: 100%; padding: 16px; border: 1px solid var(--hairline); border-radius: var(--radius-sm); background: var(--surface-soft); color: var(--body-strong); font-family: inherit; font-size: 14px;">
                        <option value="sequential">Sequential (Standard)</option>
                        <option value="back_and_forth" selected>Back-and-Forth (Unified Timer)</option>
                    </select>
                </div>
            </div>

            <div style="display: flex; align-items: center; gap: 10px; background: var(--surface-soft); padding: 16px; border: 1px solid var(--hairline); border-radius: var(--radius-sm);">
                <input type="checkbox" id="require-solution" style="width: 20px; height: 20px; cursor: pointer;">
                <label for="require-solution" style="margin: 0; cursor: pointer; font-size: 15px; color: var(--on-dark); text-transform: none; letter-spacing: normal;">📝 Require Solution for All Questions (Split-screen Whiteboard)</label>
            </div>
        </div>

        <div class="card" id="worksheet-source-card" style="display: none;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                <h3 style="margin: 0;">📦 Original Worksheet Source</h3>
                <button class="btn btn-secondary" onclick="toggleWorksheetSource()" style="font-size: 11px;">SHOW / HIDE</button>
            </div>
            <div id="worksheet-source-content" style="display: none; max-height: 400px; overflow-y: auto; border-top: 1px solid var(--hairline); padding-top: 16px;"></div>
        </div>

        <div id="questions-container"></div>
        
        <button id="add-q-btn" class="btn btn-save" onclick="addAIQuestion()" style="background-color: transparent; border: 1px dashed var(--body); color: var(--body-strong);">➕ GENERATE NEW QUESTION HERE</button>

        <button class="btn btn-save" onclick="saveQuiz()">💾 Save All Changes</button>
        <a href="/export/<%= typeof quiz.id !== 'undefined' ? quiz.id : '' %>" target="_blank" class="btn-export">📄 Export to Word / PDF</a>
    </div>

    <div class="sidebar-overlay" id="sidebar-overlay" onclick="toggleGoldenSidebar()"></div>
    <div class="golden-sidebar" id="golden-sidebar">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
            <h2 style="margin: 0; color: var(--warning);">🛡️ Reference Panel</h2>
            <button onclick="toggleGoldenSidebar()" style="background: transparent; border: none; font-size: 20px; color: var(--body); cursor: pointer;">×</button>
        </div>
        <p style="font-size: 12px; color: var(--body); margin-bottom: 20px;">Use this reference to manually verify question accuracy against your original files.</p>
        <div id="golden-sidebar-content"></div>
    </div>

    <!-- Transfer Question Modal -->
    <div id="transferModal" class="modal-overlay">
        <div class="modal-card">
