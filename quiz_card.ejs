            </div>
        </div>

        <div class="card" id="saved-quizzes-card" style="background: transparent; border: none; padding: 0;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                <h2 style="font-size: 28px; margin: 0;">📚 Library</h2>
                <button onclick="openCreateBlankModal()" class="btn-primary" style="width: auto; margin: 0; padding: 10px 20px; font-size: 14px;">➕ New Blank Quiz</button>
            </div>
            
            <% if (grouped_quizzes) { %>
                <div style="display: flex; gap: 12px; margin-bottom: 32px;" id="search-merge-bar">
                    <input type="text" id="searchInput" onkeyup="filterQuizzes()" placeholder="🔍 Search quizzes..." class="search-bar" style="border-radius: var(--radius-sm);">
                    <button id="mergeModeBtn" onclick="toggleMergeMode()" class="btn-primary" style="width: auto; margin-top: 0; white-space: nowrap; padding: 14px 24px;">🔗 Merge Mode</button>
                </div>
                
                <div id="quiz-list-container">
                    <% let groupIdx = 0; for (let [subject, quizzes] of Object.entries(grouped_quizzes || {})) { groupIdx++; %>
                        <div class="subject-group" data-subject="<%= typeof subject !== 'undefined' && subject ? subject : '' %>">
                            
                            <div class="subject-header" onclick="toggleFolder(this)">
                                <h3 class="subject-title">
                                    📁 <%= typeof subject !== 'undefined' ? subject : '' %> 
                                    <span class="subject-badge"><%= (quizzes || []).length %></span>
                                </h3>
                                <svg class="chevron <% if (groupIdx == 1) { %>open<% } %>" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                            </div>
                            
                            <div class="folder-content <% if (groupIdx == 1) { %>open<% } %>">
                                <div class="quiz-grid">
                                    <% for (let sq of (quizzes || [])) { %>
                                        <div class="quiz-item" data-title="<%= typeof sq.title !== 'undefined' && sq.title ? sq.title : '' %>" data-id="<%= typeof sq.id !== 'undefined' ? sq.id : '' %>">
                                            <div class="quiz-title">📄 <%= typeof sq.title !== 'undefined' ? sq.title : '' %></div>
                                            <div class="quiz-meta">
                                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                                                <%= typeof sq.time_limit !== 'undefined' ? sq.time_limit : '' %>s / question
                                            </div>
                                            
                                            <div class="link-display" id="url-<%= typeof sq.id !== 'undefined' ? sq.id : '' %>" onclick="copyLink('<%= typeof sq.id !== 'undefined' ? sq.id : '' %>')" title="Click to copy link!">Generating link...</div>
                                            
                                            <div class="actions">
                                                <button onclick="copyLink('<%= typeof sq.id !== 'undefined' ? sq.id : '' %>')" class="btn-action btn-copy"><i data-lucide="copy" class="icon-sm"></i> Copy</button>
                                                <button onclick="openMoveModal('<%= typeof sq.id !== 'undefined' ? sq.id : '' %>', '<%= typeof sq.subject !== 'undefined' ? sq.subject : '' %>')" class="btn-action"><i data-lucide="folder-output" class="icon-sm"></i> Move</button>
                                                <a href="/live/<%= typeof sq.id !== 'undefined' ? sq.id : '' %>" class="btn-action btn-live"><i data-lucide="radio" class="icon-sm"></i> Live</a>
                                                <a href="/results/<%= typeof sq.id !== 'undefined' ? sq.id : '' %>" class="btn-action btn-results"><i data-lucide="bar-chart-2" class="icon-sm"></i> Results</a>
                                                <a href="/edit/<%= typeof sq.id !== 'undefined' ? sq.id : '' %>" class="btn-action btn-edit"><i data-lucide="edit-3" class="icon-sm"></i> Edit</a>
                                                <form class="inline-form" action="/delete/<%= typeof sq.id !== 'undefined' ? sq.id : '' %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this quiz?');">
                                                    <button type="submit" class="btn-action btn-delete"><i data-lucide="trash-2" class="icon-sm"></i> Delete</button>
                                                </form>
                                            </div>
                                            <script>document.getElementById("url-<%= typeof sq.id !== 'undefined' ? sq.id : '' %>").innerText = window.location.origin + "/quiz/<%= typeof sq.id !== 'undefined' ? sq.id : '' %>";</script>
                                        </div>
                                    <% } %>
                                </div>
                            </div>

                        </div>
                    <% } %>
                </div>
            <% } else { %>
                <div style="background: var(--surface-card); padding: 64px; border: 1px solid var(--hairline); text-align: center;">
                    <p style="color: var(--on-dark); font-size: 18px; font-weight: 700; text-transform: uppercase; letter-spacing: 1.5px; margin:0;">NO QUIZZES FOUND</p>
                    <p style="color: var(--body); font-size: 14px; margin-top: 8px; margin-bottom: 24px;">Use the generator to start or upload a worksheet.</p>
                    <div style="display: flex; gap: 12px; justify-content: center;">
                        <a href="/worksheet" class="btn-primary" style="width: auto; text-decoration: none;">📄 Worksheet (Auto-Solve)</a>
                        <a href="/worksheet_answers" class="btn-secondary" style="width: auto; text-decoration: none;">🔑 Worksheet + Answer Key</a>
                    </div>
                </div>
            <% } %>
        </div>
    </div>
    
