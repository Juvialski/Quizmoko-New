<!DOCTYPE html>
<html>
<head>
    <title>QuizMoKo - Admin Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;800&display=swap" rel="stylesheet">
    <style>
        :root {
            --canvas: #0f172a;
            --surface-card: #1e293b;
            --surface-elevated: #334155;
            --surface-soft: #0f172a;
            --on-dark: #f8fafc;
            --body: #94a3b8;
            --body-strong: #e2e8f0;
            --hairline: #334155;
            --primary: #6366f1;
            --success: #34d399;
            --m-red: #fb7185;
            --radius-md: 12px;
            --radius-sm: 8px;
            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        }

        body {
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 40px 20px;
            color: var(--body-strong);
            background-color: var(--canvas);
        }

        .container { max-width: 1200px; margin: auto; }
        .card {
            background: var(--surface-card);
            padding: 24px;
            border-radius: var(--radius-md);
            border: 1px solid var(--hairline);
            box-shadow: var(--shadow);
            margin-bottom: 24px;
        }

        h1, h2 { color: var(--on-dark); }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }

        th, td {
            text-align: left;
            padding: 16px;
            border-bottom: 1px solid var(--hairline);
        }

        th {
            color: var(--body);
            font-size: 13px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .status-badge {
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .status-active { background: rgba(52, 211, 153, 0.1); color: var(--success); border: 1px solid var(--success); }
        .status-blocked { background: rgba(251, 113, 133, 0.1); color: var(--m-red); border: 1px solid var(--m-red); }

        .btn {
            padding: 8px 16px;
            border-radius: var(--radius-sm);
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: 0.2s;
            border: 1px solid var(--hairline);
        }

        .btn-block { color: var(--m-red); background: transparent; }
        .btn-block:hover { background: var(--m-red); color: white; }

        .btn-unblock { color: var(--success); background: transparent; }
        .btn-unblock:hover { background: var(--success); color: white; }

        .back-link {
            color: var(--body);
            text-decoration: none;
            display: inline-block;
            margin-bottom: 20px;
            font-weight: 600;
        }
        .back-link:hover { color: var(--on-dark); }
    </style>
</head>
<body>
    <div class="container">
        <a href="/" class="back-link">← Back to Dashboard</a>
        <div class="card">
            <h1>🛡️ Admin Dashboard</h1>
            <p style="color: var(--body);">Manage registered users and monitor application usage.</p>
        </div>

        <div class="card">
            <h2>Registered Users</h2>
            <div id="users-loading">Loading users...</div>
            <table id="users-table" style="display: none;">
                <thead>
                    <tr>
                        <th>Email</th>
                        <th>UID</th>
                        <th>Status</th>
                        <th>Total AI Calls</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody id="users-body">
                    <!-- Rows will be injected here -->
                </tbody>
            </table>
        </div>
    </div>

    <script>
        async function fetchUsers() {
            try {
                const res = await fetch('/api/admin/users');
                const data = await res.json();
                if (data.success) {
                    renderUsers(data.users);
                } else {
                    alert("Error: " + data.error);
                }
            } catch (e) {
                console.error(e);
            }
        }

        function renderUsers(users) {
            const body = document.getElementById('users-body');
            body.innerHTML = '';

            users.forEach(user => {
                const row = document.createElement('tr');
                const isActive = user.status !== 'blocked';

                row.innerHTML = `
                    <td style="font-weight: 600;">${user.email}</td>
                    <td style="font-family: monospace; font-size: 11px; color: var(--body);">${user.uid}</td>
                    <td>
                        <span class="status-badge ${isActive ? 'status-active' : 'status-blocked'}">
                            ${user.status || 'active'}
                        </span>
                    </td>
                    <td style="font-weight: 700; color: var(--primary);">${user.total_usage}</td>
                    <td>
                        ${isActive ?
                            `<button class="btn btn-block" onclick="updateStatus('${user.uid}', 'blocked')">Block User</button>` :
                            `<button class="btn btn-unblock" onclick="updateStatus('${user.uid}', 'active')">Unblock User</button>`
                        }
                    </td>
                `;
                body.appendChild(row);
            });

            document.getElementById('users-loading').style.display = 'none';
            document.getElementById('users-table').style.display = 'table';
        }

        async function updateStatus(uid, status) {
            if (!confirm(`Are you sure you want to ${status === 'blocked' ? 'block' : 'unblock'} this user?`)) return;

            try {
                const res = await fetch('/api/admin/update_user_status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ uid, status })
                });
                const data = await res.json();
                if (data.success) {
                    fetchUsers();
                } else {
                    alert("Error: " + data.error);
                }
            } catch (e) {
                console.error(e);
            }
        }

        window.onload = fetchUsers;
    </script>
</body>
</html>
