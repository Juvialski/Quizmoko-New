<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>QuizMoKo - Admin Dashboard</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/quizmoko-ui.css">
    <script src="/js/quizmoko-theme.js"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <style>
        .back-link { display: inline-flex; align-items: center; gap: 6px; font-weight: 600; font-size: 14px; text-decoration: none; }
        .status-badge { padding: 4px 10px; border-radius: 9999px; font-size: 12px; font-weight: 600; display: inline-block; text-transform: capitalize; }
        .status-active { background: var(--success-bg); color: var(--success); }
        .status-blocked { background: var(--danger-bg); color: var(--danger); }
        .btn-unblock { background: var(--success-bg); color: var(--success); border: 1px solid var(--success); }
        .btn-unblock:hover { background: var(--success); color: #fff; }
    </style>
</head>
<body>
    <div class="container">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <a href="/" class="back-link">← Back to Dashboard</a>
            <button type="button" onclick="toggleTheme()" data-theme-toggle aria-label="Switch to light theme" class="btn btn-secondary btn-sm" title="Toggle Theme"><i data-lucide="moon" class="icon-sm"></i> <span>Theme</span></button>
        </div>
        <div class="card" style="margin-bottom: 20px;">
            <h1 style="display: flex; align-items: center; gap: 8px;"><i data-lucide="shield" class="icon-md"></i> Admin Dashboard</h1>
            <p style="color: var(--body); margin-bottom: 0;">Manage registered users and monitor application usage.</p>
        </div>

        <div class="card" style="margin-bottom: 20px;">
            <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; margin-bottom: 16px;">
                <div>
                    <h2 style="margin: 0; display: flex; align-items: center; gap: 8px;"><i data-lucide="activity" class="icon-sm"></i> System Diagnostics & Backups</h2>
                    <p style="color: var(--body); font-size: 13px; margin: 4px 0 0 0;">Real-time database health and full system snapshot utilities.</p>
                </div>
                <a href="/api/admin/export_database" class="btn btn-primary btn-sm" style="display: inline-flex; align-items: center; gap: 6px;">
                    <i data-lucide="download" class="icon-sm"></i> Download Database Backup (.json)
                </a>
            </div>
            <div id="system-health-panel" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px;">
                <div style="padding: 12px; background: var(--bg); border: 1px solid var(--border); border-radius: 8px;">
                    <div style="font-size: 11px; font-weight: 700; color: var(--body); text-transform: uppercase;">Firestore Persistence</div>
                    <div id="health-firestore" style="font-size: 16px; font-weight: 700; color: var(--primary); margin-top: 4px;">Checking...</div>
                </div>
                <div style="padding: 12px; background: var(--bg); border: 1px solid var(--border); border-radius: 8px;">
                    <div style="font-size: 11px; font-weight: 700; color: var(--body); text-transform: uppercase;">Total Stored Quizzes</div>
                    <div id="health-quizzes" style="font-size: 16px; font-weight: 700; color: var(--heading); margin-top: 4px;">-</div>
                </div>
                <div style="padding: 12px; background: var(--bg); border: 1px solid var(--border); border-radius: 8px;">
                    <div style="font-size: 11px; font-weight: 700; color: var(--body); text-transform: uppercase;">Completed Attempts</div>
                    <div id="health-results" style="font-size: 16px; font-weight: 700; color: var(--heading); margin-top: 4px;">-</div>
                </div>
                <div style="padding: 12px; background: var(--bg); border: 1px solid var(--border); border-radius: 8px;">
                    <div style="font-size: 11px; font-weight: 700; color: var(--body); text-transform: uppercase;">Memory & Uptime</div>
                    <div id="health-memory" style="font-size: 13px; font-weight: 600; color: var(--body); margin-top: 4px;">-</div>
                </div>
            </div>
        </div>

        <div class="card">
            <h2>Registered Users</h2>
            <div id="users-loading">Loading users...</div>
            <div class="table-responsive">
                <table id="users-table" class="data-table" style="display: none;">
                    <thead>
                        <tr>
                            <th>Email</th>
                            <th>UID</th>
                            <th>Status</th>
                            <th>Total AI Calls</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody id="users-body">
                        <!-- Rows will be injected here -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        function escapeHtml(value) {
            return String(value ?? '').replace(/[&<>"']/g, character => ({
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#39;'
            })[character]);
        }

        async function fetchUsers() {
            try {
                const res = await fetch('/api/admin/users');
                const data = await res.json();
                if (data.success) {
                    renderUsers(data.users);
                } else {
                    alert("Error: " + data.error);
                }
            } catch (e) {
                console.error(e);
            }
        }

        function renderUsers(users) {
            const body = document.getElementById('users-body');
            body.innerHTML = '';

            users.forEach(user => {
                const row = document.createElement('tr');
                const isActive = user.status !== 'blocked';
                const displayStatus = isActive ? 'active' : 'blocked';

                row.innerHTML = `
                    <td style="font-weight: 600;">${escapeHtml(user.email)}</td>
                    <td style="font-family: monospace; font-size: 11px; color: var(--body);">${escapeHtml(user.uid)}</td>
                    <td>
                        <span class="status-badge ${isActive ? 'status-active' : 'status-blocked'}">
                            ${displayStatus}
                        </span>
                    </td>
                    <td style="font-weight: 700; color: var(--primary);">${escapeHtml(user.total_usage ?? 0)}</td>
                    <td>
                        ${isActive ?
                            '<button class="btn btn-danger btn-user-block btn-sm" type="button">Block User</button>' :
                            '<button class="btn btn-success btn-user-unblock btn-sm" type="button">Unblock User</button>'
                        }
                    </td>
                `;
                const statusButton = row.querySelector('button');
                if (statusButton) {
                    statusButton.addEventListener('click', () => {
                        updateStatus(user.uid, isActive ? 'blocked' : 'active');
                    });
                }
                body.appendChild(row);
            });

            document.getElementById('users-loading').style.display = 'none';
            document.getElementById('users-table').style.display = 'table';
        }

        async function updateStatus(uid, status) {
            if (!confirm(`Are you sure you want to ${status === 'blocked' ? 'block' : 'unblock'} this user?`)) return;

            try {
                const res = await fetch('/api/admin/update_user_status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ uid, status })
                });
                const data = await res.json();
                if (data.success) {
                    fetchUsers();
                } else {
                    alert('Error: ' + data.error);
                }
            } catch (e) {
                console.error(e);
            }
        }

        async function fetchSystemHealth() {
            try {
                const res = await fetch('/api/admin/system_health');
                const data = await res.json();
                if (data.success) {
                    const fEl = document.getElementById('health-firestore');
                    const isHealthy = data.persistence?.firestoreHealthy;
                    const isHydrated = data.persistence?.firestoreHydrated;
                    fEl.textContent = isHealthy ? 'Healthy & Connected' : (isHydrated ? 'Hydrated (Local Fallback)' : 'Local Disk Only');
                    fEl.style.color = isHealthy ? 'var(--success)' : 'var(--primary)';

                    document.getElementById('health-quizzes').textContent = data.counts?.quizzes ?? '-';
                    document.getElementById('health-results').textContent = data.counts?.results ?? '-';
                    document.getElementById('health-memory').textContent = `${data.memory?.heap_used_mb ?? 0} MB heap / ${data.uptime_seconds ?? 0}s up`;
                }
            } catch (e) {
                console.error(e);
            }
        }

        window.onload = () => {
            fetchSystemHealth();
            fetchUsers();
        };
    </script>
    <script>window.refreshQuizmokoIcons?.();</script>
</body>
</html>
