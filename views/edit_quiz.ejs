            const originalText = btn.innerText;
            const model = quizData.model_name || 'gemini-3.5-flash-lite';
            const apiKey = await getUsableKey(model, 1);
            if (!apiKey) return alert('No API keys with remaining quota found today.');

            btn.innerText = '⏳ Solving...';
            btn.disabled = true;

            const q = quizData.questions[index];
            let sourceContext = null;
            if (q.source_index !== undefined && quizData.worksheet_source && quizData.worksheet_source.extracted_questions) {
                sourceContext = quizData.worksheet_source.extracted_questions[q.source_index];
            }

            try {
                const res = await fetchWithTimeout('/api/resolve_question', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        question_data: q,
                        source_context: sourceContext,
                        api_key: apiKey,
                        subject: quizData.subject,
                        topic: quizData.title,
