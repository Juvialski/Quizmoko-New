        function removeQuestion(index) {
            if(confirm('Are you sure you want to remove this question?')) { quizData.questions.splice(index, 1); renderQuestions(); }
        }

        function addOption(qIndex) {
            const q = quizData.questions[qIndex];
            const letter = String.fromCharCode(65 + q.options.length);
            q.options.push(`${letter}) New Choice`);
            renderQuestions();
            markQuestionChanged(qIndex);
        }

        function removeOption(qIndex, optIndex) {
            const q = quizData.questions[qIndex];
            if (q.options.length <= 2) return alert('Must have at least 2 options.');
            q.options.splice(optIndex, 1);

            // Re-normalize letters
            q.options = q.options.map((opt, i) => {
                const letter = String.fromCharCode(65 + i);
                const clean = opt.replace(/^[A-Z][\)\.]\s*/, '');
                return `${letter}) ${clean}`;
            });

            renderQuestions();
            markQuestionChanged(qIndex);
        }

        function shuffleQuestions() {
            if (!confirm('Randomize the order of all questions?')) return;
            for (let i = quizData.questions.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [quizData.questions[i], quizData.questions[j]] = [quizData.questions[j], quizData.questions[i]];
            }
            renderQuestions();
        }

        function shuffleChoices() {
            if (!confirm('Shuffle choices for all Multiple Choice questions? (T/F and ID will be unaffected)')) return;

            quizData.questions.forEach((q) => {
                if (q.type === 'multiple_choice' && q.options && q.options.length > 1) {
                    const originalAnswerText = getCorrectAnswerText(q);

                    const plainOptions = q.options.map(opt => {
                        const match = opt.match(/^[A-Z][\)\.]\s*(.*)/i);
                        return match ? match[1].trim() : opt.trim();
                    });

                    for (let i = plainOptions.length - 1; i > 0; i--) {
                        const j = Math.floor(Math.random() * (i + 1));
                        [plainOptions[i], plainOptions[j]] = [plainOptions[j], plainOptions[i]];
                    }

                    let newAnswerLetter = 'A';
                    q.options = plainOptions.map((text, idx) => {
                        const letter = String.fromCharCode(65 + idx);
                        if (text === originalAnswerText) newAnswerLetter = letter;
                        return `${letter}) ${text}`;
                    });
                    q.answer = newAnswerLetter;
                }
            });
            renderQuestions();
        }

        function getCorrectAnswerText(q) {
            const letter = q.answer.trim().toUpperCase();

            // Try to find by starting letter first
            let option = q.options.find(opt => opt.toUpperCase().startsWith(letter + ')') || opt.toUpperCase().startsWith(letter + '.'));

            if (!option) {
                // Fallback: If answer is a single letter, assume it's an index (A=0, B=1...)
                if (letter.length === 1 && letter >= 'A' && letter <= 'Z') {
                    const idx = letter.charCodeAt(0) - 65;
                    if (idx < q.options.length) option = q.options[idx];
                }
            }

            if (option) {
                const match = option.match(/^[A-Z][\)\.]\s*(.*)/i);
                return match ? match[1].trim() : option.trim();
            }
            return '';
        }

        async function reprocessQuestionType(qIndex, targetType) {
            const q = quizData.questions[qIndex];
            if (q.type === targetType) return;

            const model = quizData.model_name || 'gemini-3.5-flash-lite';
            const apiKey = await getUsableKey(model, 1);
            if (!apiKey) { alert('No API keys with remaining quota found today.'); return; }

            const btn = document.getElementById(`regen-btn-${qIndex}`);
            const originalText = btn ? btn.innerHTML : '<i data-lucide="refresh-cw" class="icon-sm"></i>';
            btn.innerHTML = 'REFORMATTING...';
            btn.disabled = true;

            // Get source context if available
            let sourceContext = { raw_text: q.question, image_description: '' };
            if (q.source_index !== undefined && quizData.worksheet_source && quizData.worksheet_source.extracted_questions) {
                sourceContext = quizData.worksheet_source.extracted_questions[q.source_index];
            }

            try {
                const res = await fetch('/api/reprocess_question', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        question_data: q,
                        source_context: sourceContext,
                        target_type: targetType,
                        api_key: apiKey,
                        subject: quizData.subject,
                        model_name: model
                    })
                });
                const data = await res.json();
                if (data.success) {
                    // Track usage (optimistic)
                    const kid = await getHash(apiKey);
                    const today = new Date().toISOString().split('T')[0];
                    if (!GLOBAL_DAILY_STATS[today]) GLOBAL_DAILY_STATS[today] = {};
                    if (!GLOBAL_DAILY_STATS[today][model]) GLOBAL_DAILY_STATS[today][model] = {};
                    GLOBAL_DAILY_STATS[today][model][kid] = (GLOBAL_DAILY_STATS[today][model][kid] || 0) + 1;

                    // Update current question with data from server
                    // Use ...data.question first to ensure type and options are cleared
                    quizData.questions[qIndex] = {
                        ...data.question,
                        source_index: q.source_index // Preserve source index
                    };

                    // SAVE ENTIRE QUIZ AND RELOAD TO ENSURE UI IS 100% CLEAN
                    saveQuiz(false); // Pass false to prevent the standard dashboard redirect
                    setTimeout(() => window.location.reload(), 500);
                } else {
                    alert('Reprocessing failed: ' + data.error);
                    btn.innerHTML = originalText;
                    btn.disabled = false;
                }
            } catch (e) {
                alert('Error reprocessing question.');
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }

