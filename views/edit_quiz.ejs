        async function manualPolishSingle(index, btn) {
            const originalText = btn.innerText;
            const model = quizData.model_name || 'gemini-3.5-flash-lite';
            const apiKey = await getUsableKey(model, 1);
            if (!apiKey) return alert('No API keys with remaining quota found today.');

            btn.innerText = '⏳...';
            btn.disabled = true;

            const q = quizData.questions[index];
            try {
                const res = await fetchWithTimeout('/api/polish_questions', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        questions: [q],
                        api_key: apiKey,
                        model_name: model
                    }),
