        function toggleGoldenSidebar() {
            const sb = document.getElementById('golden-sidebar');
            const ov = document.getElementById('sidebar-overlay');
            const isActive = sb.classList.toggle('active');
            ov.style.display = isActive ? 'block' : 'none';

            if (isActive) {
                const content = document.getElementById('golden-sidebar-content');
                content.innerHTML = '';

                // --- Part A: Golden Reference Key ---
                if (quizData.golden_reference && Object.keys(quizData.golden_reference).length > 0) {
                    const header = document.createElement('h3');
                    header.innerHTML = '<i data-lucide="check-circle" class="icon-sm"></i> Original Answer Key';
                    header.style.fontSize = '14px';
                    header.style.color = 'var(--success)';
                    header.style.marginBottom = '12px';
                    header.style.marginTop = '0';
                    content.appendChild(header);

                    const parseIndex = (idxStr) => {
                        const str = String(idxStr || '').trim();
                        const match = str.match(/^(\d+)(.*)$/);
                        if (match) {
                            return {
                                num: parseInt(match[1], 10),
                                suffix: match[2].toLowerCase()
                            };
                        }
                        return { num: Infinity, suffix: str.toLowerCase() };
                    };

                    const sortedNums = Object.keys(quizData.golden_reference).sort((a,b) => {
                        const parseA = parseIndex(a);
                        const parseB = parseIndex(b);
                        if (parseA.num !== parseB.num) {
                            return parseA.num - parseB.num;
                        }
                        return parseA.suffix.localeCompare(parseB.suffix);
                    });
                    sortedNums.forEach(num => {
                        const item = document.createElement('div');
                        item.className = 'golden-sidebar-item';
                        item.innerHTML = `<b>Q${num}</b> ${quizData.golden_reference[num]}`;
                        content.appendChild(item);
                    });
                }

                // --- Part B: Worksheet Source (Extra context) ---
                if (quizData.worksheet_source && quizData.worksheet_source.extracted_questions) {
                    const header = document.createElement('h3');
                    header.innerHTML = '<i data-lucide="package" class="icon-sm"></i> Source Worksheet Text';
                    header.style.fontSize = '14px';
                    header.style.color = 'var(--primary)';
                    header.style.marginBottom = '12px';
                    header.style.marginTop = '24px';
                    header.style.borderTop = '1px solid var(--hairline)';
                    header.style.paddingTop = '16px';
                    content.appendChild(header);

                    quizData.worksheet_source.extracted_questions.forEach((q, i) => {
                        const item = document.createElement('div');
                        item.className = 'golden-sidebar-item';
                        item.style.fontSize = '12px';
                        item.innerHTML = `
                            <div style="font-weight:700; color:var(--primary); margin-bottom:4px;">[Source Q${i + 1}]</div>
                            <div>${q.raw_text}</div>
                            ${q.image_description ? `<div style="font-style:italic; color:var(--success); margin-top:4px;"><i data-lucide="image" class="icon-sm"></i>️ ${q.image_description}</div>` : ''}
                        `;
                        content.appendChild(item);
                    });
                }

                if (content.innerHTML === '') {
                    content.innerHTML = '<p style="font-size: 13px; color: var(--body);">No reference data available for this quiz.</p>';
                } else {
                    renderMath(content);
                }
            }
        }

        async function recheckAllAnswers() {
            const btn = document.getElementById('recheck-ans-btn');
            const originalText = btn.innerText;
            const model = quizData.model_name || 'gemini-3.5-flash-lite';
            const apiKey = await getUsableKey(model, 2);
            if (!apiKey) return alert('No API keys found.');

            if (!confirm('AI will now perform a deep scan to verify all answers match the original document. Continue?')) return;

            btn.innerText = '⏳ Re-Checking...';
            btn.disabled = true;

            try {
                const res = await fetchWithTimeout('/api/polish_questions', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        questions: quizData.questions,
                        api_key: apiKey,
                        model_name: model,
                        golden_reference: quizData.golden_reference,
                        mode: 'RECHECK_ANSWERS'
                    }),
                    timeout: 120000
                });
                const data = await res.json();
                if (data.success) {
                    quizData.questions = data.questions;
                    renderQuestions();
                    alert('Answer integrity verified and fixed!');
                } else { alert('Re-check failed: ' + data.error); }
            } catch (e) {
                if (e.name === 'AbortError') {
                    alert('Re-check timed out. The server is taking too long to respond.');
                } else {
                    alert('Error during re-check: ' + e.message);
                }
            } finally { btn.innerText = originalText; btn.disabled = false; }
        }

        // --- TRANSFER MODAL LOGIC ---
        let transferSourceIndex = null;
        let transferTargetQuizId = null;

        async function openTransferModal(index) {
            transferSourceIndex = index;
            transferTargetQuizId = null;
            document.getElementById('confirm-transfer-btn').disabled = true;
            document.getElementById('transferModal').style.display = 'flex';

            const listContainer = document.getElementById('transfer-quiz-list');
            listContainer.innerHTML = '<p style="text-align: center; color: var(--body);">Loading quizzes...</p>';

            try {
                const res = await fetch('/api/list_quizzes');
                const data = await res.json();
                if (data.success) {
                    listContainer.innerHTML = '';
                    if (data.quizzes.length <= 1) {
                        listContainer.innerHTML = '<p style="text-align: center; color: var(--body);">No other quizzes found to transfer to.</p>';
                        return;
                    }
                    data.quizzes.forEach(quiz => {
                        if (quiz.id === quizData.id) return; // Don't show current quiz
                        const item = document.createElement('div');
                        item.className = 'quiz-list-item';
                        item.innerHTML = `
                            <div>
                                <div style="font-weight: 700; color: var(--on-dark);">${quiz.title}</div>
                                <div style="font-size: 11px; color: var(--body);">${quiz.subject}</div>
                            </div>
                        `;
                        item.onclick = () => {
                            document.querySelectorAll('.quiz-list-item').forEach(i => i.classList.remove('selected'));
                            item.classList.add('selected');
                            transferTargetQuizId = quiz.id;
                            document.getElementById('confirm-transfer-btn').disabled = false;
                        };
                        listContainer.appendChild(item);
                    });
                } else {
                    listContainer.innerHTML = '<p style="text-align: center; color: var(--m-red);">Failed to load quizzes.</p>';
                }
            } catch (e) {
                listContainer.innerHTML = '<p style="text-align: center; color: var(--m-red);">Error loading quizzes.</p>';
            }
        }

        function closeTransferModal() {
            document.getElementById('transferModal').style.display = 'none';
        }

        function filterTransferQuizzes() {
            const input = document.getElementById('transfer-search').value.toLowerCase();
            const items = document.querySelectorAll('.quiz-list-item');
            items.forEach(item => {
                const title = item.querySelector('div > div:first-child').innerText.toLowerCase();
                const subject = item.querySelector('div > div:last-child').innerText.toLowerCase();
                if (title.includes(input) || subject.includes(input)) {
                    item.style.display = 'flex';
                } else {
                    item.style.display = 'none';
                }
            });
        }

        async function executeTransfer() {
            if (transferSourceIndex === null || !transferTargetQuizId) return;

            const btn = document.getElementById('confirm-transfer-btn');
            btn.disabled = true;
            btn.innerText = 'Transferring...';

            try {
                const res = await fetch('/api/transfer_question', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        source_quiz_id: quizData.id,
                        target_quiz_id: transferTargetQuizId,
                        question_index: transferSourceIndex
                    })
                });
                const data = await res.json();
                if (data.success) {
                    alert('Question copied successfully!');
                    closeTransferModal();
                } else {
                    alert('Transfer failed: ' + data.error);
                    btn.disabled = false;
                    btn.innerText = 'Confirm Transfer';
                }
            } catch (e) {
                alert('Error during transfer.');
                btn.disabled = false;
                btn.innerText = 'Confirm Transfer';
            }
        }

        // --- BULK IMPORT LOGIC ---
        let importSourceQuizId = null;

        async function openImportModal() {
            document.getElementById('import-step-1').style.display = 'block';
            document.getElementById('import-step-2').style.display = 'none';
            document.getElementById('importModal').style.display = 'flex';

            const listContainer = document.getElementById('import-quiz-list');
            listContainer.innerHTML = '<p style="text-align: center; color: var(--body);">Loading quizzes...</p>';

            try {
                const res = await fetch('/api/list_quizzes');
                const data = await res.json();
                if (data.success) {
                    listContainer.innerHTML = '';
                    data.quizzes.forEach(quiz => {
                        if (quiz.id === quizData.id) return;
                        const item = document.createElement('div');
                        item.className = 'quiz-list-item';
                        item.innerHTML = `
                            <div>
                                <div style="font-weight: 700; color: var(--on-dark);">${quiz.title}</div>
                                <div style="font-size: 11px; color: var(--body);">${quiz.subject}</div>
                            </div>
                            <span style="font-size: 18px; color: var(--primary);"><i data-lucide="arrow-right" class="icon-sm"></i>️</span>
                        `;
                        item.onclick = () => loadQuestionsForImport(quiz.id, quiz.title);
                        listContainer.appendChild(item);
                    });
                }
            } catch (e) {
                listContainer.innerHTML = '<p style="text-align: center; color: var(--m-red);">Error loading quizzes.</p>';
            }
        }

        function closeImportModal() { document.getElementById('importModal').style.display = 'none'; }
        function backToImportStep1() { document.getElementById('import-step-1').style.display = 'block'; document.getElementById('import-step-2').style.display = 'none'; }

        async function loadQuestionsForImport(id, title) {
            importSourceQuizId = id;
            document.getElementById('import-source-title').innerText = title;
            document.getElementById('import-step-1').style.display = 'none';
            document.getElementById('import-step-2').style.display = 'block';

            const listContainer = document.getElementById('import-question-list');
            listContainer.innerHTML = '<p style="text-align: center; color: var(--body);">Loading questions...</p>';

            try {
                const res = await fetch(`/api/get_quiz_details/${id}`);
                const data = await res.json();
                if (data.success) {
                    listContainer.innerHTML = '';
                    data.questions.forEach((q, idx) => {
                        const item = document.createElement('label');
                        item.className = 'import-question-item';
                        item.innerHTML = `
                            <input type="checkbox" value="${idx}">
                            <div class="import-question-text">
                                <strong style="color:var(--primary);">Q${idx + 1}:</strong> ${q.question.substring(0, 150)}${q.question.length > 150 ? '...' : ''}
                            </div>
                        `;
                        // Label handles click on checkbox
                        listContainer.appendChild(item);
                    });
                }
            } catch (e) {
                listContainer.innerHTML = '<p style="text-align: center; color: var(--m-red);">Error loading questions.</p>';
            }
        }

        function toggleSelectAllImport(btn) {
            const checkboxes = document.querySelectorAll('#import-question-list input[type="checkbox"]');
            const allChecked = Array.from(checkboxes).every(c => c.checked);
            checkboxes.forEach(c => c.checked = !allChecked);
            btn.innerText = allChecked ? 'Select All' : 'Unselect All';
        }

        function filterImportQuizzes() {
            const input = document.getElementById('import-search').value.toLowerCase();
            const items = document.querySelectorAll('#import-quiz-list .quiz-list-item');
            items.forEach(item => {
                const text = item.innerText.toLowerCase();
                item.style.display = text.includes(input) ? 'flex' : 'none';
            });
        }

        async function executeBulkImport() {
            const selectedIndices = Array.from(document.querySelectorAll('#import-question-list input[type="checkbox"]:checked')).map(c => parseInt(c.value));
            if (selectedIndices.length === 0) return alert('Select at least one question.');

            const btn = document.getElementById('confirm-bulk-import-btn');
            btn.disabled = true;
            btn.innerText = 'Importing...';

            try {
                const res = await fetch('/api/bulk_import_questions', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        source_quiz_id: importSourceQuizId,
                        target_quiz_id: quizData.id,
                        question_indices: selectedIndices
                    })
                });
                const data = await res.json();
                if (data.success) {
                    alert(`Successfully imported ${data.count} questions!`);
                    window.location.reload();
                } else {
                    alert('Import failed: ' + data.error);
                    btn.disabled = false;
                    btn.innerText = 'Confirm Import';
                }
            } catch (e) {
                alert('Error during import.');
                btn.disabled = false;
                btn.innerText = 'Confirm Import';
            }
        }

        function saveQuiz(redirect = true, btn = null, singleIndex = null) {
            // --- NEW: PRE-FLIGHT VALIDATION ---
            let invalidQuestions = [];

            // If singleIndex is provided, only validate and save that one
            const targets = (singleIndex !== null) ? [singleIndex] : quizData.questions.map((_, i) => i);

            targets.forEach((idx) => {
                const q = quizData.questions[idx];
                const cleanAns = String(q.answer || '').trim();
                const cleanText = String(q.question || '').trim();

                if (!cleanText || !cleanAns || cleanAns.toLowerCase() === 'no answer provided') {
                    invalidQuestions.push(idx + 1);
                }
            });

            if (invalidQuestions.length > 0 && singleIndex === null) {
                const proceed = confirm(`<i data-lucide="alert-triangle" class="icon-sm"></i>️ WARNING: Questions ${invalidQuestions.join(', ')} appear to have empty text or answers.\n\nStudents will not be able to be graded properly on these.\n\nSave anyway?`);
                if (!proceed) return;
            } else if (invalidQuestions.length > 0 && singleIndex !== null) {
                alert(`Cannot save: Question ${singleIndex + 1} has empty text or answer.`);
                return;
            }

            // --- UI FEEDBACK FOR SINGLE SAVE ---
            let originalBtnText = '';
            if (btn) {
                originalBtnText = btn.innerHTML;
                btn.innerHTML = '⌛...';
                btn.disabled = true;
            }

            quizData.questions.forEach((q, qIndex) => {
                quizData.questions[qIndex].question = processTikzToImageJS(q.question);
            });
            quizData.title = document.getElementById('quiz-title').value;
            quizData.time_limit = document.getElementById('quiz-time').value;
            quizData.quiz_mode = document.getElementById('quiz-mode').value;
            quizData.require_solution = document.getElementById('require-solution').checked;

            // --- ATTACH CREDENTIALS (Ensures AI support for Blank/Transferred quizzes) ---
            const currentKey = localStorage.getItem('gemini_api_key');
            const currentModel = quizData.model_name || 'gemini-3.5-flash-lite';
            if (currentKey) {
                quizData.api_key = currentKey;
                quizData.model_name = currentModel;
            }

            fetch('/update/' + quizData.id, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(quizData) })
            .then(res => res.json())
            .then(data => {
                if(data.success) {
                    if (data.quiz && data.quiz.title) {
                        quizData.title = data.quiz.title;
                        const titleInput = document.getElementById('quiz-title');
                        if (titleInput) titleInput.value = data.quiz.title;
                    }
                    if (btn) {
                        btn.innerHTML = '<i data-lucide="check-circle" class="icon-sm"></i> SAVED';
                        btn.style.background = 'var(--success)';
                        setTimeout(() => {
                            btn.style.display = 'none';
                            btn.innerHTML = originalBtnText;
                            btn.disabled = false;
                        }, 1500);
                    } else if (redirect) {
                        alert('Quiz saved successfully!');
                        window.location.href = '/';
                    }
                }
            });
        }
        renderQuestions();
    </script>
    <script>lucide.createIcons();</script>
</body>
</html>