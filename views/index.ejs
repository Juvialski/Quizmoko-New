    <!-- Merge Floating Action Bar -->
    <div id="mergeActionBar" style="display:none; position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%); background: var(--surface-elevated); border: 1px solid var(--hairline); color: var(--on-dark); padding: 16px 32px; border-radius: var(--radius-md); box-shadow: var(--shadow); z-index: 1000; align-items: center; gap: 24px;">
        <span id="mergeCount" style="font-weight: 600; font-size: 14px;">0 Selected</span>
        <button onclick="executeMerge()" style="background: var(--primary); color: #fff; border: none; padding: 12px 24px; font-weight: 600; border-radius: var(--radius-sm); cursor: pointer;"><i data-lucide="check-circle" class="icon-sm"></i> Confirm Merge</button>
        <button onclick="toggleMergeMode()" style="background: transparent; border: 1px solid var(--hairline); color: var(--on-dark); padding: 12px 24px; font-weight: 600; border-radius: var(--radius-sm); cursor: pointer;"><i data-lucide="x-circle" class="icon-sm"></i> Cancel</button>
    </div>

    <% if (user) { %>
    <!-- API KEY MODAL -->
    <div id="apiKeyModal" class="modal-overlay">
        <div class="modal-card">
            <h2 id="api-key-modal-title" style="margin-bottom: 16px; font-size: 24px; text-transform: none; display: inline-flex; align-items: center; gap: 8px;"><i data-lucide="key" class="icon-sm"></i> API Key Setup</h2>
            
            <p id="api-key-modal-desc" style="color: var(--body); font-size: 14px; margin-bottom: 24px; line-height: 1.5;">To generate quizzes and access AI tools, provide your Google Gemini API Key.</p>
            
            <div id="gemini_key_container">
                <div style="background: var(--surface-soft); border: 1px solid var(--hairline); border-radius: var(--radius-sm); padding: 16px; margin-bottom: 24px; font-size: 12px; color: var(--body-strong); line-height: 1.5;">
                    <strong style="color: var(--on-dark);">SECURITY & REPLACEMENT:</strong> Do not share your key. It is saved locally and synced to your server profile.<br>
                    <span style="color: var(--muted); display: block; margin-top: 4px;">If your old key was revoked or flagged as leaked by Google, generate a fresh free key on Google AI Studio and paste it below to restore full access.</span>
                    <a href="https://aistudio.google.com/app/apikey" target='_blank' style="color: var(--m-blue-light); font-weight: 700; display: inline-block; margin-top: 8px; text-decoration: none;">GET FREE KEY ON GOOGLE AI STUDIO ↗</a>
                </div>

                <label style="margin-top: 0;">Primary API Key</label>
                <input type="password" id="modal_api_key_input" placeholder="Paste your primary API key..." autocomplete='off' spellcheck='false' style="margin-bottom: 12px;">

                <label style="margin-top: 0;">Secondary Key 1 (Backup)</label>
                <input type="password" id="modal_api_key_2" placeholder="Optional backup key..." autocomplete='off' spellcheck='false' style="margin-bottom: 12px;">

                <label style="margin-top: 0;">Secondary Key 2 (Backup)</label>
                <input type="password" id="modal_api_key_3" placeholder="Optional backup key..." autocomplete='off' spellcheck='false' style="margin-bottom: 20px;">
            </div>
            
            <button onclick="saveApiKey()" class="btn btn-primary btn-block" style="margin-top: 0;"><i data-lucide="save" class="icon-sm"></i> Save Settings</button>
            <button onclick="closeApiKeyModal()" class="btn btn-secondary" id="modal-cancel-btn" style="width: 100%; margin-top: 12px; padding: 14px; display: none;"><i data-lucide="x-circle" class="icon-sm"></i> Cancel</button>
        </div>
    </div>
    <% } %>

    <!-- OLLAMA INSTRUCTIONS MODAL -->
    <div id="ollamaModal" class="modal-overlay">
        <div class="modal-card">
            <h2 style="margin-bottom: 16px; font-size: 24px; text-transform: none;"><i data-lucide="box" class="icon-sm"></i> Setup Local AI</h2>
            
            <p style="color: var(--body); font-size: 14px; margin-bottom: 16px;">Local models are available only when the QuizMoKo server administrator configures an Ollama host.</p>

            <div style="background: rgba(245, 158, 11, 0.1); border: 1px solid var(--warning); padding: 12px; border-radius: var(--radius-sm); margin-bottom: 16px; font-size: 12px; color: var(--warning); line-height: 1.4;">
                Browser-supplied Ollama URLs and remote model installation are disabled for security. Configure the host through server environment settings.
            </div>

            <button onclick="scanOllama()" class="btn btn-primary btn-block" id="btn-scan-ollama" style="margin-top: 0;"><i data-lucide="search" class="icon-sm"></i> Refresh Configured Models</button>
            <button onclick="closeOllamaModal()" class="btn-secondary" style="width: 100%; margin-top: 12px; padding: 14px;"><i data-lucide="x-circle" class="icon-sm"></i> Close</button>
        </div>
    </div>

    <!-- CREATE BLANK MODAL -->
    <div id="createBlankModal" class="modal-overlay">
        <div class="modal-card">
            <h2 style="margin-bottom: 16px; font-size: 24px;"><i data-lucide="plus-circle" class="icon-sm"></i> New Blank Quiz</h2>
            

            <label>Quiz Title</label>
            <input type="text" id="blank-quiz-title" placeholder="e.g. My Custom Test">

            <label>Subject / Folder</label>
            <select id="blank-quiz-subject" onchange="toggleCustomBlankSubject(this)">
                <% for (let s of (all_subjects || [])) { %>
                    <option value="<%= typeof s !== 'undefined' ? s : '' %>" <% if (s == 'General') { %>selected<% } %>><%= typeof s !== 'undefined' ? s : '' %></option>
                <% } %>
                <option value="__custom__">+ New Folder...</option>
            </select>
            <input type="text" id="blank-quiz-custom-subject" placeholder="Enter folder name" style="display:none; margin-top: 8px;">

            <div style="display: flex; gap: 12px; margin-top: 24px;">
                <button onclick="executeCreateBlank()" class="btn-primary" style="margin-top: 0; flex: 1;">Create Quiz</button>
                <button onclick="closeCreateBlankModal()" class="btn-secondary" style="flex: 1;">Cancel</button>
            </div>
        </div>
    </div>

    <!-- MOVE QUIZ MODAL -->
    <div id="moveModal" class="modal-overlay">
        <div class="modal-card">
            <h2 style="margin-bottom: 16px; font-size: 24px;"><i data-lucide="folder-output" class="icon-sm"></i> Move to Folder</h2>
            

            <input type="hidden" id="move-quiz-id">
            <label>Select Destination Folder</label>
            <select id="move-quiz-subject" onchange="toggleCustomMoveSubject(this)">
                <% for (let s of (all_subjects || [])) { %>
                    <option value="<%= typeof s !== 'undefined' ? s : '' %>"><%= typeof s !== 'undefined' ? s : '' %></option>
                <% } %>
                <option value="__custom__">+ New Folder...</option>
            </select>
            <input type="text" id="move-quiz-custom-subject" placeholder="Enter folder name" style="display:none; margin-top: 8px;">

            <div style="display: flex; gap: 12px; margin-top: 24px;">
                <button onclick="executeMove()" class="btn-primary" style="margin-top: 0; flex: 1;">Move Quiz</button>
                <button onclick="closeMoveModal()" class="btn-secondary" style="flex: 1;">Cancel</button>
            </div>
        </div>
    </div>

    <script>
        const canManageApiKeys = <%- JSON.stringify(Boolean(user)) %>;
        let serverAiConfigured = false;
        let serverOllamaConfigured = false;

        function getStoredGeminiKeys() {
            if (!canManageApiKeys) return [];
            try {
                const parsed = JSON.parse(localStorage.getItem('gemini_api_keys') || '[]');
                return Array.isArray(parsed)
                    ? parsed.filter(key => typeof key === 'string' && key.trim()).map(key => key.trim())
                    : [];
            } catch (e) {
                localStorage.removeItem('gemini_api_keys');
                return [];
            }
        }

        async function loadServerAiConfiguration() {
            try {
                const response = await fetch('/api/ai/config');
                const data = response.ok ? await response.json() : null;
                serverAiConfigured = !!(data && data.gemini_configured);
                serverOllamaConfigured = !!(data && data.ollama_configured);
            } catch (e) {
                serverAiConfigured = false;
                serverOllamaConfigured = false;
            }
            updateOllamaAvailability();
            return serverAiConfigured;
        }

        function updateOllamaAvailability() {
            const group = document.getElementById('ollama-model-group');
            const select = document.getElementById('model_select');
            if (!group || !select) return;

            group.disabled = !serverOllamaConfigured;
            group.hidden = !serverOllamaConfigured;
            if (!serverOllamaConfigured) {
                group.replaceChildren();
                if (select.value.startsWith('ollama:')) {
                    select.value = 'gemini-3.5-flash-lite';
                }
            }
        }

        // --- API KEY & DISCLAIMER LOGIC ---
        const hiddenApiInput = document.getElementById('hidden_api_key');
        const apiKeyModal = document.getElementById('apiKeyModal');
        const modalApiInput = document.getElementById('modal_api_key_input');
        const modalApiInput2 = document.getElementById('modal_api_key_2');
        const modalApiInput3 = document.getElementById('modal_api_key_3');
        const cancelBtn = document.getElementById('modal-cancel-btn');

        function openApiKeyModal() {
            if (!canManageApiKeys || !apiKeyModal) return;
            const keys = getStoredGeminiKeys();
            modalApiInput.value = keys[0] || localStorage.getItem('gemini_api_key') || '';
            modalApiInput2.value = keys[1] || '';
            modalApiInput3.value = keys[2] || '';
            cancelBtn.style.display = (modalApiInput.value || serverAiConfigured) ? 'inline-flex' : 'none';

            const modalTitle = document.getElementById('api-key-modal-title');
            const modalDesc = document.getElementById('api-key-modal-desc');
            document.getElementById('gemini_key_container').style.display = 'block';
            modalTitle.innerHTML = '<i data-lucide="key" class="icon-sm"></i> API Key Setup';
            window.refreshQuizmokoIcons?.();
            modalDesc.innerHTML = 'To generate quizzes, provide a Google Gemini API key or use the server-configured Gemini connection.';

            apiKeyModal.classList.add('active');
            apiKeyModal.style.display = 'flex';
        }

        function closeApiKeyModal() {
            apiKeyModal.classList.remove('active');
            apiKeyModal.style.display = 'none';
        }

        function openOllamaModal() {
            if (!serverOllamaConfigured) {
                alert('Local models are not configured on this QuizMoKo server.');
                return;
            }
            document.getElementById('apiKeyModal').style.display = 'none';
            document.getElementById('ollamaModal').style.display = 'flex';
        }

        function closeOllamaModal() {
            document.getElementById('ollamaModal').style.display = 'none';
        }

        async function scanOllama() {
            const btn = document.getElementById('btn-scan-ollama');
            if (btn) { btn.innerText = 'Scanning...'; btn.disabled = true; }

            if (!serverOllamaConfigured) {
                if (btn) {
                    btn.innerText = 'Local AI is not configured';
                    btn.disabled = false;
                }
                return;
            }

            try {
                const res = await fetch('/api/ollama_tags');
                const data = await res.json();

                if (res.ok && data.success && data.installed && Array.isArray(data.models) && data.models.length > 0) {
                    populateLocalModels(data.models);
                    if (btn) {
                        btn.innerHTML = `<i data-lucide="check-circle" class="icon-sm"></i> Found ${data.models.length} models!`;
                        btn.style.background = 'var(--success)';
                        window.refreshQuizmokoIcons?.();
                    }
                    document.getElementById('model_select').value = 'ollama:' + data.models[0];
                    updateCounterUI();
                    
                    setTimeout(() => {
                        closeOllamaModal();
                        closeApiKeyModal();
                        if (btn) {
                            btn.innerHTML = '<i data-lucide="search" class="icon-sm"></i> Refresh Configured Models';
                            btn.style.background = 'var(--primary)';
                            btn.disabled = false;
                            window.refreshQuizmokoIcons?.();
                        }
                    }, 1500);
                } else {
                    if (btn) {
                        btn.innerHTML = '<i data-lucide="x-circle" class="icon-sm"></i> No models found yet';
                        btn.style.background = 'var(--m-red)';
                        window.refreshQuizmokoIcons?.();
                    }
                    setTimeout(() => {
                        if(btn) {
                            btn.innerHTML = '<i data-lucide="search" class="icon-sm"></i> Refresh Configured Models';
                            btn.style.background = 'var(--primary)';
                            btn.disabled = false;
                            window.refreshQuizmokoIcons?.();
                        }
                    }, 3000);
                }
            } catch (e) {
                if (btn) {
                    btn.innerHTML = '<i data-lucide="x-circle" class="icon-sm"></i> Configured Ollama host is unavailable';
                    btn.style.background = 'var(--m-red)';
                    window.refreshQuizmokoIcons?.();
                }
                setTimeout(() => {
                    if(btn) {
                        btn.innerHTML = '<i data-lucide="search" class="icon-sm"></i> Refresh Configured Models';
                        btn.style.background = 'var(--primary)';
                        btn.disabled = false;
                        window.refreshQuizmokoIcons?.();
                    }
                }, 3000);
            }
        }

        function populateLocalModels(models) {
            const localOptGroup = document.getElementById('ollama-model-group');
            if (!localOptGroup || !serverOllamaConfigured) return;
            localOptGroup.replaceChildren();
            const safeModels = Array.isArray(models)
                ? models.filter(model => typeof model === 'string' && model.trim()).slice(0, 100)
                : [];
            safeModels.forEach(model => {
                const opt = document.createElement('option');
                opt.value = 'ollama:' + model.trim();
                opt.textContent = model.trim() + ' (Local)';
                localOptGroup.appendChild(opt);
            });
            localOptGroup.disabled = safeModels.length === 0;
            localOptGroup.hidden = safeModels.length === 0;
        }

        function saveApiKey() {
            if (!canManageApiKeys || !modalApiInput) return;
            const key1 = modalApiInput.value.trim();
            const key2 = modalApiInput2.value.trim();
            const key3 = modalApiInput3.value.trim();

            function isInvalidKey(k) {
                return k && (k.includes('•') || k.includes('…') || /[^\x00-\x7F]/.test(k));
            }
            if (isInvalidKey(key1) || isInvalidKey(key2) || isInvalidKey(key3)) {
                alert('Invalid API key format. Please paste a valid Google Gemini API key (e.g., AIzaSy...). Keys must contain valid ASCII characters and cannot be masked placeholders.');
                return;
            }

            if (!key1 && !serverAiConfigured) {
                alert('Please enter at least a Primary Gemini API Key.');
                return; 
            }

            const keys = key1 ? [key1] : [];
            if (key2) keys.push(key2);
