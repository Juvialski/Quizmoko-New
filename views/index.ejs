                    item.onclick = (e) => {
                        if(e.target.tagName === 'A' || e.target.tagName === 'BUTTON' || e.target.closest('.actions')) {
                            e.preventDefault(); return;
                        }
                        const qid = item.getAttribute('data-id');
                        if(selectedQuizzes.has(qid)) {
                            selectedQuizzes.delete(qid);
                            item.style.border = '1px solid var(--hairline)';
                            item.style.background = 'var(--canvas)';
                        } else {
                            selectedQuizzes.add(qid);
                            item.style.border = '2px solid var(--on-dark)';
                            item.style.background = 'var(--surface-elevated)';
                        }
                        document.getElementById('mergeCount').innerText = `${selectedQuizzes.size} SELECTED`;
                    };
                } else {
                    item.style.cursor = 'default';
                    item.onclick = null;
                    item.style.border = '1px solid var(--hairline)';
                    item.style.background = 'var(--canvas)';
                }
            });
        }

        let isMerging = false;
        async function executeMerge() {
            if(selectedQuizzes.size < 2) {
                alert('Please select at least 2 worksheets to merge.');
                return;
            }
            if(isMerging) return;

            const newTitle = prompt('Enter a title for the newly merged worksheet:', 'Merged Worksheet');
            if(!newTitle) return;

            isMerging = true;
            document.getElementById('mergeCount').innerText = 'MERGING...';
            
            const mergeBtn = document.querySelector('#mergeActionBar button[onclick="executeMerge()"]');
            const cancelBtn = document.querySelector('#mergeActionBar button[onclick="toggleMergeMode()"]');
            if (mergeBtn) {
                mergeBtn.disabled = true;
                mergeBtn.innerText = '⏳ Merging...';
            }
            if (cancelBtn) cancelBtn.disabled = true;

            try {
                const res = await fetch('/merge', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ quiz_ids: Array.from(selectedQuizzes), new_title: newTitle })
                });
                const data = await res.json();
                if(data.success) {
                    window.location.href = `/edit/${data.new_quiz_id}`;
                } else {
                    alert('Merge failed: ' + data.error);
                    isMerging = false;
                    document.getElementById('mergeCount').innerText = `${selectedQuizzes.size} SELECTED`;
                    if (mergeBtn) {
                        mergeBtn.disabled = false;
                        mergeBtn.innerHTML = '<i data-lucide="check-circle" class="icon-sm"></i> Confirm Merge';
                        window.refreshQuizmokoIcons();
                    }
                    if (cancelBtn) cancelBtn.disabled = false;
                }
            } catch(err) {
                alert('An error occurred during merge.');
                isMerging = false;
                document.getElementById('mergeCount').innerText = `${selectedQuizzes.size} SELECTED`;
                if (mergeBtn) {
                    mergeBtn.disabled = false;
                    mergeBtn.innerHTML = '<i data-lucide="check-circle" class="icon-sm"></i> Confirm Merge';
                    window.refreshQuizmokoIcons();
                }
                if (cancelBtn) cancelBtn.disabled = false;
            }
        }
    </script>

    <!-- FIREBASE LOGOUT LOGIC -->
    <script type="module">
        import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js';
        import { getAuth, signOut } from 'https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js';

        const firebaseConfigResponse = await fetch('/api/firebase_config');
        if (!firebaseConfigResponse.ok) throw new Error('Firebase configuration is unavailable');
        const firebaseConfig = await firebaseConfigResponse.json();

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);

        document.getElementById('logout-btn').addEventListener('click', async () => {
            try {
                await signOut(auth);
                // Clear the HTTP-only QuizMoKo session.
                await fetch('/logout');
                window.location.href = '/login';
            } catch (error) {
                console.error('Error signing out: ', error);
                alert('Failed to log out: ' + error.message);
            }
        });
    </script>
    <script>window.refreshQuizmokoIcons?.();
    function toggleAccordion(id) {
        document.querySelectorAll('.accordion-body').forEach(el => {
            if(el.id !== id) el.classList.remove('open');
        });
        document.getElementById(id).classList.toggle('open');
    }
    
    function toggleQuizDropdown(id) {
        document.querySelectorAll('.quiz-actions-dropdown').forEach(el => {
            if(el.id !== id) {
                el.classList.remove('show');
                const card = el.closest('.quiz-card-horizontal');
                if(card) card.style.zIndex = '';
            }
        });
        const dropdown = document.getElementById(id);
        if (dropdown) {
            const isShowing = dropdown.classList.toggle('show');
            const card = dropdown.closest('.quiz-card-horizontal');
            if(card) card.style.zIndex = isShowing ? '50' : '';
        }
    }
    
    document.addEventListener('click', function(e) {
        if (!e.target.closest('.quiz-actions-menu')) {
            document.querySelectorAll('.quiz-actions-dropdown').forEach(el => {
                el.classList.remove('show');
                const card = el.closest('.quiz-card-horizontal');
                if(card) card.style.zIndex = '';
            });
        }
    });

    function stepVal(inputId, delta) {
        const el = document.getElementById(inputId);
        let val = (parseInt(el.value) || 0) + delta;
        if(val < 0) val = 0;
        if(val > 50) val = 50;
        el.value = val;
        updateTypeTotal();
    }

</script>
</body>
