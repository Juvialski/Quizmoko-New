        function checkAndRunTour() {
            if (localStorage.getItem('tour_completed') === 'true') return;

            const isTeacher = canManageApiKeys;
            const driver = window.driver.js.driver;
            
            const steps = [
                { popover: { title: 'Welcome to QuizMoKo!', description: 'Let’s take a quick tour to show you how to generate awesome quizzes in seconds.' } },
                { element: '#ai-generator-card', popover: { title: 'AI Generator', description: 'Configure your topic, difficulty, and AI models here to generate your quiz.' } },
                { element: '#subject-folder-group', popover: { title: 'Organize', description: 'Assign your quiz to a folder or subject so it’s easy to find later.' } },
                { element: '#api-key-btn', popover: { title: 'Settings', description: 'You can always update your API Key right here.' } }
            ];

            if (!isTeacher) {
                const keyStepIndex = steps.findIndex(step => step.element === '#api-key-btn');
                if (keyStepIndex >= 0) steps.splice(keyStepIndex, 1);
            }

            if (isTeacher) {
                steps.push({ element: '#saved-quizzes-card', popover: { title: 'Your Library', description: 'All your generated quizzes will be saved here safely.' } });
                steps.push({ element: '#search-merge-bar', popover: { title: 'Merge Tool', description: 'Select multiple quizzes and merge them into a single big worksheet!' } });
            }
            
            steps.push({ popover: { title: 'You are ready!', description: 'Enjoy generating your quizzes. Click Done to begin!' } });

            const tourObj = driver({
                showProgress: true,
                steps: steps,
                onDestroyStarted: () => {
                    if (!tourObj.hasNextStep() || confirm('Are you sure you want to skip the tour?')) {
                        localStorage.setItem('tour_completed', 'true');
                        tourObj.destroy();
                    }
                }
            });

            tourObj.drive();
        }

        // --- RATE LIMIT TRACKER LOGIC ---
        const API_LIMITS = {
            'gemini-3.5-flash-lite': 500,
            'gemini-3.1-flash-lite': 500
        };

        let GLOBAL_DAILY_STATS = {};

        async function getHash(text) {
            if (!text) return 'default';
            const msgUint8 = new TextEncoder().encode(text);
            const hashBuffer = await crypto.subtle.digest('SHA-256', msgUint8);
            const hashArray = Array.from(new Uint8Array(hashBuffer));
            const hashHex = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
            return hashHex.substring(0, 8);
        }

        async function fetchUsageStats() {
            try {
                const res = await fetch('/api/usage/stats');
                const data = await res.json();
                if (data.success) {
                    GLOBAL_DAILY_STATS = data.daily_stats;
                    updateUsageDashboard();
                    updateCounterUI();
                }
            } catch (e) {
                console.error('Failed to fetch usage stats:', e);
            }
        }

        async function updateUsageDashboard() {
            let todayTotal = 0;
            let allTimeTotal = 0;
            const tableBody = document.getElementById('usage-table-body');
            if (!tableBody) return;
            tableBody.innerHTML = '';

            const today = new Date().toISOString().split('T')[0];

            // Sort dates descending
            const sortedDates = Object.keys(GLOBAL_DAILY_STATS).sort().reverse();

            for (const date of sortedDates) {
                const models = GLOBAL_DAILY_STATS[date];
                for (const model in models) {
                    const keys = models[model];
                    let modelCount = 0;
                    for (const kid in keys) {
                        modelCount += keys[kid];
                    }

                    if (date === today) todayTotal += modelCount;
                    allTimeTotal += modelCount;

                    const row = document.createElement('tr');
                    row.style.borderBottom = '1px solid var(--hairline)';
                    row.innerHTML = `
                        <td style="padding: 10px 0; color: var(--body);">${date}</td>
                        <td style="padding: 10px 0; color: var(--on-dark);">${model}</td>
                        <td style="padding: 10px 0; text-align: center;">${modelCount}</td>
                        <td style="padding: 10px 0; text-align: center; color: var(--body);">${API_LIMITS[model] || '∞'}</td>
                    `;
                    tableBody.appendChild(row);
                }
            }

            document.getElementById('today-total-calls').innerText = todayTotal;
            document.getElementById('all-time-calls').innerText = allTimeTotal;
        }

