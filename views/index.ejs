                    <button id="mergeModeBtn" onclick="toggleMergeMode()" class="btn-primary" style="width: auto; margin-top: 0; white-space: nowrap; padding: 14px 24px;"><i data-lucide="link" class="icon-sm"></i> Merge Mode</button>
