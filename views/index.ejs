        async function updateCounterUI() {
            let model = document.getElementById('model_select').value;

            if (model.startsWith('ollama:') && !serverOllamaConfigured) {
                document.getElementById('model_select').value = 'gemini-3.5-flash-lite';
                model = 'gemini-3.5-flash-lite';
            }

            const today = new Date().toISOString().split('T')[0];
            const modelStats = (GLOBAL_DAILY_STATS[today] && GLOBAL_DAILY_STATS[today][model]) || {};

            const keys = getStoredGeminiKeys();
            if (keys.length === 0 && localStorage.getItem('gemini_api_key')) keys.push(localStorage.getItem('gemini_api_key'));

            let totalUsed = 0;
            let totalLimit = 0;
            let isLocal = model.startsWith('ollama:');
            const baseLimit = API_LIMITS[model] || 20;

            if (isLocal) {
                totalLimit = '∞';
                totalUsed = 0;
            } else {
                for (const key of keys) {
                    const kid = await getHash(key);
                    totalUsed += modelStats[kid] || 0;
                    totalLimit += baseLimit;
                }
                if (keys.length === 0) totalLimit = baseLimit; // Default view
            }

            let remaining = isLocal ? '∞' : Math.max(0, totalLimit - totalUsed);
            
            let badge = document.getElementById('api-counter-badge');
            if (badge) {
                badge.innerHTML = `⏳ <b>${remaining} / ${totalLimit}</b><br>Requests Left`;

                if (!isLocal && remaining <= 0) {
                    badge.style.color = 'var(--m-red)';
                    badge.style.borderColor = 'var(--m-red)';
                } else {
                    badge.style.color = 'var(--m-blue-light)';
                    badge.style.borderColor = 'var(--hairline)';
                }
            }
        }

        // --- FORM SUBMIT LOGIC ---
        async function handleAILoading(event, form) {
            event.preventDefault();
            let model = form.model_name.value;
            let isLocal = model.startsWith('ollama:');

            if (isLocal && !serverOllamaConfigured) {
                alert('Local models are not configured on this QuizMoKo server.');
                form.model_name.value = 'gemini-3.5-flash-lite';
                updateCounterUI();
                return false;
            }

            const keys = getStoredGeminiKeys();
            if (keys.length === 0 && localStorage.getItem('gemini_api_key')) keys.push(localStorage.getItem('gemini_api_key'));

            // Verify key one last time
            if (keys.length === 0 && !isLocal && !serverAiConfigured) {
                alert('No browser or server Gemini API key is configured.');
                openApiKeyModal();
                return false;
            }

            let numItems = Number(form.num_items.value);
            let batchSize = Number(form.batch_size.value);
            if (form.test_type.value === 'Mixed') {
                const mixedCounts = [
                    Number(form.mc_count.value),
                    Number(form.tf_count.value),
                    Number(form.id_count.value),
                    Number(form.oe_count.value),
                    Number(form.gr_count.value)
                ];
                if (mixedCounts.some(count => !Number.isInteger(count) || count < 0 || count > 50)) {
                    alert('Each mixed question count must be a whole number between 0 and 50.');
                    return false;
                }
                numItems = mixedCounts.reduce((sum, count) => sum + count, 0);
                form.num_items.value = String(numItems);
            }
            if (!Number.isInteger(numItems) || numItems < 1 || numItems > 50) {
                alert('Total questions must be a whole number between 1 and 50.');
                return false;
            }
            if (!Number.isInteger(batchSize) || batchSize < 1 || batchSize > 10) {
                alert('Batch size must be a whole number between 1 and 10.');
                return false;
            }
            
            // Optimization for 20+ questions: Ensure batch size is reasonable
            if (numItems >= 20 && batchSize > 5) {
                form.batch_size.value = 5;
                batchSize = 5;
            }

            const difficultyTotal =
                (Number(form.easy_pct.value) || 0)
                + (Number(form.avg_pct.value) || 0)
                + (Number(form.hard_pct.value) || 0);
            if (Math.abs(difficultyTotal - 100) > 0.001) {
                alert('Difficulty percentages must total 100%.');
                return false;
            }

            let estimatedRequests = Math.ceil(numItems / batchSize);
            
            let isStudent = false;
            if (isStudent) {
                estimatedRequests *= 2; 
            }

            const today = new Date().toISOString().split('T')[0];
            const modelStats = (GLOBAL_DAILY_STATS[today] && GLOBAL_DAILY_STATS[today][model]) || {};
            const baseLimit = API_LIMITS[model] || 20;

            let selectedKey = null;
            if (!isLocal) {
                for (const key of keys) {
                    const kid = await getHash(key);
                    const used = modelStats[kid] || 0;
                    if (used + estimatedRequests <= baseLimit) {
                        selectedKey = key;
                        break;
                    }
                }

                if (!selectedKey && !serverAiConfigured) {
                    alert(`Daily Rate Limit Reached for all keys on ${model}!\n\nYou need ${estimatedRequests} requests, but none of your keys have enough quota left today.`);
                    return false;
                }
                // Empty means the server-side GEMINI_API_KEY/API_KEY fallback.
                form.api_key.value = selectedKey || '';
            }

            // Optimistically update UI (will sync for real on next page load or via fetch)
            if (selectedKey) {
                const kid = await getHash(selectedKey);
                if (!GLOBAL_DAILY_STATS[today]) GLOBAL_DAILY_STATS[today] = {};
                if (!GLOBAL_DAILY_STATS[today][model]) GLOBAL_DAILY_STATS[today][model] = {};
                GLOBAL_DAILY_STATS[today][model][kid] = (GLOBAL_DAILY_STATS[today][model][kid] || 0) + estimatedRequests;
                updateCounterUI();
            }

            const btn = document.getElementById('generate-btn');
            if (isStudent) {
                btn.innerHTML = '⏳ GENERATING & CHECKING... (PLEASE WAIT)';
            } else {
                btn.innerHTML = '⏳ GENERATING AI QUIZ... (PLEASE WAIT)';
            }
            
            // LOCK THE FORM & BUTTON TO PREVENT DOUBLE-CLICKS
            btn.style.color = 'var(--warning)';
            btn.style.borderColor = 'var(--warning)';
            btn.disabled = true; 
            form.style.opacity = '0.5';
            form.style.pointerEvents = 'none';
            document.getElementById('loading-overlay').style.display = 'block';

            // onsubmit was cancelled synchronously above; submit only after
            // asynchronous key selection and validation have completed.
            HTMLFormElement.prototype.submit.call(form);
            return false;
        }

