            <i data-lucide="clock" class="icon-xs" style="margin-right:4px;"></i> <%= typeof sq.time_limit !== 'undefined' ? sq.time_limit : '' %>s / Q • 
            <span class="link-display" style="border:none; background:transparent; padding:0; margin-left:8px; cursor:pointer; min-width: 0;" id="url-<%= typeof sq.id !== 'undefined' ? sq.id : '' %>" onclick="copyLink('<%= typeof sq.id !== 'undefined' ? sq.id : '' %>')"></span>
        </div>
    </div>
    
    <div style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
