<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Live Tracking - <%= typeof title !== 'undefined' ? title : '' %></title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/quizmoko-ui.css">
    <script src="/js/quizmoko-theme.js"></script>
    
    <!-- Configure MathJax for live rendering of math in the preview -->
    <script>
      window.MathJax = {
        tex: { inlineMath: [['$', '$'], ['\\(', '\\)']], displayMath: [['$$', '$$'], ['\\[', '\\]']] }
      };
    </script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
    <script src="/socket.io/socket.io.js"></script>

    <style>
        body { 
            font-family: 'Inter', sans-serif; 
            margin: 0; 
            padding: 40px 20px; 
            color: var(--body-strong); 
            background-color: var(--canvas);
            font-weight: 400;
            transition: background-color 0.3s ease, color 0.3s ease;
        }
        .container { max-width: 1440px; margin: auto; }
        
        .live-results-card { padding: 40px; }
        
        h1 { margin-top: 0; font-size: 32px; color: var(--on-dark); font-weight: 700; letter-spacing: -0.5px; display: flex; align-items: center;}
        .m-stripe-divider { height: 4px; width: 60px; background: var(--primary); border-radius: 2px; margin-bottom: 24px; }
        
        .back-link { display: inline-block; margin-bottom: 32px; color: var(--body); text-decoration: none; font-weight: 600; font-size: 13px; }
        .back-link:hover { color: var(--on-dark); }
        
        table { width: 100%; border-collapse: collapse; margin-top: 24px; font-size: 14px;}
        th, td { padding: 20px 24px; text-align: left; border-bottom: 1px solid var(--hairline); vertical-align: middle;}
        th { background-color: var(--surface-elevated); font-weight: 600; color: var(--on-dark); font-size: 13px; }
        th:first-child { border-top-left-radius: var(--radius-sm); }
        th:last-child { border-top-right-radius: var(--radius-sm); }
        
        .score-badge { background: var(--surface-soft); color: var(--on-dark); padding: 6px 12px; border: 1px solid var(--primary); font-weight: 600; font-size: 13px; border-radius: 16px;}
        .pulse { display: inline-block; width: 12px; height: 12px; background-color: var(--m-red); margin-right: 16px; animation: pulse-anim 1.5s infinite;}
        
        .question-preview {
            background: var(--surface-soft);
            border: 1px solid var(--hairline);
            border-radius: var(--radius-sm);
            padding: 10px 16px;
            color: var(--body);
            font-size: 13px;
            max-width: 350px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            font-family: monospace;
        }
        summary.question-preview { cursor: pointer; transition: 0.2s; list-style: none;}
        summary.question-preview::-webkit-details-marker { display: none; }
        summary.question-preview:hover { border-color: var(--primary); }
        
        .full-question-box { background: var(--surface-card); border: 1px solid var(--hairline); padding: 16px; border-radius: var(--radius-sm); margin-top: 8px; font-size: 13px; white-space: normal; color: var(--on-dark); box-shadow: var(--shadow); font-family: 'Inter', sans-serif;}
        .full-question-box .resizable-image-wrapper { margin: 10px 0; display: flex; justify-content: flex-start;}
        .full-question-box img { max-width: 100%; height: auto; background: white; padding: 5px; border-radius: 4px; }

        @keyframes pulse-anim {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(226, 39, 24, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(226, 39, 24, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(226, 39, 24, 0); }
        }
    
        


        /* Responsive Mobile Live View Styles */
        @media (max-width: 768px) {
            body {
                padding: 16px 12px !important;
            }
            .live-results-card {
                padding: 16px !important;
            }
            table {
                display: block;
                overflow-x: auto;
                white-space: nowrap;
            }
            th, td {
                padding: 12px 14px !important;
            }
        }
    </style>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body>
    <div class="container">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 32px;">
            <a href="/" class="back-link" style="margin-bottom: 0;"><i data-lucide="arrow-left" class="icon-sm"></i> Back to Dashboard</a>
            <div style="display: flex; gap: 16px; align-items: center;">
                <button id="pause-btn" onclick="togglePause()" class="score-badge" style="background-color: var(--warning); color: var(--canvas); border: none; cursor: pointer; padding: 8px 16px;">⏸️ Pause Timers</button>
                <button id="terminate-btn" onclick="terminateQuiz()" class="score-badge" style="background-color: var(--m-red); color: white; border: none; cursor: pointer; padding: 8px 16px;"><i data-lucide="stop-circle" class="icon-sm"></i> Terminate Quiz</button>
                <button type="button" onclick="toggleTheme()" data-theme-toggle title="Toggle Theme" aria-label="Switch to light theme" class="btn btn-ghost btn-icon"><i data-lucide="moon"></i></button>
            </div>
        </div>
        
        <div class="card live-results-card">
            <h1><span class="pulse"></span> <i data-lucide="radio" class="icon-sm"></i> LIVE: <%= typeof title !== 'undefined' ? title : '' %></h1>
            
            <p style="color: var(--body); font-size: 12px; margin-top: -5px; text-transform: uppercase; letter-spacing: 1.5px;">TABLE UPDATES AUTOMATICALLY EVERY 2 SECONDS.</p>
            
            <table id="live-table">
                <thead>
                    <tr>
                        <th>STUDENT NAME</th>
                        <th style="width: 10%;">SIGNAL</th>
                        <th style="width: 12%;">PROGRESS</th>
                        <th>CURRENTLY ANSWERING</th>
                        <th>WHITEBOARD</th>
                        <th>LIVE SCORE</th>
                        <th>STATUS</th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td colspan='7' style="text-align:center; color:var(--body); padding:40px; text-transform: uppercase; letter-spacing: 1.5px;">Waiting for students to join...</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Original Preserved Javascript -->
    <script>
        const quizId = '<%= typeof quiz_id !== 'undefined' ? quiz_id : '' %>';
        const totalQ = <%= typeof total_q !== 'undefined' && total_q ? total_q : 0 %>;
        const quizQuestions = <%- typeof quiz !== 'undefined' && quiz.questions ? JSON.stringify(quiz.questions).replace(/</g, "\\u003c") : '[]' %>;
        
        // WebSocket Initialization with Polling Fallback
        let socket;
        let useWS = true;

        try {
            socket = io({
                transports: ['websocket', 'polling'],
                reconnectionAttempts: 5,
                timeout: 10000
            });

            socket.on('connect', () => {
                console.log('[WS] Connected to server');
                useWS = true;
                socket.emit('join_quiz', { quiz_id: quizId });
            });

            socket.on('connect_error', (err) => {
                console.warn('[WS] Connection failed, using polling fallback:', err.message);
                useWS = false;
            });

            socket.on('update_session', (payload) => {
                console.log('[WS] Received update:', payload);
                sessionsCache[payload.session_id] = payload.data;
                if (payload.paused !== undefined) {
                    isPaused = payload.paused;
                    updatePauseBtn();
                }
                renderTable();
            });

            socket.on('progressive_result_update', (payload) => {
                const sessionId = String(payload && payload.session_id || '');
                const session = sessionsCache[sessionId];
                if (!session) {
                    initialFetch();
                    return;
                }
                const score = Number(payload.total_score);
                const maxScore = Number(payload.max_score);
                if (Number.isFinite(score)) session.score = score;
                if (Number.isFinite(maxScore) && maxScore >= 0) session.max_score = maxScore;
                session.last_active = Date.now();
                if (payload.finalized === true) session.status = 'Completed';
                renderTable();
            });

            socket.on('pause_state', (data) => {
                isPaused = data.paused;
                updatePauseBtn();
            });

            // --- ROOM CLEANUP ON LEAVE ---
            window.addEventListener('beforeunload', () => {
                console.log('[WS] Leaving room:', quizId);
                socket.emit('leave_quiz', { quiz_id: quizId });
            });

        } catch (e) {
            console.error('[WS] Initialization error:', e);
            useWS = false;
        }

        let isPaused = false;
        let sessionsCache = {};

        function escapeHtml(value) {
            return String(value ?? '')
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function plainText(value) {
            return String(value ?? '').replace(/<[^>]*>/g, '').trim();
        }

        function sanitizeQuizHtml(value) {
            const template = document.createElement('template');
            template.innerHTML = String(value ?? '');
            const allowedTags = new Set([
                'BR', 'UL', 'OL', 'LI', 'STRONG', 'B', 'EM', 'I', 'SPAN',
                'DIV', 'P', 'SUB', 'SUP', 'CODE', 'PRE', 'IMG'
            ]);
            const allowedClasses = new Set(['resizable-image-wrapper', 'image-content-box']);

            function cleanNode(node) {
                if (node.nodeType === Node.COMMENT_NODE) {
                    node.remove();
                    return;
                }
                if (node.nodeType !== Node.ELEMENT_NODE) return;
                const element = node;
                if (!allowedTags.has(element.tagName)) {
                    element.replaceWith(document.createTextNode(element.textContent || ''));
                    return;
                }
                const originalClass = element.getAttribute('class') || '';
                const originalSrc = element.getAttribute('src') || '';
                const originalAlt = element.getAttribute('alt') || '';
                for (const attribute of [...element.attributes]) {
                    element.removeAttribute(attribute.name);
                }
                const safeClasses = originalClass
                    .split(/\s+/)
                    .filter(className => allowedClasses.has(className));
                if (safeClasses.length) element.setAttribute('class', safeClasses.join(' '));
                if (element.tagName === 'IMG') {
                    const safeImage = originalSrc.length <= 12000000
                        && (
                            /^data:image\/(?:png|jpe?g|gif|webp);base64,[a-z0-9+/=\s]+$/i.test(originalSrc)
                            || /^https:\/\/kroki\.io\/tikz\/svg\/[a-z0-9_-]+$/i.test(originalSrc)
                        );
                    if (!safeImage) {
                        element.remove();
                        return;
                    }
                    element.setAttribute('src', originalSrc);
                    element.setAttribute('alt', originalAlt.slice(0, 200));
                    element.setAttribute('loading', 'lazy');
                }
                for (const child of [...element.childNodes]) cleanNode(child);
            }

            for (const child of [...template.content.childNodes]) cleanNode(child);
            return template.innerHTML;
        }

        let openDropdowns = new Set();
        function toggleDropdown(sid, isOpen) {
            if (isOpen) openDropdowns.add(sid);
            else openDropdowns.delete(sid);
        }
        
        function togglePause() {
            fetch(`/api/live/${quizId}/toggle_pause`, { method: 'POST' })
            .then(async res => {
                const data = await res.json();
                if (!res.ok) throw new Error(data.error || 'Unable to change pause state');
                return data;
            })
            .then(data => {
                if (data.success) {
                    isPaused = data.paused;
                    updatePauseBtn();
                }
            })
            .catch(error => alert(error.message));
        }

        function terminateQuiz() {
            if (!confirm('Are you sure you want to TERMINATE the quiz? All students will be sent to their results page immediately. This cannot be undone.')) return;
            fetch(`/api/live/${quizId}/terminate`, { method: 'POST' })
                .then(async res => {
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.error || 'Unable to terminate quiz');
                    document.getElementById('terminate-btn').disabled = true;
                })
                .catch(error => alert(error.message));
        }
        
        function updatePauseBtn() {
            const btn = document.getElementById('pause-btn');
            if (!btn) return;
            if (isPaused) {
                btn.innerHTML = '▶️ Resume Timers';
                btn.style.backgroundColor = 'var(--success)';
                btn.style.color = 'white';
            } else {
                btn.innerHTML = '⏸️ Pause Timers';
                btn.style.backgroundColor = 'var(--warning)';
                btn.style.color = 'var(--canvas)';
            }
        }

        function toggleWhiteboard(sid) {
            fetch(`/api/live/${encodeURIComponent(quizId)}/whiteboard/${encodeURIComponent(sid)}/toggle`, { method: 'POST' })
                .then(async res => {
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.error || 'Unable to update whiteboard access');
                    sessionsCache = data.sessions || sessionsCache;
                    renderTable();
                })
                .catch(error => alert(error.message));
        }

        function renderTable() {
            const tbody = document.querySelector('#live-table tbody');
            const data = sessionsCache;

            if (Object.keys(data).length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; color:var(--body); padding:40px; font-size: 12px; text-transform: uppercase; letter-spacing: 1.5px;">No one is taking the quiz right now.</td></tr>';
                return;
            }

            tbody.innerHTML = '';

            const sessions = Object.entries(data)
                .filter(([sid, info]) => sid !== '_meta' && info && typeof info === 'object')
                .sort((a, b) => b[1].last_active - a[1].last_active);

            sessions.forEach(([sid, info]) => {
                // DATA INTEGRITY: Fallback across name and student_name properties
                const studentDisplayName = String(info.name || info.student_name || '').trim();
                if (!studentDisplayName || studentDisplayName === 'undefined') {
                    return; // Skip invalid ghost session
                }

                const tr = document.createElement('tr');
                const statusText = plainText(info.status || 'Active') || 'Active';

                const now = Math.floor(Date.now() / 1000);
                const lastActive = Math.floor((info.last_active || Date.now()) / 1000);
                const diff = now - lastActive;

                let signalColor = 'var(--success)';
                let signalLabel = 'Online';

                if (statusText.includes('Completed') || statusText.includes('Finished') || statusText.includes('Terminated')) {
                    signalLabel = 'Finished';
                    signalColor = 'var(--body)';
                } else if (diff > 30) {
                    signalColor = 'var(--m-red)';
                    signalLabel = 'Offline';
                } else if (diff > 10) {
                    signalColor = 'var(--warning)';
                    signalLabel = 'Unstable';
                }

                const signalHtml = `
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span style="width: 8px; height: 8px; border-radius: 50%; background: ${signalColor}; display: inline-block;"></span>
                        <span style="font-size: 10px; font-weight: 800; color: ${signalColor}; text-transform: uppercase;">${signalLabel}</span>
                    </div>
                `;

                let statusColor = 'var(--warning)';
                if (statusText.includes('Completed') || statusText.includes('Finished')) statusColor = 'var(--success)';
                if (statusText.includes('Abandoned') || statusText.includes('Switched') || statusText.includes('Terminated')) statusColor = 'var(--m-red)';
                let statusHtml = `<span style="color: ${statusColor}; font-weight: 700; text-transform: uppercase; letter-spacing: 1px; font-size: 12px;">${escapeHtml(statusText)}</span>`;

                const qNum = parseInt(info.current_q || info.current_question) || 1;
                const displayedQ = Math.max(1, Math.min(qNum, totalQ || 1));
                let qIndex = displayedQ - 1;

                if (statusText.includes('Completed')) qIndex = Math.max(0, totalQ - 1);

                const currentQData = quizQuestions[qIndex] || {};
                let rawQuestionHTML = currentQData.question || (statusText.includes('Completed') ? 'Finished' : 'Active');
                let optionsList = currentQData.options || [];
                const safeQuestionHTML = sanitizeQuizHtml(rawQuestionHTML);
                let optionsHTML = Array.isArray(optionsList)
                    ? optionsList.map(opt => `<li style="margin-bottom: 6px;">${sanitizeQuizHtml(opt)}</li>`).join('')
                    : '';

                let cleanText = plainText(rawQuestionHTML);
                let snippet = cleanText.length > 50 ? cleanText.substring(0, 50) + '...' : cleanText;
                let snippetHtml = escapeHtml(snippet);

                if (statusText.includes('Completed')) snippetHtml = '<i data-lucide="party-popper" class="icon-sm"></i> Student has finished the quiz!';
                else if (statusText.includes('Abandoned')) snippetHtml = '<i data-lucide="x-circle" class="icon-sm"></i> Student left the quiz early.';

                let detailsHtml = '';
                if (!statusText.includes('Completed') && quizQuestions[qIndex]) {
                    let isOpen = openDropdowns.has(sid) ? 'open' : '';
                    detailsHtml = `
                        <details ${isOpen}>
                            <summary class="question-preview" style="font-family: inherit; font-size: 14px; white-space: pre-wrap; overflow: hidden; text-overflow: ellipsis; display: block;" title="Click to expand">${snippetHtml}</summary>
                            <div class="full-question-box" style="white-space: pre-wrap; margin-top: 10px; padding: 12px; background: var(--surface-soft); border-radius: 8px;">
                                <div style="margin-bottom: 12px; font-weight: 600; line-height: 1.5;">${safeQuestionHTML}</div>
                                <ul style="margin: 0; padding-left: 20px; color: var(--body); line-height: 1.4;">
                                    ${optionsHTML}
                                </ul>
                            </div>
                        </details>
                    `;
                } else {
                    detailsHtml = `<div class="question-preview" style="font-family: inherit; font-size: 14px; white-space: pre-wrap;" title="${escapeHtml(cleanText)}">${snippetHtml}</div>`;
                }

                const wbDisabled = info.whiteboard_disabled || false;
                const wbBtnText = wbDisabled ? '<i data-lucide="check-circle" class="icon-sm"></i> Enable WB' : '<i data-lucide="slash" class="icon-sm"></i> Disable WB';
                const wbBtnColor = wbDisabled ? 'var(--success)' : 'var(--m-red)';
                const wbStatusHtml = `
                    <button class="score-badge wb-session-toggle" style="background: ${wbBtnColor}; color: white; border: none; cursor: pointer; padding: 4px 8px; font-size: 11px;">
                        ${wbBtnText}
                    </button>
                `;

                const tabSwitchBadge = (info.tab_switch_count && info.tab_switch_count > 0)
                    ? `<span style="display: inline-block; margin-left: 6px; padding: 2px 6px; font-size: 10px; font-weight: 700; border-radius: 4px; background: rgba(239, 68, 68, 0.15); color: var(--m-red); border: 1px solid var(--m-red);" title="Student switched tabs ${info.tab_switch_count} times">⚠️ ${info.tab_switch_count} switch${info.tab_switch_count === 1 ? '' : 'es'}</span>`
                    : '';

                tr.innerHTML = `
                    <td style="font-weight: 700; font-size: 16px; color: var(--on-dark);">${escapeHtml(studentDisplayName)}${tabSwitchBadge}</td>
                    <td>${signalHtml}</td>
                    <td style="color: var(--body); font-weight: 600;">Q ${displayedQ} of ${totalQ}</td>
                    <td style="max-width: 350px;">${detailsHtml}</td>
                    <td>${wbStatusHtml}</td>
                    <td><span class="score-badge">${parseFloat(info.score || 0).toFixed(2)} / ${parseFloat(info.max_score || totalQ || 0).toFixed(2)} PTS</span></td>
                    <td>${statusHtml}</td>
                `;
                const detailsElement = tr.querySelector('details');
                if (detailsElement) {
                    detailsElement.addEventListener('toggle', () => toggleDropdown(sid, detailsElement.open));
                }
                const whiteboardButton = tr.querySelector('.wb-session-toggle');
                if (whiteboardButton) {
                    whiteboardButton.addEventListener('click', () => toggleWhiteboard(sid));
                }
                tbody.appendChild(tr);
            });

            if (window.MathJax) {
                MathJax.typesetPromise([tbody]).catch(err => console.error(err));
            }
            window.refreshQuizmokoIcons();
        }

        function initialFetch() {
            fetch('/api/live/' + quizId)
            .then(async res => {
                const response = await res.json();
                if (!res.ok) throw new Error(response.error || 'Unable to load live sessions');
                return response;
            })
            .then(response => {
                if(response.paused !== undefined) {
                    isPaused = response.paused;
                    updatePauseBtn();
                }
                sessionsCache = response.sessions || response;
                renderTable();
            })
            .catch(error => console.warn('[LIVE] Polling failed:', error.message));
        }
        
        initialFetch();
        // Authenticated polling remains authoritative for the roster. Socket rooms
        // only carry pause/termination signals and never expose the full class list.
        setInterval(initialFetch, 2000);
    </script>
    <script>window.refreshQuizmokoIcons();</script>
</body>
</html>
