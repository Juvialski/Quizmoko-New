        </div>
        <div class="right-panel" id="right-panel">
            <div class="wb-toolbar">
                <button class="wb-btn active" data-tool='draw' onclick="setTool('draw')"><i data-lucide="edit-2" class="icon-sm"></i>️ Draw</button>
                <button class="wb-btn" data-tool='erase' onclick="setTool('erase')"><i data-lucide="eraser" class="icon-sm"></i> Eraser</button>
                <button class="wb-btn" data-tool='line' onclick="setTool('line')"><i data-lucide="ruler" class="icon-sm"></i> Line</button>
                <button class="wb-btn" data-tool='rect' onclick="setTool('rect')">⬜ Rect</button>
                <button class="wb-btn" data-tool='circle' onclick="setTool('circle')">⭕ Circle</button>
