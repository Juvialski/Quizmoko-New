    </div>

    <script>
        const quizId = '<%= typeof quiz_id !== 'undefined' ? quiz_id : '' %>';
        const quizData = <%- JSON.stringify(quiz).replace(/</g, "\\u003c") %>;
        if (quizData) {
            const rawMode = String(quizData.quiz_mode || quizData.quizMode || 'back_and_forth').toLowerCase().trim().replace(/[\s-]+/g, '_');
            quizData.quiz_mode = (rawMode === 'sequential') ? 'sequential' : 'back_and_forth';
        }

        function applyPauseState(paused) {
            const nextPaused = !!paused;
            if (nextPaused === isPaused) return;
            isPaused = nextPaused;
            if (isPaused && !pauseStartTime) {
                pauseStartTime = Date.now();
            } else if (!isPaused && pauseStartTime) {
                totalPausedTime += Math.round((Date.now() - pauseStartTime) / 1000);
                pauseStartTime = null;
            }
            updatePauseUI();
        }

        // WebSocket Initialization with Polling Fallback
        let socket;
        let useWS = true;

        try {
            socket = io({
                transports: ['websocket', 'polling'],
                reconnectionAttempts: 5,
                timeout: 10000
            });

            socket.on('connect', () => {
                console.log('[WS] Connected to server');
                useWS = true;
                socket.emit('join_quiz', { quiz_id: quizId });
            });

            socket.on('connect_error', (err) => {
                console.warn('[WS] Connection failed, falling back to HTTP polling:', err.message);
                useWS = false;
            });

            socket.on('pause_state', (data) => {
                applyPauseState(data.paused);
            });

            socket.on('ping_ack', (data) => {
                if (data.paused !== undefined) {
                    applyPauseState(data.paused);
                }
                if (data.terminated && quizStartTime && !isSubmitting) {
                    console.log('[WS Ping Ack] Teacher terminated the session.');
                    submitQuiz('terminated');
                }
                if (data.whiteboard_disabled !== undefined) {
                    whiteboardDisabledByTeacher = !!data.whiteboard_disabled;
                    updateWhiteboardLayout();
                }
            });

            socket.on('terminate', (data) => {
                if (data.terminated && quizStartTime && !isSubmitting) {
                    console.log('[WS] Teacher terminated the session.');
                    submitQuiz('terminated');
                }
            });

            socket.on('update_session', (payload) => {
                // Only listen to updates for OUR session_id
                if (payload.session_id === sessionId) {
                    whiteboardDisabledByTeacher = !!payload.data.whiteboard_disabled;
                    updateWhiteboardLayout(); // FORCE UPDATE LAYOUT

                    // Sync time with server authority
                    if (payload.time_remaining !== undefined && payload.time_remaining > 0) {
                        const diff = Math.abs(timeRemaining - payload.time_remaining);
                        if (diff > 5) {
                            console.log(`[WS] Time Sync: ${timeRemaining} -> ${payload.time_remaining}`);
                            timeRemaining = payload.time_remaining;
                        }
                    }
                }
            });
        } catch (e) {
            console.error('[WS] Initialization error:', e);
            useWS = false;
        }

        function createQuizSessionId() {
            if (window.crypto && typeof window.crypto.randomUUID === 'function') {
                return 'sess_' + window.crypto.randomUUID();
            }
            if (window.crypto && typeof window.crypto.getRandomValues === 'function') {
                const bytes = new Uint8Array(16);
                window.crypto.getRandomValues(bytes);
                return 'sess_' + Array.from(bytes, byte => byte.toString(16).padStart(2, '0')).join('');
            }
            return 'sess_' + Date.now().toString(36) + '_' + Math.random().toString(36).slice(2, 15);
        }

        let sessionId = createQuizSessionId();
        let currentIndex = 0, timeRemaining = 0, timerInterval, answers = {}, solutionSnapshots = {}, studentName = 'Anonymous', currentSelectedOption = null, isPaused = false, pingInterval, isSubmitting = false;
        let whiteboardDisabledByTeacher = false;
        let studentWhiteboardPreference = true; // DEFAULT TO SHOWN
        let isWhiteboardDirty = false; // TRACK IF WHITEBOARD WAS CHANGED

        // Performance metrics
        let quizStartTime = null;
        let totalPausedTime = 0; // seconds
        let pauseStartTime = null;

        function getCurrentTimeMetrics() {
            const now = Date.now();
            const totalDuration = quizStartTime ? Math.round((now - quizStartTime) / 1000) : 0;
            let finalPausedTime = totalPausedTime;
            if (pauseStartTime) {
                finalPausedTime += Math.round((now - pauseStartTime) / 1000);
            }
            const timeActive = Math.max(0, totalDuration - finalPausedTime);
            const maxScore = maximumQuizScore();
            const accuracyPct = maxScore > 0 ? (totalScore / maxScore) * 100 : 0;
            return { timeActive, finalPausedTime, totalDuration, accuracyPct };
        }

        let currentPageIndex = 0, questionPages = {};
        let canvas, ctx, isDrawing = false, startX, startY, currentTool = 'draw', currentStroke = null;
        let isDraggingText = false, isResizingText = false;
        let whiteboardInitialized = false; // FLAG TO PREVENT MULTIPLE INITS
        let progressiveResults = [];
        let totalScore = 0;
        let isGrading = false; // Guard for confirm button
        let pendingGradings = 0; // Derived from pendingGradingTokens; never decremented directly.
        let resultId = null;
        let resultAccessToken = null;
        let answerRevisions = {};
        let answerDigests = {};
        let snapshotDigests = {};
        let sessionRevision = 0;
        let whiteboardDirtyQuestions = {};
        let gradingRequestSequence = 0;
        let progressiveSaveChain = Promise.resolve();
        let progressiveSaveDebounce = null;
        let lastSubmissionStatus = 'completed';
        const gradingRequests = new Map();
        const pendingGradingTokens = new Set();
        const snapshotCaptureTimers = new Map();
        const MAX_ATTEMPT_SNAPSHOT_CHARS = 10 * 1024 * 1024;

        const STORAGE_KEY = `quiz_state_${quizId}`;

        function stableDigestValue(value, depth = 0) {
            if (depth > 20) return '[MAX_DEPTH]';
            if (value === null || value === undefined) return null;
            if (typeof value === 'string' || typeof value === 'boolean') return value;
            if (typeof value === 'number') return Number.isFinite(value) ? value : String(value);
            if (Array.isArray(value)) return value.map(item => stableDigestValue(item, depth + 1));
            if (typeof value === 'object') {
                const normalized = {};
                Object.keys(value).sort().forEach(key => {
                    normalized[key] = stableDigestValue(value[key], depth + 1);
                });
                return normalized;
            }
            return String(value);
        }

        async function stableSha256Digest(value) {
            if (!window.crypto || !window.crypto.subtle) {
                throw new Error('Secure SHA-256 support is required to grade this quiz.');
            }
            const serialized = JSON.stringify(stableDigestValue(value));
            const digestBuffer = await window.crypto.subtle.digest(
                'SHA-256',
                new TextEncoder().encode(serialized)
            );
            let binary = '';
            new Uint8Array(digestBuffer).forEach(byte => { binary += String.fromCharCode(byte); });
            return window.btoa(binary)
                .replace(/\+/g, '-')
                .replace(/\//g, '_')
                .replace(/=+$/g, '');
        }

        function sanitizeAnswerForServer(value) {
            if (value === null || value === undefined) return value;
            if (typeof value === 'string') return value.slice(0, 50000);
            if (typeof value === 'number') return Number.isFinite(value) ? value : '';
            if (typeof value === 'boolean') return value;
            if (Array.isArray(value)) {
                return value.slice(0, 100).map(item => (
                    typeof item === 'string' ? item.slice(0, 2000) : sanitizeAnswerForServer(item)
                ));
            }
            return String(value).slice(0, 50000);
        }

        function snapshotCharsPerQuestion() {
            const questionCount = quizData && Array.isArray(quizData.questions)
                ? Math.max(1, quizData.questions.length)
                : 1;
            // Full-attempt persistence has a 10 MB aggregate limit. Giving every
            // question a stable share keeps individual and final proof identities equal.
            return Math.max(1, Math.floor(MAX_ATTEMPT_SNAPSHOT_CHARS / questionCount));
        }

        function sanitizeSnapshotsForServer(value, maxAggregateChars = snapshotCharsPerQuestion()) {
            if (!Array.isArray(value)) return [];
            const snapshots = [];
            let aggregateChars = 0;
            const boundedLimit = Number.isFinite(Number(maxAggregateChars))
                ? Math.max(1, Math.min(MAX_ATTEMPT_SNAPSHOT_CHARS, Number(maxAggregateChars)))
                : snapshotCharsPerQuestion();
            for (const snapshot of value.slice(0, 5)) {
                if (typeof snapshot !== 'string'
                    || !/^data:image\/(?:png|jpe?g|gif|webp);base64,[a-z0-9+/=\s]+$/i.test(snapshot)
                    || aggregateChars + snapshot.length > boundedLimit) {
                    continue;
                }
                snapshots.push(snapshot);
                aggregateChars += snapshot.length;
            }
            return snapshots;
        }

        function questionPoints(index) {
            const points = Number(quizData.questions[index] && quizData.questions[index].points);
            return Number.isFinite(points) && points > 0 ? points : 1;
        }

        function supportsAiFeedback(question) {
            if (!question || typeof question !== 'object') return false;
            const type = String(question.type || question.question_type || '')
                .trim()
                .toLowerCase()
                .replace(/[\s-]+/g, '_');
            if (type !== 'open_ended' && type !== 'graphing') return false;
            const gradingMode = String(question.grading_mode || question.gradingMode || '')
                .trim()
                .toLowerCase();
            return gradingMode !== 'deterministic' && gradingMode !== 'exact';
        }

        function maximumQuizScore() {
            return quizData.questions.reduce((sum, _question, index) => sum + questionPoints(index), 0);
        }

        function isAuthoritativelyGraded(result) {
            if (!result || result.grade_status !== 'graded') return false;
            const scoreFraction = Number(result.score_fraction);
            return Number.isFinite(scoreFraction) && scoreFraction >= 0 && scoreFraction <= 1;
        }

        function recalculateLiveScore() {
            totalScore = progressiveResults.reduce((sum, result, index) => {
                if (!isAuthoritativelyGraded(result)) return sum;
                const earned = Number(result.earned_points);
                return sum + (Number.isFinite(earned)
                    ? earned
                    : questionPoints(index) * Number(result.score_fraction));
            }, 0);
            const liveScoreElem = document.getElementById('live-score');
            if (liveScoreElem) liveScoreElem.innerText = totalScore.toFixed(2);
            return totalScore;
        }

        function syncPendingGradingCount() {
            pendingGradings = pendingGradingTokens.size;
        }

        function beginPendingGrading(qIndex, revision) {
            const token = `${qIndex}:${revision}:${++gradingRequestSequence}`;
            pendingGradingTokens.add(token);
            syncPendingGradingCount();
            return token;
        }

        function settlePendingGrading(token) {
            if (token && pendingGradingTokens.delete(token)) syncPendingGradingCount();
        }

        function abortQuestionGrading(qIndex) {
            const request = gradingRequests.get(qIndex);
            if (!request) return;
            gradingRequests.delete(qIndex);
            settlePendingGrading(request.pendingToken);
            request.controller.abort();
        }

        function currentAnswerRevision(qIndex) {
            const revision = Number(answerRevisions[qIndex]);
            return Number.isInteger(revision) && revision >= 0 ? revision : 0;
        }

        function invalidateQuestionGrade(qIndex, snapshotsChanged = false) {
            abortQuestionGrading(qIndex);
            answerRevisions[qIndex] = currentAnswerRevision(qIndex) + 1;
            answerDigests[qIndex] = null;
            if (snapshotsChanged) {
                delete solutionSnapshots[qIndex];
                snapshotDigests[qIndex] = null;
                whiteboardDirtyQuestions[qIndex] = true;
                isWhiteboardDirty = true;
            }
            progressiveResults[qIndex] = {
                question: quizData.questions[qIndex] ? quizData.questions[qIndex].question : '',
                type: quizData.questions[qIndex] ? quizData.questions[qIndex].type : '',
                user_answer: Object.prototype.hasOwnProperty.call(answers, qIndex) ? answers[qIndex] : '',
                grade_status: 'pending',
                retryable: false,
                answer_revision: answerRevisions[qIndex]
            };
            recalculateLiveScore();
            const feedbackCont = document.getElementById('instant-feedback');
            if (qIndex === currentIndex
                && quizData.quiz_mode !== 'back_and_forth'
                && feedbackCont
                && feedbackCont.style.display !== 'none') {
                renderInstantFeedbackResult(progressiveResults[qIndex], qIndex >= quizData.questions.length - 1);
            }
            saveQuizState();
            scheduleProgressiveSave();
            updateQuestionJumpButtons();
        }

        function commitAnswerChange(qIndex, value) {
            value = sanitizeAnswerForServer(value);
            const previous = Object.prototype.hasOwnProperty.call(answers, qIndex) ? answers[qIndex] : '';
            if (JSON.stringify(stableDigestValue(previous)) === JSON.stringify(stableDigestValue(value))) return false;
            answers[qIndex] = value;
            if (qIndex === currentIndex) currentSelectedOption = value;
            invalidateQuestionGrade(qIndex, false);
            return true;
        }

        function commitWhiteboardChange(qIndex) {
            invalidateQuestionGrade(qIndex, true);
            scheduleSnapshotCapture(qIndex);
        }

        function saveQuizState() {
            if (isSubmitting) return;
            const state = {
                studentName: studentName || 'Anonymous',
                currentIndex: parseInt(currentIndex) || 0,
                answers, questionPages,
                totalScore: parseFloat(totalScore) || 0,
                progressiveResults, sessionId,
                answerRevisions, answerDigests, snapshotDigests, sessionRevision,
                timeRemaining: parseInt(timeRemaining) || 0,
                studentWhiteboardPreference, // PERSIST STUDENT PREFERENCE
                isWhiteboardDirty, whiteboardDirtyQuestions, quizStartTime, totalPausedTime
            };
            try {
                // PNG snapshots stay in memory; persisting base64 canvases regularly
                // exceeded browser storage quotas and could abort answer submission.
                localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
            } catch (error) {
                console.warn('[QUIZ] Could not persist local quiz state:', error);
            }
        }

        async function buildProgressivePayload(saveRevision) {
            const answersSnapshot = stableDigestValue(Object.fromEntries(
                quizData.questions.map((_question, index) => [
                    index,
                    Object.prototype.hasOwnProperty.call(answers, index)
                        ? sanitizeAnswerForServer(answers[index])
                        : 'No Answer'
                ])
            ));
            const completeSnapshots = {};
            quizData.questions.forEach((_question, index) => {
                if (!Array.isArray(solutionSnapshots[index])
                    && Array.isArray(questionPages[index])
                    && questionPages[index].some(questionPageHasContent)) {
                    solutionSnapshots[index] = renderQuestionSnapshots(index);
                }
                if (Array.isArray(solutionSnapshots[index])) {
                    completeSnapshots[index] = sanitizeSnapshotsForServer(solutionSnapshots[index]);
                }
            });
            const snapshotsSnapshot = stableDigestValue(completeSnapshots);
            const revisionsSnapshot = stableDigestValue(Object.fromEntries(
                quizData.questions.map((_question, index) => [index, currentAnswerRevision(index)])
            ));
            const resultsSnapshot = stableDigestValue(progressiveResults);
            const answerDigestEntries = await Promise.all(quizData.questions.map(async (_question, index) => {
                const answer = Object.prototype.hasOwnProperty.call(answersSnapshot, index) ? answersSnapshot[index] : 'No Answer';
                return [index, await stableSha256Digest(answer)];
            }));
            const snapshotDigestEntries = await Promise.all(quizData.questions.map(async (_question, index) => {
                if (Object.prototype.hasOwnProperty.call(snapshotsSnapshot, index)) {
                    const snapshots = Array.isArray(snapshotsSnapshot[index]) ? snapshotsSnapshot[index] : [];
                    return [index, await stableSha256Digest(snapshots)];
                }
                return typeof snapshotDigests[index] === 'string' && snapshotDigests[index]
                    ? [index, snapshotDigests[index]]
                    : null;
            }));
            const payloadAnswerDigests = Object.fromEntries(answerDigestEntries);
            const payloadSnapshotDigests = Object.fromEntries(snapshotDigestEntries.filter(Boolean));

            quizData.questions.forEach((_question, index) => {
                if (currentAnswerRevision(index) === Number(revisionsSnapshot[index] || 0)) {
                    answerDigests[index] = payloadAnswerDigests[index];
                    if (typeof payloadSnapshotDigests[index] === 'string') {
                        snapshotDigests[index] = payloadSnapshotDigests[index];
                    }
                }
            });
            saveQuizState();

            const metrics = getCurrentTimeMetrics();
            return {
                quiz_id: quizId,
                session_id: sessionId,
                student_name: studentName,
                session_revision: saveRevision,
                answers: answersSnapshot,
                answer_revisions: revisionsSnapshot,
                answer_digests: payloadAnswerDigests,
                snapshot_digests: payloadSnapshotDigests,
                progressive_results: Array.isArray(resultsSnapshot) ? resultsSnapshot : [],
                solution_snapshots: snapshotsSnapshot,
                score: recalculateLiveScore(),
                time_active_seconds: metrics.timeActive,
                time_paused_seconds: metrics.finalPausedTime,
                total_duration_seconds: metrics.totalDuration,
                accuracy_pct: maximumQuizScore() > 0 ? (totalScore / maximumQuizScore()) * 100 : 0
            };
        }

        function scheduleProgressiveSave(delay = 250) {
            if (isSubmitting || !studentName || studentName === 'Anonymous' || studentName === 'undefined') return;
            if (progressiveSaveDebounce) clearTimeout(progressiveSaveDebounce);
            progressiveSaveDebounce = setTimeout(() => {
                progressiveSaveDebounce = null;
                void saveProgressToServer().catch(error => {
                    console.warn('[QUIZ] Progressive server save failed:', error);
                });
            }, delay);
        }

        function saveProgressToServer({ force = false } = {}) {
            if (isSubmitting && !force) return Promise.resolve(null);
            if (!studentName || studentName === 'Anonymous' || studentName === 'undefined') {
                return Promise.resolve(null);
            }
            const saveRevision = ++sessionRevision;
            saveQuizState();
            const payloadPromise = buildProgressivePayload(saveRevision);
            const operation = progressiveSaveChain
                .catch(() => undefined)
                .then(async () => {
                    const payload = await payloadPromise;
                    const controller = new AbortController();
                    const timeout = setTimeout(() => controller.abort(), 10000);
                    try {
                        const response = await fetch('/api/save_progressive_result', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            signal: controller.signal,
                            body: JSON.stringify(payload)
                        });
                        const data = await response.json().catch(() => ({}));
                        if (!response.ok || data.success === false) {
                            throw new Error(data.error || `Progress save failed (HTTP ${response.status})`);
                        }
                        const acknowledgedRevision = Number(data.current_session_revision ?? data.session_revision);
                        if (Number.isInteger(acknowledgedRevision) && acknowledgedRevision >= 0) {
                            sessionRevision = Math.max(sessionRevision, acknowledgedRevision);
                        }
                        return data;
                    } finally {
                        clearTimeout(timeout);
                    }
                });
            progressiveSaveChain = operation.catch(() => undefined);
            return operation;
        }

        function loadQuizState() {
            const saved = localStorage.getItem(STORAGE_KEY);
            if (!saved) return false;
            try {
                const state = JSON.parse(saved);
                studentName = state.studentName || 'Anonymous';
                currentIndex = Math.max(0, Math.min(parseInt(state.currentIndex) || 0, Math.max(0, quizData.questions.length - 1)));
                const restoredAnswers = state.answers && typeof state.answers === 'object' ? state.answers : {};
                answers = {};
                quizData.questions.forEach((_question, index) => {
                    if (Object.prototype.hasOwnProperty.call(restoredAnswers, index)) {
                        answers[index] = sanitizeAnswerForServer(restoredAnswers[index]);
                    }
                });
                answerRevisions = state.answerRevisions && typeof state.answerRevisions === 'object' ? state.answerRevisions : {};
                answerDigests = state.answerDigests && typeof state.answerDigests === 'object' ? state.answerDigests : {};
                snapshotDigests = state.snapshotDigests && typeof state.snapshotDigests === 'object' ? state.snapshotDigests : {};
                sessionRevision = Number.isInteger(Number(state.sessionRevision)) ? Math.max(0, Number(state.sessionRevision)) : 0;
                const restoredPages = state.questionPages && typeof state.questionPages === 'object' ? state.questionPages : {};
                questionPages = {};
                quizData.questions.forEach((_, index) => {
                    const pages = restoredPages[index];
                    questionPages[index] = Array.isArray(pages) && pages.length > 0
                        ? pages
                        : [{ strokes: [], texts: [] }];
                });
                const restoredResults = Array.isArray(state.progressiveResults) ? state.progressiveResults : [];
                progressiveResults = quizData.questions.map((question, index) => {
                    const result = restoredResults[index];
                    const validStatus = result
                        && ['graded', 'pending', 'retryable_error', 'invalid_response'].includes(result.grade_status)
                        && (result.grade_status !== 'graded' || isAuthoritativelyGraded(result));
                    const validIdentity = validStatus
                        && Number(result.answer_revision) === currentAnswerRevision(index)
                        && typeof result.answer_digest === 'string'
                        && result.answer_digest === answerDigests[index]
                        && typeof result.snapshot_digest === 'string'
                        && result.snapshot_digest === snapshotDigests[index];
                    if (validIdentity) return result;
                    if (!Object.prototype.hasOwnProperty.call(answers, index)) return null;
                    return {
                        question: question.question,
                        type: question.type,
                        user_answer: answers[index],
                        grade_status: 'pending',
                        retryable: false,
                        answer_revision: currentAnswerRevision(index)
                    };
                });
                solutionSnapshots = {};
                if (state.sessionId) sessionId = state.sessionId;
                if (state.timeRemaining !== undefined) timeRemaining = parseInt(state.timeRemaining) || 0;
                if (state.studentWhiteboardPreference !== undefined) studentWhiteboardPreference = state.studentWhiteboardPreference;
                if (state.isWhiteboardDirty !== undefined) isWhiteboardDirty = state.isWhiteboardDirty;
                whiteboardDirtyQuestions = state.whiteboardDirtyQuestions && typeof state.whiteboardDirtyQuestions === 'object'
                    ? state.whiteboardDirtyQuestions
                    : (isWhiteboardDirty ? { [currentIndex]: true } : {});
                if (state.quizStartTime) quizStartTime = state.quizStartTime;
                if (state.totalPausedTime !== undefined) totalPausedTime = parseInt(state.totalPausedTime) || 0;
                recalculateLiveScore();
                console.log(`[QUIZ] Restored state. Pending gradings: ${pendingGradings}`);

                return true;
            } catch (e) { return false; }
        }

        async function loadProgressiveResultFromServer() {
            if (!studentName || studentName === 'Anonymous' || !sessionId) return false;
            const controller = new AbortController();
            const timeout = setTimeout(() => controller.abort(), 8000);
            try {
                const response = await fetch('/api/load_progressive_result', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    signal: controller.signal,
                    body: JSON.stringify({ quiz_id: quizId, session_id: sessionId })
                });
                const data = await response.json().catch(() => ({}));
                if (response.status === 404 || data.found === false) return false;
                if (!response.ok || data.success === false) {
                    throw new Error(data.error || `Progress restore failed (HTTP ${response.status})`);
                }
                if (data.finalized === true) {
                    resultId = data.result_id || null;
                    localStorage.removeItem(STORAGE_KEY);
                    document.getElementById('start-screen').style.display = 'none';
                    document.getElementById('quiz-screen').style.display = 'none';
                    document.getElementById('result-screen').style.display = 'block';
                    document.getElementById('score-text').innerText = 'Quiz already finalized';
                    document.getElementById('save-status-msg').innerText = 'This session is closed. Progressive changes will not be sent.';
                    document.getElementById('pdf-btn').style.display = 'none';
                    return 'finalized';
                }

                const progress = data.progress && typeof data.progress === 'object'
                    ? data.progress
                    : (data.result && typeof data.result === 'object' ? data.result : data);
                const remoteAnswers = progress.answers && typeof progress.answers === 'object' ? progress.answers : {};
                const remoteRevisions = progress.answer_revisions && typeof progress.answer_revisions === 'object' ? progress.answer_revisions : {};
                const remoteAnswerDigests = progress.answer_digests && typeof progress.answer_digests === 'object' ? progress.answer_digests : {};
                const remoteSnapshotDigests = progress.snapshot_digests && typeof progress.snapshot_digests === 'object' ? progress.snapshot_digests : {};
                const remoteSnapshots = progress.solution_snapshots && typeof progress.solution_snapshots === 'object' ? progress.solution_snapshots : {};
                const remoteDetails = Array.isArray(progress.progressive_results)
                    ? progress.progressive_results
                    : (Array.isArray(progress.graded_details) ? progress.graded_details : []);

                for (let index = 0; index < quizData.questions.length; index++) {
                    const remoteRevision = Number(remoteRevisions[index]);
                    if (!Number.isInteger(remoteRevision) || remoteRevision < 0) continue;
                    const localRevision = currentAnswerRevision(index);
                    if (remoteRevision < localRevision) continue;
                    if (remoteRevision === localRevision && whiteboardDirtyQuestions[index]) continue;

                    const candidate = remoteDetails[index] && typeof remoteDetails[index] === 'object'
                        ? remoteDetails[index]
                        : null;
                    const remoteHasAnswer = Object.prototype.hasOwnProperty.call(remoteAnswers, index);
                    const answer = sanitizeAnswerForServer(remoteHasAnswer
                        ? remoteAnswers[index]
                        : (candidate && Object.prototype.hasOwnProperty.call(candidate, 'user_answer') ? candidate.user_answer : ''));
                    const snapshots = sanitizeSnapshotsForServer(remoteSnapshots[index]);
                    const [computedAnswerDigest, computedSnapshotDigest] = await Promise.all([
                        stableSha256Digest(answer),
                        stableSha256Digest(snapshots)
                    ]);

                    const untouchedQuestion = remoteRevision === 0
                        && answer === 'No Answer'
                        && snapshots.length === 0;
                    if (untouchedQuestion) {
                        delete answers[index];
                        answerRevisions[index] = 0;
                        answerDigests[index] = computedAnswerDigest;
                        snapshotDigests[index] = computedSnapshotDigest;
                        solutionSnapshots[index] = [];
                        progressiveResults[index] = null;
                        whiteboardDirtyQuestions[index] = false;
                        continue;
                    }

                    answers[index] = answer;
                    answerRevisions[index] = remoteRevision;
                    answerDigests[index] = computedAnswerDigest;
                    snapshotDigests[index] = computedSnapshotDigest;
                    solutionSnapshots[index] = snapshots;
                    whiteboardDirtyQuestions[index] = false;

                    const candidateStatusIsValid = candidate
                        && ['graded', 'pending', 'retryable_error', 'invalid_response'].includes(candidate.grade_status)
                        && (candidate.grade_status !== 'graded' || isAuthoritativelyGraded(candidate));
                    const identityMatches = candidateStatusIsValid
                        && Number(candidate.answer_revision) === remoteRevision
                        && candidate.answer_digest === computedAnswerDigest
                        && candidate.snapshot_digest === computedSnapshotDigest
                        && (!remoteAnswerDigests[index] || remoteAnswerDigests[index] === computedAnswerDigest)
                        && (!remoteSnapshotDigests[index] || remoteSnapshotDigests[index] === computedSnapshotDigest);
                    if (identityMatches) {
                        progressiveResults[index] = { ...candidate, user_answer: answer };
                    } else {
                        progressiveResults[index] = {
                            question: quizData.questions[index].question,
                            type: quizData.questions[index].type,
                            user_answer: answer,
                            grade_status: 'pending',
                            retryable: false,
                            answer_revision: remoteRevision,
                            answer_digest: computedAnswerDigest,
                            snapshot_digest: computedSnapshotDigest
                        };
                    }
                }

                const remoteSessionRevision = Number(progress.session_revision);
                if (Number.isInteger(remoteSessionRevision) && remoteSessionRevision >= 0) {
                    sessionRevision = Math.max(sessionRevision, remoteSessionRevision);
                }
                recalculateLiveScore();
                saveQuizState();
                return true;
            } catch (error) {
                if (error && error.name !== 'AbortError') {
                    console.warn('[QUIZ] Could not restore server progress:', error);
                }
                return false;
            } finally {
                clearTimeout(timeout);
            }
        }

        function resumePendingGradings() {
            const pendingIndexes = [];
            quizData.questions.forEach((_question, index) => {
                const hasAnswer = Object.prototype.hasOwnProperty.call(answers, index) && String(answers[index] ?? '').length > 0;
                const hasSnapshots = Array.isArray(solutionSnapshots[index]) && solutionSnapshots[index].length > 0;
                const result = progressiveResults[index];
                if ((hasAnswer || hasSnapshots) && (!result || result.grade_status === 'pending')) {
                    pendingIndexes.push(index);
                }
            });
            const workerCount = Math.min(3, pendingIndexes.length);
            const workers = Array.from({ length: workerCount }, async () => {
                while (pendingIndexes.length > 0) {
                    const index = pendingIndexes.shift();
                    try {
                        await requestQuestionGrade(index);
                    } catch (error) {
                        console.warn(`[QUIZ] Could not resume grading Q${index + 1}:`, error);
                    }
                }
            });
            void Promise.allSettled(workers);
        }

        // --- CRITICAL FIX: Initialize questionPages and progressiveResults immediately ---
        if (quizData && Array.isArray(quizData.questions)) {
            quizData.questions.forEach((_, i) => {
                questionPages[i] = [{ strokes: [], texts: [] }];
                progressiveResults[i] = null; // Prepare slots for background grading
                answerRevisions[i] = 0;
            });
        } else {
            console.error('[QUIZ] Critical Error: quizData.questions is missing or not an array!', quizData);
            // Fallback for UI stability
            quizData.questions = [];
        }

        window.addEventListener('themechanged', updateWhiteboardThemeColors);

        function updateWhiteboardThemeColors() {
            const colorInput = document.getElementById('wb-color');
            if (colorInput && !colorInput.dataset.userChanged) {
                colorInput.value = '#18181b'; // Default to high-contrast dark ink on the white whiteboard
            }
        }

        function adjustFontSize(s) {
            const scaleStr = getComputedStyle(document.documentElement).getPropertyValue('--font-scale').trim();
            const current = scaleStr ? parseFloat(scaleStr) : 1.0;
            const newScale = Math.min(Math.max((isNaN(current) ? 1.0 : current) + s, 0.7), 1.6);
            document.documentElement.style.setProperty('--font-scale', newScale);
        }

        function formatTime(secs) {
            secs = Number.isFinite(Number(secs)) ? Math.max(0, Math.floor(Number(secs))) : 0;
            const m = Math.floor(secs / 60);
            const s = secs % 60;
            return `${m}:${s < 10 ? '0' : ''}${s}`;
        }

        function toggleQuestionCentering() { document.getElementById('question-text').classList.toggle('centered'); }

        function isSafeDisplayImageSource(value) {
            if (typeof value !== 'string' || value.length > 12000000) return false;
            return /^data:image\/(?:png|jpe?g|gif|webp);base64,[a-z0-9+/=\s]+$/i.test(value)
                || /^https:\/\/kroki\.io\/tikz\/svg\/[a-z0-9_-]+$/i.test(value);
        }

        function sanitizeDisplayHtml(value) {
            const template = document.createElement('template');
            template.innerHTML = String(value ?? '');
            const allowedTags = new Set([
                'BR', 'UL', 'OL', 'LI', 'STRONG', 'B', 'EM', 'I', 'SPAN',
                'DIV', 'P', 'SUB', 'SUP', 'CODE', 'PRE', 'IMG'
            ]);
            const allowedClasses = new Set([
                'resizable-image-wrapper', 'image-content-box', 'workings-img'
            ]);

            function cleanNode(node) {
                if (node.nodeType === Node.COMMENT_NODE) {
                    node.remove();
                    return;
                }
                if (node.nodeType !== Node.ELEMENT_NODE) return;

                const element = node;
                if (!allowedTags.has(element.tagName)) {
                    element.replaceWith(document.createTextNode(element.textContent || ''));
                    return;
                }

                const originalClass = element.getAttribute('class') || '';
                const originalWidth = element.style && element.style.width ? element.style.width : '';
                const originalSrc = element.getAttribute('src') || '';
                const originalAlt = element.getAttribute('alt') || '';
                for (const attribute of [...element.attributes]) {
                    element.removeAttribute(attribute.name);
                }

                const safeClasses = originalClass
                    .split(/\s+/)
                    .filter(className => allowedClasses.has(className));
                if (safeClasses.length) element.setAttribute('class', safeClasses.join(' '));
                if (
                    element.tagName === 'DIV'
                    && /^(?:100|[1-9]?\d)(?:%|px)$/.test(originalWidth)
                ) {
                    element.style.width = originalWidth;
                }

                if (element.tagName === 'IMG') {
                    if (!isSafeDisplayImageSource(originalSrc)) {
                        element.remove();
                        return;
                    }
                    element.setAttribute('src', originalSrc);
                    element.setAttribute('alt', originalAlt.slice(0, 200));
                    element.setAttribute('loading', 'lazy');
                    element.setAttribute('decoding', 'async');
                }

                for (const child of [...element.childNodes]) cleanNode(child);
            }

            for (const child of [...template.content.childNodes]) cleanNode(child);
            return template.innerHTML;
        }

        function cleanNewlinesInMath(str) {
            if (!str) return "";
            // Replace newlines inside $$...$$ with spaces
            let cleaned = str.replace(/\$\$([\s\S]*?)\$\$/g, (match, mathContent) => {
                return '$$' + mathContent.replace(/\r?\n/g, ' ') + '$$';
            });
            // Replace newlines inside $...$ with spaces
            cleaned = cleaned.replace(/\$([\s\S]*?)\$/g, (match, mathContent) => {
                return '$' + mathContent.replace(/\r?\n/g, ' ') + '$';
            });
            return cleaned;
        }

        function formatText(t) {
            if (t === null || t === undefined) return '';

            // 1. Unpack JSON Objects/Lists (if any)
            let data = t;
            if (typeof t === 'string' && (t.trim().startsWith('{') || t.trim().startsWith('['))) {
                try {
                    let jsonStr = t.replace(/'/g, '"');
                    data = JSON.parse(jsonStr);
                } catch(e) {}
            }

            if (typeof data === 'object' && data !== null) {
                if (Array.isArray(data)) {
                    return sanitizeDisplayHtml('<ul>' +
                           data.map(v => `<li>${formatText(v)}</li>`).join('') +
                           '</ul>');
                }
                let html = '<ul>';
                for (const [k, v] of Object.entries(data)) {
                    html += `<li><strong>${k.charAt(0).toUpperCase() + k.slice(1)}:</strong> ${formatText(v)}</li>`;
                }
                return sanitizeDisplayHtml(html + '</ul>');
            }

            // 2. Standard Text Formatting
            let str = String(data);
            if (window.QuizMoKoMath) str = window.QuizMoKoMath.normalizeLatexText(str);
            str = cleanNewlinesInMath(str);

            // --- NEW: RENDER MANUALLY ENTERED TIKZ ---
            str = str.replace(/\[TIKZ\]([\s\S]*?)\[\/TIKZ\]/gi, (match, code) => {
                const cleanCode = code.replace(/```tikz/g, '').replace(/```/g, '').trim();
                const sanitizedCode = cleanCode.replace(/\\documentclass(?:\[.*?\])?\{.*?\}/g, '')
                                             .replace(/\\usepackage(?:\[.*?\])?\{.*?\}/g, '')
                                             .replace(/\\begin\{document\}/g, '')
                                             .replace(/\\end\{document\}/g, '').trim();

                const tikzEnv = sanitizedCode.includes('\\begin{tikzpicture}') ? sanitizedCode : `\\begin{tikzpicture}\n${sanitizedCode}\n\\end{tikzpicture}`;
                const fullLatex = `\\documentclass[tikz,border=10mm]{standalone}\n\\usepackage{amsmath}\n\\usepackage{amssymb}\n\\begin{document}\n${tikzEnv}\n\\end{document}`;

                const dataData = new TextEncoder().encode(fullLatex);
                const compressed = pako.deflate(dataData, { level: 9 });
                let binary = '';
                for (let i = 0; i < compressed.byteLength; i++) { binary += String.fromCharCode(compressed[i]); }
                const b64 = window.btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');
                const imgUrl = `https://kroki.io/tikz/svg/${b64}`;
                return `<div class="resizable-image-wrapper"><div class="image-content-box" style="width: 100%;"><img src="${imgUrl}" alt='Math Diagram'></div></div>`;
            });

            const formatted = str.split(/(<div class="resizable-image-wrapper"[\s\S]*?<\/div>)/gi).map(p => {
                if (p.startsWith('<div')) return p;

                // Process bullets and line breaks
                const lines = p.split(/\r?\n/);
                return lines.map(line => {
                    const trimmedLine = line.trim();
                    if (trimmedLine.startsWith('- ') || trimmedLine.startsWith('* ') || trimmedLine.startsWith('• ')) {
                        const bulletChar = trimmedLine.startsWith('• ') ? '' : '• ';
                        return `${bulletChar}${trimmedLine.substring(trimmedLine.indexOf(' ') + 1)}`;
                    }
                    return line;
                }).join('<br>');
            }).join('');
            return sanitizeDisplayHtml(formatted);
        }

        function renderMath(t = 'quiz-screen', attempt = 0) {
            const target = document.getElementById(t);
            if (window.QuizMoKoMath && target) window.QuizMoKoMath.typeset(target, attempt);
        }

        function sendPing(s) {
            // DATA INTEGRITY: Never send background pings for Anonymous students
            // A student only becomes non-anonymous after clicking 'Start Quiz'
            if ((!studentName || studentName === 'Anonymous' || studentName === 'undefined') && s !== 'Started') {
                return;
            }

            const payload = {
                quiz_id: quizId,
                session_id: sessionId,
                student_name: studentName,
                current_q: (parseInt(currentIndex) || 0) + 1,
                score: parseFloat(totalScore) || 0,
                status: s,
                time_remaining: Math.max(0, parseInt(timeRemaining) || 0)
            };

            if (useWS && socket && socket.connected) {
                console.log(`[WS] Sending Ping: ${s}`);
                socket.emit('ping', payload);
            } else {
                console.log(`[HTTP] Sending Ping Fallback: ${s}`);
                fetch('/ping', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                })
                .then(r => r.json())
                .then(d => {
                    if (d.error) return;
                    applyPauseState(d.paused);
                    whiteboardDisabledByTeacher = !!d.whiteboard_disabled;
                    updateWhiteboardLayout(); // FORCE UPDATE LAYOUT
                    if (!!d.terminated && quizStartTime && !isSubmitting) submitQuiz('terminated');
                    if (d.time_remaining !== undefined && d.time_remaining > 0) {
                         const diff = Math.abs(timeRemaining - d.time_remaining);
                         if (diff > 5) timeRemaining = d.time_remaining;
                    }
                })
                .catch(e => console.warn('[HTTP] Ping fallback failed:', e));
            }
        }

        function beginQuiz() {
            try {
                if (!Array.isArray(quizData.questions) || quizData.questions.length === 0) {
                    return alert('This quiz has no questions yet. Please ask the teacher to add at least one question.');
                }
                const n = document.getElementById('student-name').value.trim();
                if(!n) return alert('Enter name!');
                studentName = n;
                console.log('[QUIZ] Starting Quiz...');
                quizStartTime = Date.now();
                sendPing('Started');
                saveQuizState();
                startQuizUI();
            } catch (err) {
                console.error('[QUIZ] Fatal error in beginQuiz:', err);
                alert('Failed to start quiz. Error: ' + err.message);
            }
        }

        function toggleWhiteboardVisibility() {
            studentWhiteboardPreference = !studentWhiteboardPreference;
            updateWhiteboardLayout();
            saveQuizState();
        }

        function updateWhiteboardLayout() {
            const btn = document.getElementById('btn-toggle-whiteboard');
            const rightPanel = document.getElementById('right-panel');
            const quizContainer = document.querySelector('.quiz-container');

            if (!btn || !rightPanel || !quizContainer) return;

            // TEACHER OVERRIDE ALWAYS WINS
            if (whiteboardDisabledByTeacher) {
                btn.style.display = 'none';
                rightPanel.style.display = 'none';
                quizContainer.classList.remove('split-mode');
                return;
            }

            // SHOW BUTTON IF TEACHER HAS NOT DISABLED
            btn.style.display = 'inline-flex';

            const q = (quizData && quizData.questions) ? quizData.questions[currentIndex] : null;
            const isGraphing = q && q.type === 'graphing';
            const shouldShow = studentWhiteboardPreference || isGraphing;

            if (shouldShow) {
                rightPanel.style.display = 'flex';
                quizContainer.classList.add('split-mode');
                btn.innerHTML = '<i data-lucide="eye-off" class="icon-sm"></i> Hide Whiteboard';
                window.refreshQuizmokoIcons?.();
                if (!whiteboardInitialized) {
                    initWhiteboard();
                } else {
                    redrawCanvas();
                    setTimeout(resizeCanvas, 10);
                }
            } else {
                rightPanel.style.display = 'none';
                quizContainer.classList.remove('split-mode');
                btn.innerHTML = '<i data-lucide="pen-tool" class="icon-sm"></i> Show Whiteboard';
                window.refreshQuizmokoIcons?.();
            }
        }

        function startQuizUI() {
            document.getElementById('start-screen').style.display = 'none';
            document.getElementById('quiz-screen').style.display = 'block';

            const bottomRow = document.getElementById('quiz-bottom-row');
            if (bottomRow) bottomRow.style.display = 'flex';

            document.getElementById('q-tracker').style.display = 'inline-flex';

            // HIDE LIVE SCORE in Back-and-Forth Mode to prevent 'brute forcing' answers
            const scoreTracker = document.getElementById('score-tracker');
            if (scoreTracker) {
                scoreTracker.style.display = (quizData.quiz_mode === 'sequential') ? 'inline-flex' : 'none';
            }

            document.getElementById('btn-end-early').style.display = 'inline-flex';

            if (quizData.require_solution) {
                // If quiz requires solution, show it by default initially
                studentWhiteboardPreference = true;
            }

            updateWhiteboardLayout();

            // MODE ISOLATION
            if (quizData.quiz_mode === 'back_and_forth') {
                document.getElementById('btn-confirm').style.display = 'none';
                document.getElementById('bf-nav-controls').style.display = 'flex';
                renderQuestionJumpButtons();

                // Initialize total time if not restored from state AND not synced from server yet
                if (timeRemaining <= 0) {
                    timeRemaining = quizData.questions.length * quizData.time_limit;
                }
            } else {
                document.getElementById('bf-nav-controls').style.display = 'none';
                const questionJumpPanel = document.getElementById('question-jump-panel');
                if (questionJumpPanel) questionJumpPanel.style.display = 'none';
                // Initialize per-question time if not restored
                if (timeRemaining <= 0) {
                    timeRemaining = quizData.time_limit;
                }
            }

            pingInterval = setInterval(() => { if (document.visibilityState !== 'hidden') sendPing('Active'); }, 2000);
            startTimer(); // Start timer here instead of every question
            loadQuestion();
        }

        function hasQuestionResponse(qIndex) {
            const hasAnswer = Object.prototype.hasOwnProperty.call(answers, qIndex)
                && String(answers[qIndex] ?? '').trim().length > 0;
            const pages = Array.isArray(questionPages[qIndex]) ? questionPages[qIndex] : [];
            return hasAnswer || pages.some(questionPageHasContent);
        }

        function renderQuestionJumpButtons() {
            const panel = document.getElementById('question-jump-panel');
            const container = document.getElementById('question-jump-buttons');
            if (!panel || !container) return;

            if (quizData.quiz_mode !== 'back_and_forth') {
                panel.style.display = 'none';
                return;
            }

            panel.style.display = 'block';
            if (container.children.length !== quizData.questions.length) {
                container.innerHTML = '';
                quizData.questions.forEach((_question, index) => {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'question-jump-btn';
                    button.dataset.questionIndex = String(index);
                    button.textContent = String(index + 1);
                    button.onclick = () => jumpToQuestion(index);
                    container.appendChild(button);
                });
            }

            updateQuestionJumpButtons();
            window.refreshQuizmokoIcons?.();
        }

        function updateQuestionJumpButtons() {
            const container = document.getElementById('question-jump-buttons');
            if (!container || quizData.quiz_mode !== 'back_and_forth') return;
            const previousActiveIndex = Number(container.dataset.activeQuestionIndex);

            container.querySelectorAll('.question-jump-btn').forEach(button => {
                const qIndex = Number(button.dataset.questionIndex);
                if (!Number.isInteger(qIndex)) return;

                const isCurrent = qIndex === currentIndex;
                const isAnswered = hasQuestionResponse(qIndex);

                button.classList.toggle('current', isCurrent);
                button.classList.toggle('answered', isAnswered && !isCurrent);

                if (isCurrent) button.setAttribute('aria-current', 'step');
                else button.removeAttribute('aria-current');

                const states = [];
                if (isCurrent) states.push('current');
                if (isAnswered) states.push('answered');
                const stateLabel = states.length > 0 ? `, ${states.join(', ')}` : ', unanswered';
                const label = `Question ${qIndex + 1}${stateLabel}`;
                button.setAttribute('aria-label', label);
                button.title = label;
            });

            if (previousActiveIndex !== currentIndex) {
                container.dataset.activeQuestionIndex = String(currentIndex);
            }
        }

        function goToQuestion(targetIndex) {
            const normalizedTarget = Number(targetIndex);
            if (!Number.isInteger(normalizedTarget) || normalizedTarget < 0) return;
            if (normalizedTarget >= quizData.questions.length) {
                void submitQuiz();
                return;
            }

            currentIndex = normalizedTarget;
            isWhiteboardDirty = !!whiteboardDirtyQuestions[currentIndex];
            saveQuizState();
            loadQuestion();
            sendPing('Navigating');
        }

        function shouldGradeQuestionBeforeNavigation(qIndex) {
            if (gradingRequests.has(qIndex)) return false;
            return !isAuthoritativelyGraded(progressiveResults[qIndex])
                || !!whiteboardDirtyQuestions[qIndex];
        }

        function navigateBackAndForth(targetIndex, triggerButton = null) {
            if (quizData.quiz_mode !== 'back_and_forth' || isGrading) return;
            const normalizedTarget = Number(targetIndex);
            if (!Number.isInteger(normalizedTarget)
                || normalizedTarget < 0
                || normalizedTarget > quizData.questions.length
                || normalizedTarget === currentIndex) return;

            if (shouldGradeQuestionBeforeNavigation(currentIndex)) {
                if (triggerButton) {
                    triggerButton.innerText = '⌛ SAVING...';
                    triggerButton.disabled = true;
                }
                void handleAnswer(currentSelectedOption ?? '', normalizedTarget, triggerButton);
                return;
            }

            goToQuestion(normalizedTarget);
        }

        function jumpToQuestion(targetIndex) {
            navigateBackAndForth(targetIndex);
        }

        function loadQuestion() {
            try {
                if (currentIndex >= quizData.questions.length) return submitQuiz();

                startTimer(); // Ensure timer continues ticking on question load

                // Reset instant feedback & score tracker visibility per mode
                const feedbackCont = document.getElementById('instant-feedback');
                if (feedbackCont) feedbackCont.style.display = 'none';

                const scoreTracker = document.getElementById('score-tracker');
                if (scoreTracker) {
                    scoreTracker.style.display = (quizData.quiz_mode === 'sequential') ? 'inline-flex' : 'none';
                }

                currentSelectedOption = Object.prototype.hasOwnProperty.call(answers, currentIndex)
                    ? answers[currentIndex]
                    : null; // RESTORE PREVIOUS ANSWER

                const btnConfirm = document.getElementById('btn-confirm');
                const bfControls = document.getElementById('bf-nav-controls');
                const btnNext = document.getElementById('btn-next');
                const btnPrev = document.getElementById('btn-prev');

                if (quizData.quiz_mode === 'back_and_forth') {
                    btnConfirm.style.display = 'none';
                    bfControls.style.display = 'flex';
                    btnPrev.innerText = '⬅️ PREVIOUS'; // Ensure text is reset
                    btnPrev.disabled = currentIndex === 0;
                    btnNext.innerHTML = currentIndex === quizData.questions.length - 1 ? '<i data-lucide="flag" class="icon-sm"></i> FINISH & SUBMIT' : 'NEXT / CONFIRM <i data-lucide="arrow-right" class="icon-sm"></i>️';
                    window.refreshQuizmokoIcons?.();
                    btnNext.disabled = false;
                } else {
                    btnConfirm.style.display = 'none';
                    btnConfirm.innerText = 'CONFIRM ANSWER';
                    btnConfirm.disabled = false;
                    bfControls.style.display = 'none';
                }

                document.getElementById('q-num').innerText = currentIndex + 1;
                updateQuestionJumpButtons();
                const q = quizData.questions[currentIndex];

                currentPageIndex = 0;
                if (canvas) {
                    redrawCanvas();
                    updatePageUI();
                }
                updateWhiteboardLayout();

                document.getElementById('question-text').innerHTML = formatText(q.question);
                const opts = document.getElementById('options-container');
                opts.innerHTML = '';

                if (q.type === 'open_ended') {
                    const ta = document.createElement('textarea');
                    ta.placeholder = 'Explain...';
                    ta.maxLength = 50000;
                    ta.value = answers[currentIndex] || ''; // RESTORE ANSWER ON RELOAD
                    ta.oninput = e => {
                        commitAnswerChange(currentIndex, e.target.value);
                        if (quizData.quiz_mode !== 'back_and_forth') {
                            btnConfirm.style.display = e.target.value.trim().length > 0 ? 'inline-flex' : 'none';
                        }
                    };
                    opts.appendChild(ta);
                    ta.focus();
                } else if (q.type === 'identification' || q.type === 'graphing') {
                    const inp = document.createElement('input');
                    inp.type = 'text';
                    inp.placeholder = 'Answer...';
                    inp.maxLength = 50000;
                    if (q.type === 'identification' && quizData.subject === 'Math') {
                        inp.inputMode = 'decimal';
                    }
                    inp.value = answers[currentIndex] || ''; // RESTORE ANSWER ON RELOAD
                    inp.oninput = e => {
                        if (q.type === 'identification' && quizData.subject === 'Math') {
                            e.target.value = e.target.value.replace(/[^0-9.\-\/]/g, '');
                        }
                        commitAnswerChange(currentIndex, e.target.value);
                        if (quizData.quiz_mode !== 'back_and_forth') {
                            btnConfirm.style.display = e.target.value.trim() ? 'inline-flex' : 'none';
                        }
                    };
                    opts.appendChild(inp);
                    if (q.type === 'graphing' && quizData.quiz_mode !== 'back_and_forth') btnConfirm.style.display = 'inline-flex';
                    inp.focus();
                } else {
                    q.options.forEach((o, optIdx) => {
                        const b = document.createElement('button');
                        b.className = 'option-btn';

                        // RESTORE SELECTION
                        if (q.type === 'multiple_choice_multi') {
                            const currentSet = new Set(String(answers[currentIndex] || '').replace(',', ' ').split(/\s+/).filter(x => x));
                            const letter = String.fromCharCode(65 + optIdx);
                            if (currentSet.has(letter)) b.classList.add('selected');
                        } else {
                            if (answers[currentIndex] === o) b.classList.add('selected');
                        }

                        const optionKey = String.fromCharCode(65 + optIdx);
                        const displayOption = String(o ?? '').replace(new RegExp(`^\\s*(?:option\\s+)?(?:\\(${optionKey}\\)|${optionKey}\\s*[\\)\\].:]|${optionKey}\\s+-\\s+)\\s*`, 'i'), '').trim();
                        b.innerHTML = `<div class="option-key-badge">${optionKey}</div> <div style="flex-grow:1;">${formatText(displayOption)}</div>`;
                        b.onclick = () => {
                            if (q.type === 'multiple_choice_multi') {
                                b.classList.toggle('selected');
                                // Update currentSelectedOption with sorted letters
                                const selected = Array.from(opts.querySelectorAll('.option-btn.selected'))
                                    .map(btn => btn.innerText.trim().toUpperCase()[0])
                                    .sort()
                                    .join(', ');
                                commitAnswerChange(currentIndex, selected);
                                btnConfirm.style.display = selected.length > 0 ? 'inline-flex' : 'none';
                                if (quizData.quiz_mode === 'back_and_forth') {
                                    btnNext.disabled = false;
                                }
                            } else {
                                commitAnswerChange(currentIndex, o);
                                document.querySelectorAll('.option-btn').forEach(x => x.classList.remove('selected'));
                                b.classList.add('selected');
                                if (quizData.quiz_mode !== 'back_and_forth') {
                                btnConfirm.style.display = 'inline-flex';
                                }
                            }
                        };
                        opts.appendChild(b);
                    });
                }
                renderMath();

                // RESTORE GRADED STATE (IF SEQUENTIAL MODE AND ALREADY GRADED)
                if (quizData.quiz_mode !== 'back_and_forth' && progressiveResults[currentIndex] !== null) {
                    const result = progressiveResults[currentIndex];
                    const btnConfirm = document.getElementById('btn-confirm');
                    if (btnConfirm) btnConfirm.style.display = 'none';
                    renderInstantFeedbackResult(result, currentIndex >= quizData.questions.length - 1);
                }
                updateQuestionJumpButtons();
            } catch (err) {
                console.error('Critical error loading question:', err);
                currentIndex++;
                loadQuestion();
            }
        }

        function nextQuestion() {
            const btnNext = document.getElementById('btn-next');
            navigateBackAndForth(currentIndex + 1, btnNext);
        }

        function prevQuestion() {
            const btnPrev = document.getElementById('btn-prev');
            navigateBackAndForth(currentIndex - 1, btnPrev);
        }

        function updatePauseUI() {
            const timerElem = document.getElementById('timer');
            if (!timerElem) return;
            if (isPaused) {
                timerElem.innerHTML = `⏸️ PAUSED BY TEACHER (${formatTime(Math.max(0, timeRemaining))})`;
                timerElem.style.backgroundColor = 'rgba(251, 191, 36, 0.25)';
                timerElem.style.color = 'var(--warning)';
                timerElem.style.borderColor = 'var(--warning)';
                timerElem.style.padding = '8px 16px';
                timerElem.style.borderRadius = 'var(--radius-sm)';
                timerElem.style.fontWeight = '800';
                timerElem.classList.remove('urgent');
            } else {
                timerElem.innerText = formatTime(Math.max(0, timeRemaining));
                timerElem.style.backgroundColor = '';
                timerElem.style.color = '';
                timerElem.style.borderColor = '';
                timerElem.style.padding = '';
                timerElem.style.borderRadius = '';
                if (timeRemaining <= 15) {
                    timerElem.classList.add('urgent');
                } else {
                    timerElem.classList.remove('urgent');
                }
            }
        }

        function startTimer() {
            if (timerInterval) return;

            updatePauseUI();
            timerInterval = setInterval(() => {
                if (!isPaused) {
                    timeRemaining--;
                    updatePauseUI();
                    if (timeRemaining <= 0) {
                        clearInterval(timerInterval);
                        timerInterval = null;
                        console.log('[TIMER] Time\'s up! Advancing...');
                        if (quizData.quiz_mode === 'back_and_forth') {
                            submitQuiz();
                        } else {
                            handleAnswer(currentSelectedOption || 'No Answer (Timeout)');
                        }
                    }
                } else {
                    updatePauseUI();
                }
            }, 1000);
        }

        function confirmSelection(direction = 1) {
            if (isGrading) return;

            const isBF = quizData.quiz_mode === 'back_and_forth';
            if (isBF) {
                const btn = direction === 1 ? document.getElementById('btn-next') : document.getElementById('btn-prev');
                navigateBackAndForth(currentIndex + direction, btn);
                return;
            }

            const btn = document.getElementById('btn-confirm');
            btn.innerText = '⌛ SAVING...';
            btn.disabled = true;
            void handleAnswer(currentSelectedOption ?? '', null, btn);
        }

        function questionPageHasContent(page) {
            return !!page && (
                (Array.isArray(page.strokes) && page.strokes.length > 0)
                || (Array.isArray(page.texts) && page.texts.length > 0)
            );
        }

        function renderQuestionSnapshots(qIndex) {
            const pages = Array.isArray(questionPages[qIndex]) ? questionPages[qIndex] : [];
            const meaningfulPages = pages.filter(questionPageHasContent);
            if (meaningfulPages.length === 0) return [];
            const q = quizData.questions[qIndex] || {};
            const width = canvas && canvas.width > 0 ? canvas.width : 1200;
            const height = canvas && canvas.height > 0 ? canvas.height : 800;
            return meaningfulPages.map(page => {
                const temp = document.createElement('canvas');
                temp.width = width;
                temp.height = height;
                const tempContext = temp.getContext('2d');
                tempContext.fillStyle = '#ffffff';
                tempContext.fillRect(0, 0, temp.width, temp.height);
                if (q.type === 'graphing') {
                    tempContext.beginPath();
                    tempContext.strokeStyle = '#e2e8f0';
                    tempContext.lineWidth = 1;
                    for (let x = 0; x <= temp.width; x += 40) {
                        tempContext.moveTo(x, 0);
                        tempContext.lineTo(x, temp.height);
                    }
                    for (let y = 0; y <= temp.height; y += 40) {
                        tempContext.moveTo(0, y);
                        tempContext.lineTo(temp.width, y);
                    }
                    tempContext.stroke();
                }
                renderToCanvas(page, tempContext);
                return temp.toDataURL('image/png');
            });
        }

        async function captureQuestionSnapshots(qIndex) {
            const scheduledTimer = snapshotCaptureTimers.get(qIndex);
            if (scheduledTimer) {
                clearTimeout(scheduledTimer);
                snapshotCaptureTimers.delete(qIndex);
            }
            const revision = currentAnswerRevision(qIndex);
            const snapshots = sanitizeSnapshotsForServer(renderQuestionSnapshots(qIndex));
            const snapshotDigest = await stableSha256Digest(snapshots);
            if (currentAnswerRevision(qIndex) !== revision) return null;
            solutionSnapshots[qIndex] = snapshots;
            snapshotDigests[qIndex] = snapshotDigest;
            whiteboardDirtyQuestions[qIndex] = false;
            if (qIndex === currentIndex) isWhiteboardDirty = false;
            scheduleProgressiveSave();
            return snapshots;
        }

        function scheduleSnapshotCapture(qIndex, delay = 250) {
            const prior = snapshotCaptureTimers.get(qIndex);
            if (prior) clearTimeout(prior);
            snapshotCaptureTimers.set(qIndex, setTimeout(() => {
                snapshotCaptureTimers.delete(qIndex);
                void captureQuestionSnapshots(qIndex).catch(error => {
                    console.warn(`[QUIZ] Could not snapshot question ${qIndex + 1}:`, error);
                });
            }, delay));
        }

        async function prepareAttemptIdentity(qIndex, answer, snapshots) {
            const revision = currentAnswerRevision(qIndex);
            snapshots = sanitizeSnapshotsForServer(snapshots);
            const [answerDigest, snapshotDigest] = await Promise.all([
                stableSha256Digest(answer),
                stableSha256Digest(snapshots)
            ]);
            if (currentAnswerRevision(qIndex) !== revision) return null;
            answerDigests[qIndex] = answerDigest;
            snapshotDigests[qIndex] = snapshotDigest;
            return {
                questionIndex: qIndex,
                revision,
                answerDigest,
                snapshotDigest,
                answer,
                snapshots
            };
        }

        function responseMatchesAttempt(data, identity) {
            if (!data || typeof data !== 'object') return false;
            const responseQuestionIndex = Number(data.question_index ?? data.q_index);
            return Number.isInteger(responseQuestionIndex)
                && responseQuestionIndex === identity.questionIndex
                && Number(data.answer_revision) === identity.revision
                && data.answer_digest === identity.answerDigest
                && data.snapshot_digest === identity.snapshotDigest
                && currentAnswerRevision(identity.questionIndex) === identity.revision
                && answerDigests[identity.questionIndex] === identity.answerDigest
                && snapshotDigests[identity.questionIndex] === identity.snapshotDigest;
        }

        function applyGradeResponse(qIndex, data, identity) {
            if (!responseMatchesAttempt(data, identity)) {
                console.warn(`[QUIZ] Discarded stale or mismatched grading response for Q${qIndex + 1}.`);
                return null;
            }
            const allowedStatuses = new Set(['graded', 'pending', 'retryable_error', 'invalid_response']);
            const reportedStatus = allowedStatuses.has(data.grade_status) ? data.grade_status : 'invalid_response';
            const reportedScore = Number(data.score_fraction);
            const gradeStatus = reportedStatus === 'graded'
                && (!Number.isFinite(reportedScore) || reportedScore < 0 || reportedScore > 1)
                    ? 'invalid_response'
                    : reportedStatus;
            const allowsAiFeedback = supportsAiFeedback(quizData.questions[qIndex]);
            const baseResult = {
                question: quizData.questions[qIndex].question,
                type: quizData.questions[qIndex].type,
                user_answer: identity.answer,
                grade_status: gradeStatus,
                retryable: gradeStatus === 'retryable_error' && data.retryable === true,
                answer_revision: identity.revision,
                answer_digest: identity.answerDigest,
                snapshot_digest: identity.snapshotDigest,
                ai_feedback: allowsAiFeedback
                    ? (typeof data.feedback === 'string'
                        ? data.feedback
                        : (typeof data.ai_feedback === 'string' ? data.ai_feedback : ''))
                    : ''
            };

            if (gradeStatus === 'graded' && Number.isFinite(Number(data.score_fraction))) {
                const scoreFraction = Math.max(0, Math.min(1, Number(data.score_fraction)));
                const earnedPoints = Number(data.earned_points);
                progressiveResults[qIndex] = {
                    ...baseResult,
                    correct_answer: data.correct_answer ?? null,
                    is_correct: scoreFraction === 1,
                    score_fraction: scoreFraction,
                    earned_points: Number.isFinite(earnedPoints)
                        ? earnedPoints
                        : questionPoints(qIndex) * scoreFraction,
                    grade_proof: typeof data.grade_proof === 'string' ? data.grade_proof : null
                };
            } else {
                progressiveResults[qIndex] = baseResult;
            }
            recalculateLiveScore();
            if (gradeStatus === 'graded') sendPing('Score Synced');
            saveQuizState();
            scheduleProgressiveSave();
            updateQuestionJumpButtons();
            return progressiveResults[qIndex];
        }

        function applyGradeRequestError(qIndex, identity, message, retryable = true) {
            if (currentAnswerRevision(qIndex) !== identity.revision) return null;
            const result = {
                question: quizData.questions[qIndex].question,
                type: quizData.questions[qIndex].type,
                user_answer: identity.answer,
                grade_status: retryable ? 'retryable_error' : 'invalid_response',
                retryable,
                answer_revision: identity.revision,
                answer_digest: identity.answerDigest,
                snapshot_digest: identity.snapshotDigest,
                ai_feedback: message
            };
            progressiveResults[qIndex] = result;
            recalculateLiveScore();
            saveQuizState();
            scheduleProgressiveSave();
            updateQuestionJumpButtons();
            return result;
        }

        async function requestQuestionGrade(qIndex, { snapshots = null } = {}) {
            abortQuestionGrading(qIndex);
            const startingRevision = currentAnswerRevision(qIndex);
            const answer = Object.prototype.hasOwnProperty.call(answers, qIndex)
                ? sanitizeAnswerForServer(answers[qIndex])
                : '';
            if (Object.prototype.hasOwnProperty.call(answers, qIndex)) answers[qIndex] = answer;
            const controller = new AbortController();
            let timedOut = false;
            const gradingTimeout = setTimeout(() => {
                timedOut = true;
                controller.abort();
            }, 60000);
            const pendingToken = beginPendingGrading(qIndex, startingRevision);
            const requestToken = `${pendingToken}:request`;
            let identity = null;
            gradingRequests.set(qIndex, { controller, pendingToken, requestToken, identity: null });
            progressiveResults[qIndex] = {
                question: quizData.questions[qIndex].question,
                type: quizData.questions[qIndex].type,
                user_answer: answer,
                grade_status: 'pending',
                retryable: false,
                answer_revision: startingRevision
            };
            recalculateLiveScore();
            saveQuizState();
            updateQuestionJumpButtons();

            try {
                let attemptSnapshots = snapshots;
                if (!Array.isArray(attemptSnapshots)) {
                    if (whiteboardDirtyQuestions[qIndex] || !Array.isArray(solutionSnapshots[qIndex])) {
                        attemptSnapshots = await captureQuestionSnapshots(qIndex);
                        if (attemptSnapshots === null) return null;
                    } else {
                        attemptSnapshots = solutionSnapshots[qIndex];
                    }
                } else {
                    solutionSnapshots[qIndex] = sanitizeSnapshotsForServer(attemptSnapshots);
                }
                const activeBeforeDigest = gradingRequests.get(qIndex);
                if (!activeBeforeDigest
                    || activeBeforeDigest.requestToken !== requestToken
                    || currentAnswerRevision(qIndex) !== startingRevision) return null;
                identity = await prepareAttemptIdentity(qIndex, answer, attemptSnapshots || []);
                if (!identity) return null;
                const activeBeforeFetch = gradingRequests.get(qIndex);
                if (!activeBeforeFetch || activeBeforeFetch.requestToken !== requestToken) return null;
                activeBeforeFetch.identity = identity;
                progressiveResults[qIndex] = {
                    ...progressiveResults[qIndex],
                    answer_digest: identity.answerDigest,
                    snapshot_digest: identity.snapshotDigest
                };
                saveQuizState();

                const metrics = getCurrentTimeMetrics();
                const response = await fetch('/api/grade_individual', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    signal: controller.signal,
                    body: JSON.stringify({
                        quiz_id: quizId,
                        session_id: sessionId,
                        session_revision: sessionRevision,
                        student_name: studentName,
                        q_index: qIndex,
                        question_index: qIndex,
                        student_answer: answer,
                        solution_snapshots: identity.snapshots,
                        answer_revision: identity.revision,
                        answer_digest: identity.answerDigest,
                        snapshot_digest: identity.snapshotDigest,
                        time_active_seconds: metrics.timeActive,
                        time_paused_seconds: metrics.finalPausedTime,
                        total_duration_seconds: metrics.totalDuration,
                        accuracy_pct: metrics.accuracyPct
                    })
                });
                const data = await response.json().catch(() => ({}));
                const active = gradingRequests.get(qIndex);
                if (!active || active.requestToken !== requestToken) return null;
                if (!response.ok || data.success === false) {
                    if (data.stale === true) {
                        console.warn(`[QUIZ] Server rejected stale grading revision for Q${qIndex + 1}.`);
                        return null;
                    }
                    if (responseMatchesAttempt(data, identity)) {
                        return applyGradeResponse(qIndex, data, identity);
                    }
                    return applyGradeRequestError(
                        qIndex,
                        identity,
                        data.error || `Grading failed (HTTP ${response.status})`,
                        data.retryable === true || response.status === 429 || response.status >= 500
                    );
                }
                return applyGradeResponse(qIndex, data, identity);
            } catch (error) {
                if (error && error.name === 'AbortError' && !timedOut) return null;
                const active = gradingRequests.get(qIndex);
                if (!active || active.requestToken !== requestToken) return null;
                const fallbackIdentity = identity || {
                    revision: startingRevision,
                    answer,
                    answerDigest: answerDigests[qIndex] || '',
                    snapshotDigest: snapshotDigests[qIndex] || ''
                };
                const errorMessage = String(error && error.message || 'Unknown grading failure');
                const retryableFailure = timedOut
                    || (error && error.name === 'TypeError' && /fetch|network|load failed/i.test(errorMessage));
                return applyGradeRequestError(
                    qIndex,
                    fallbackIdentity,
                    timedOut
                        ? 'Grading timed out. Please retry.'
                        : (retryableFailure
                            ? `Grading is temporarily unavailable: ${errorMessage}`
                            : `Grading could not be verified: ${errorMessage}`),
                    retryableFailure
                );
            } finally {
                clearTimeout(gradingTimeout);
                const active = gradingRequests.get(qIndex);
                if (active && active.requestToken === requestToken) gradingRequests.delete(qIndex);
                settlePendingGrading(pendingToken);
                updateQuestionJumpButtons();
            }
        }

        function renderInstantFeedbackResult(result, isLast = false) {
            const feedbackCont = document.getElementById('instant-feedback');
            const statusElem = document.getElementById('feedback-status');
            const textElem = document.getElementById('feedback-text');
            const retryBtn = document.getElementById('btn-retry-grading');
            if (!feedbackCont || !statusElem || !textElem) return;

            const reportedStatus = result && result.grade_status ? result.grade_status : 'pending';
            const gradeStatus = reportedStatus === 'graded' && !isAuthoritativelyGraded(result)
                ? 'invalid_response'
                : reportedStatus;
            feedbackCont.style.display = 'block';
            feedbackCont.classList.remove('feedback-correct', 'feedback-wrong');
            if (retryBtn) retryBtn.style.display = 'none';

            if (gradeStatus === 'graded') {
                const scoreFraction = Number(result.score_fraction);
                if (scoreFraction === 1) {
                    feedbackCont.classList.add('feedback-correct');
                    statusElem.innerHTML = '<i data-lucide="check-circle" class="icon-sm"></i> CORRECT!';
                } else if (scoreFraction > 0) {
                    feedbackCont.classList.add('feedback-wrong');
                    statusElem.innerHTML = '<i data-lucide="minus-circle" class="icon-sm"></i> PARTIAL CREDIT';
                } else {
                    feedbackCont.classList.add('feedback-wrong');
                    statusElem.innerHTML = '<i data-lucide="x-circle" class="icon-sm"></i> INCORRECT';
                }
            } else if (gradeStatus === 'retryable_error') {
                statusElem.innerHTML = '<i data-lucide="clock" class="icon-sm"></i> GRADING TEMPORARILY UNAVAILABLE';
                if (retryBtn && result.retryable === true) retryBtn.style.display = 'inline-flex';
            } else if (gradeStatus === 'invalid_response') {
                statusElem.innerHTML = '<i data-lucide="alert-triangle" class="icon-sm"></i> GRADING COULD NOT BE VERIFIED';
            } else {
                statusElem.innerHTML = '<i data-lucide="clock" class="icon-sm"></i> GRADING PENDING';
            }

            let feedbackHtml = '';
            if (gradeStatus === 'graded' && result.correct_answer !== null && result.correct_answer !== undefined) {
                feedbackHtml += `<strong>Correct Answer:</strong><br><div style="margin-top: 5px; font-weight: 700; font-size: 18px;">${formatText(result.correct_answer)}</div>`;
            }
            if (result && result.ai_feedback && result.ai_feedback.trim()) {
                feedbackHtml += `${feedbackHtml ? '<br><br>' : ''}<i data-lucide="bot" class="icon-sm"></i> <em>${formatText(result.ai_feedback)}</em>`;
            }
            if (!feedbackHtml) feedbackHtml = gradeStatus === 'graded' ? 'Your answer has been checked.' : 'Your answer has not been counted as incorrect. Please wait or retry when offered.';
            textElem.innerHTML = feedbackHtml;

            if (gradeStatus === 'graded') {
                const inputs = document.getElementById('options-container').querySelectorAll('button, input, textarea');
                inputs.forEach(element => {
                    element.disabled = true;
                    element.style.opacity = '0.6';
                    element.style.pointerEvents = 'none';
                });
            }
            if (isLast) {
                const nextBtn = feedbackCont.querySelector('.btn-next-question');
                if (nextBtn) nextBtn.innerHTML = '<i data-lucide="flag" class="icon-sm"></i> FINISH QUIZ';
            }
            renderMath('instant-feedback');
            window.refreshQuizmokoIcons?.();
        }

        async function handleAnswer(val, navigationTarget = null, btn = null) {
            const qIndex = currentIndex;
            try {
                if (timerInterval) clearInterval(timerInterval);
                timerInterval = null;
                isGrading = true;
                commitAnswerChange(qIndex, val);
                const isBF = quizData.quiz_mode === 'back_and_forth';
                const gradingPromise = requestQuestionGrade(qIndex);

                if (isBF) {
                    const targetIndex = Number.isInteger(Number(navigationTarget))
                        ? Number(navigationTarget)
                        : qIndex + 1;
                    goToQuestion(targetIndex);
                    return;
                }

                sendPing('Evaluating');
                const btnConfirm = document.getElementById('btn-confirm');
                if (btnConfirm) btnConfirm.style.display = 'none';
                renderInstantFeedbackResult({ grade_status: 'pending', retryable: false }, qIndex >= quizData.questions.length - 1);
                await gradingPromise;
                renderInstantFeedbackResult(progressiveResults[qIndex], qIndex >= quizData.questions.length - 1);
                document.getElementById('instant-feedback').scrollIntoView({ behavior: 'smooth', block: 'center' });
            } catch (fatalErr) {
                console.error('FATAL UI CRASH:', fatalErr);
                const revision = currentAnswerRevision(qIndex);
                const identity = {
                    revision,
                    answer: Object.prototype.hasOwnProperty.call(answers, qIndex) ? answers[qIndex] : '',
                    answerDigest: answerDigests[qIndex] || '',
                    snapshotDigest: snapshotDigests[qIndex] || ''
                };
                applyGradeRequestError(qIndex, identity, `Grading could not be verified: ${fatalErr.message}`, false);
                if (quizData.quiz_mode === 'back_and_forth') {
                    const targetIndex = Number.isInteger(Number(navigationTarget))
                        ? Number(navigationTarget)
                        : qIndex + 1;
                    goToQuestion(targetIndex);
                } else {
                    renderInstantFeedbackResult(progressiveResults[qIndex], qIndex >= quizData.questions.length - 1);
                }
            } finally {
                isGrading = false;
            }
        }

        function advanceQuestion() {
            if (currentIndex >= quizData.questions.length - 1) {
                return submitQuiz();
            }

            // RESET FEEDBACK UI
            document.getElementById('instant-feedback').style.display = 'none';
            const btnConfirm = document.getElementById('btn-confirm');
            if (btnConfirm) btnConfirm.style.display = 'inline-flex';
            const retryBtn = document.getElementById('btn-retry-grading');
            if (retryBtn) retryBtn.style.display = 'none';

            currentIndex++; // Advance index here for sequential mode
            isWhiteboardDirty = !!whiteboardDirtyQuestions[currentIndex];
            timeRemaining = quizData.time_limit;
            timerInterval = null;
            startTimer();
            loadQuestion();
        }

        async function retryGrading() {
            const retryBtn = document.getElementById('btn-retry-grading');
            if (!retryBtn) return;
            const currentResult = progressiveResults[currentIndex];
            if (!currentResult || currentResult.grade_status !== 'retryable_error' || currentResult.retryable !== true) return;

            const originalText = retryBtn.innerText;
            retryBtn.innerText = '⌛ RE-CHECKING...';
            retryBtn.disabled = true;
            const qIndex = currentIndex;

            try {
                await requestQuestionGrade(qIndex);
                renderInstantFeedbackResult(progressiveResults[qIndex], qIndex >= quizData.questions.length - 1);
            } catch (e) {
                console.error('Retry Grading Error:', e);
                renderInstantFeedbackResult(progressiveResults[qIndex], qIndex >= quizData.questions.length - 1);
            } finally {
                retryBtn.innerText = originalText;
                retryBtn.disabled = false;
            }
        }

        async function submitQuiz(status = 'completed') {
            if (isSubmitting) return;

            if (status === 'early' && !confirm('Are you sure you want to end the quiz early? Unanswered questions will be marked as incorrect.')) return;
            lastSubmissionStatus = status;
            isSubmitting = true;
            let submissionConfirmed = false;
            let finalCalculatedScore = null;
            let finalMaximumScore = null;

            // SHOW LOADING STATE IMMEDIATELY
            document.getElementById('quiz-screen').style.display = 'none';
            document.getElementById('result-screen').style.display = 'block';
            document.getElementById('score-text').innerText = 'Finalizing Results...';
            document.getElementById('save-status-msg').innerText = 'Waiting for authoritative server grading.';
            document.getElementById('pdf-btn').style.display = 'none';

            // Anti-Stuck: Clear any active timers
            if (timerInterval) clearInterval(timerInterval);
            timerInterval = null;

            // WAIT FOR PENDING GRADINGS (shorter 15s timeout for safety)
            let waitStart = Date.now();
            while (pendingGradings > 0 && (Date.now() - waitStart < 15000)) {
                console.log(`[QUIZ] Waiting for ${pendingGradings} pending gradings...`);
                document.getElementById('score-text').innerText = `Finalizing Results (${pendingGradings} left)...`;
                await new Promise(r => setTimeout(r, 1000));
            }
            if (progressiveSaveDebounce) {
                clearTimeout(progressiveSaveDebounce);
                progressiveSaveDebounce = null;
            }
            await progressiveSaveChain.catch(error => {
                console.warn('[QUIZ] Continuing finalization after a progressive save failure:', error);
            });
            Array.from(gradingRequests.keys()).forEach(abortQuestionGrading);

            clearInterval(pingInterval); // Stop normal pings immediately

            try {
            const finalSnapshotPayload = {};
            const finalSnapshotDigestPayload = {};
            for (let index = 0; index < quizData.questions.length; index++) {
                answerRevisions[index] = currentAnswerRevision(index);
                const hasLocalWork = Array.isArray(questionPages[index]) && questionPages[index].some(questionPageHasContent);
                if (whiteboardDirtyQuestions[index] || (hasLocalWork && !Array.isArray(solutionSnapshots[index]))) {
                    await captureQuestionSnapshots(index);
                }
                if (Array.isArray(solutionSnapshots[index])) {
                    solutionSnapshots[index] = sanitizeSnapshotsForServer(solutionSnapshots[index]);
                    finalSnapshotPayload[index] = solutionSnapshots[index];
                    finalSnapshotDigestPayload[index] = await stableSha256Digest(solutionSnapshots[index]);
                } else if (typeof snapshotDigests[index] === 'string' && snapshotDigests[index]) {
                    // The raster may only exist on the server after a localStorage restore.
                    // Omitting the image key preserves it; its known digest still binds proof.
                    finalSnapshotDigestPayload[index] = snapshotDigests[index];
                } else {
                    finalSnapshotPayload[index] = [];
                    finalSnapshotDigestPayload[index] = await stableSha256Digest([]);
                }
                answers[index] = Object.prototype.hasOwnProperty.call(answers, index)
                    ? sanitizeAnswerForServer(answers[index])
                    : 'No Answer';
                const answer = answers[index];
                answerDigests[index] = await stableSha256Digest(answer);
                snapshotDigests[index] = finalSnapshotDigestPayload[index];
            }

            // Preserve proofs as hints only. The server independently validates or
            // regrades every item and is the sole authority for the final score.
            progressiveResults = quizData.questions.map((q, i) => {
                const r = progressiveResults[i];
                const userAns = Object.prototype.hasOwnProperty.call(answers, i) ? answers[i] : 'No Answer';

                if (isAuthoritativelyGraded(r)
                    && Number(r.answer_revision) === currentAnswerRevision(i)
                    && r.answer_digest === answerDigests[i]
                    && r.snapshot_digest === snapshotDigests[i]) {
                    return { ...r, user_answer: userAns };
                }

                return {
                    question: q.question,
                    type: q.type,
                    user_answer: userAns,
                    grade_status: 'pending',
                    retryable: false,
                    answer_revision: currentAnswerRevision(i),
                    answer_digest: answerDigests[i],
                    snapshot_digest: snapshotDigests[i],
                    ai_feedback: 'Pending authoritative server grading.'
                };
            });
            const localLiveScore = recalculateLiveScore();
            const finalSessionRevision = ++sessionRevision;

            document.getElementById('right-panel').style.display = 'none';
            document.querySelector('.quiz-container').classList.remove('split-mode');

                // Calculate final time metrics
                const metrics = getCurrentTimeMetrics();
                const timeActive = metrics.timeActive;
                const finalPausedTime = metrics.finalPausedTime;
                const totalDuration = metrics.totalDuration;
                const accuracyPct = maximumQuizScore() > 0
                    ? (localLiveScore / maximumQuizScore()) * 100
                    : 0;

                // 1. URGENT: SEND FINAL STATUS PING FIRST TO CLEAR LIVE DASHBOARD
                // Use sendPing to ensure high-priority broadcast via WebSockets if available
                const finalStatus = status === 'early'
                    ? 'Abandoned'
                    : (status === 'terminated' ? 'Terminated by teacher' : 'Completed');
                sendPing('Finalizing');

                // Keep the HTTP fallback for absolute reliability
                await fetch('/ping', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        quiz_id: quizId, session_id: sessionId, student_name: studentName,
                        current_q: currentIndex + 1, score: null, status: 'Finalizing'
                    })
                }).catch(e => console.error('Final status ping fallback failed:', e));

                // 2. PRIMARY SUBMIT
                const response = await fetch('/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        quiz_id: quizId, session_id: sessionId, student_name: studentName,
                        answers,
                        answer_revisions: answerRevisions,
                        answer_digests: answerDigests,
                        snapshot_digests: finalSnapshotDigestPayload,
                        session_revision: finalSessionRevision,
                        graded_details: progressiveResults,
                        submission_status: status,
                        solution_snapshots: finalSnapshotPayload,
                        time_active_seconds: timeActive,
                        time_paused_seconds: finalPausedTime,
                        total_duration_seconds: totalDuration,
                        accuracy_pct: accuracyPct
                    })
                });

                const data = await response.json().catch(() => ({}));
                if (!response.ok || !data.success) {
                    const submissionError = new Error(data.error || `Server error ${response.status}`);
                    submissionError.retryable = data.retryable === true
                        || (!data.grading_incomplete && (response.status === 429 || response.status >= 500));
                    submissionError.gradingIncomplete = data.grading_incomplete === true;
                    throw submissionError;
                }
                const serverDetails = Array.isArray(data.graded_details) ? data.graded_details : data.details;
                if (!Array.isArray(serverDetails)
                    || serverDetails.length !== quizData.questions.length
                    || !serverDetails.every(detail => isAuthoritativelyGraded(detail))
                    || !Number.isFinite(Number(data.total_score))
                    || !Number.isFinite(Number(data.max_score))) {
                    const invalidResultError = new Error('The server did not return a complete authoritative result.');
                    invalidResultError.retryable = false;
                    throw invalidResultError;
                }
                resultId = data.result_id;
                resultAccessToken = data.result_access_token || null;
                progressiveResults = serverDetails;
                finalCalculatedScore = Number(data.total_score);
                finalMaximumScore = Number(data.max_score);
                totalScore = finalCalculatedScore;
                submissionConfirmed = true;
                sendPing(finalStatus);
                document.getElementById('save-status-msg').innerText = 'Score successfully submitted.';
                document.getElementById('pdf-btn').style.display = 'inline-flex';
                localStorage.removeItem(STORAGE_KEY);
            } catch (err) {
                console.error('Submission failed:', err);
                isSubmitting = false;
                sendPing('Grading incomplete');
                document.getElementById('score-text').innerText = 'Result not finalized';
                const failureMessage = String(err && err.message || 'Finalization failed.');
                const canRetry = err && err.retryable === true
                    || (err && err.retryable === undefined
                        && err.name === 'TypeError'
                        && /fetch|network|load failed/i.test(failureMessage));
                const retryMarkup = canRetry
                    ? `<br><br><button class="btn-confirm" style="display:inline-flex; width:auto;" onclick="submitQuiz(lastSubmissionStatus)">
                        <i data-lucide="refresh-cw" class="icon-sm"></i> RETRY FINALIZATION
                    </button>`
                    : '';
                document.getElementById('save-status-msg').innerHTML = `
                    <span style="color:var(--m-red)"><i data-lucide="alert-triangle" class="icon-sm"></i> ${formatText(failureMessage)}</span>${retryMarkup}`;
                document.getElementById('review-container').innerHTML = '<p style="color:var(--warning);">No score is confirmed until authoritative grading completes on the server. Your answers remain available for retry.</p>';
                window.refreshQuizmokoIcons?.();
            } finally {
                if (!submissionConfirmed) return;
                document.getElementById('score-text').innerText = `${finalCalculatedScore.toFixed(2)} / ${finalMaximumScore.toFixed(2)}`;
                const rev = document.getElementById('review-container'); rev.innerHTML = '';
                progressiveResults.forEach((item, i) => {
                    const b = document.createElement('div'); b.className = `review-block`;

                    const isGraded = item && item.grade_status === 'graded';
                    const sfVal = isGraded && Number.isFinite(Number(item.score_fraction)) ? Number(item.score_fraction) : 0;
                    const statusClass = !isGraded ? 'status-partial' : (sfVal >= 1 ? 'status-correct' : (sfVal > 0 ? 'status-partial' : 'status-wrong'));
                    const statusText = !isGraded
                        ? '<i data-lucide="clock" class="icon-sm"></i> Pending'
                        : (sfVal >= 1 ? '<i data-lucide="check" class="icon-sm"></i> Correct' : (sfVal > 0 ? `<i data-lucide="minus" class="icon-sm"></i> Partial (${(sfVal * 100).toFixed(0)}%)` : '<i data-lucide="x" class="icon-sm"></i> Incorrect'));
                    const maxItemPoints = questionPoints(i);
                    const earnedItemPoints = isGraded && Number.isFinite(Number(item.earned_points))
                        ? Number(item.earned_points)
                        : maxItemPoints * sfVal;

                    let html = `
                        <div class="status-badge ${statusClass}">${statusText}</div>
                        <div style="font-weight: 800; color: var(--primary); display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 12px;">
                            <span>QUESTION ${i+1}</span>
                            <span style="font-size: 14px; background: var(--surface-card); padding: 4px 10px; border-radius: 8px;">Points: ${earnedItemPoints.toFixed(2)} / ${maxItemPoints.toFixed(2)}</span>
                        </div>
                        <div style="font-size: 18px; margin-bottom: 20px;">${formatText(item.question)}</div>
                    `;

                    // --- SHOW WHITEBOARD SNAPSHOTS ---
                    const snapshots = solutionSnapshots[i];
                    if (snapshots && snapshots.length > 0) {
                        html += `<div class="workings-title"><i data-lucide="edit-3" class="icon-sm"></i> Your Workings:</div>`;
                        snapshots.forEach(img => {
                            if (isSafeDisplayImageSource(img)) {
                                html += `<img src="${img}" class="workings-img" alt='Whiteboard Snapshot'>`;
                            }
                        });
                    }

                    html += `
                        <div class="answer-comparison">
                            <div class="ans-box">
                                <span class="ans-label">Your Answer</span>
                                <div class="ans-value">${formatText(item.user_answer)}</div>
                            </div>
                            <div class="ans-box">
                                <span class="ans-label">Correct Answer</span>
                                <div class="ans-value">${formatText(item.correct_answer ?? 'N/A')}</div>
                            </div>
                        </div>
                    `;

                    const allowsAiFeedback = supportsAiFeedback(quizData.questions[i]);
                    if (allowsAiFeedback && item.ai_feedback) {
                        html += `<div style="margin-top: 15px; padding: 12px; background: rgba(99, 102, 241, 0.1); border-radius: 4px; font-size: 13px;"><i data-lucide="bot" class="icon-sm"></i> ${formatText(item.ai_feedback)}</div>`;
                    }

                    if (allowsAiFeedback && isGraded && sfVal < 1) {
                        html += `
                                <button class="wb-btn" style="margin-top: 15px; width: 100%; border-color: var(--primary); color: var(--primary);"
                                onclick="explainMistakeStudent(this, ${i})">
                                <i data-lucide="bot" class="icon-sm"></i> AI Tutor: Explain My Mistake
                            </button>
                            <div class="explanation-box" style="display:none;"></div>
                        `;
                    }

                    b.innerHTML = html;
                    rev.appendChild(b);
                });
                renderMath('review-container');

                // Vector editing state is no longer needed after a confirmed result.
                // Keep the bounded snapshot cache available for proof-bound tutor requests.
                questionPages = {};
                saveQuizState();
            }
        }

        function openSharedSolutions() {
            if (!resultId) return alert('Result still saving...');
            if (!resultAccessToken) return alert('Secure result link is unavailable. Please retry saving the quiz.');
            const params = new URLSearchParams({
                download: 'true',
                access_token: resultAccessToken
            });
            window.open(`/view_solutions/${encodeURIComponent(resultId)}?${params.toString()}`, '_blank');
        }

        function explainMistakeStudent(btn, idx) {
            const item = progressiveResults[idx];
            if (!supportsAiFeedback(quizData.questions[idx])) return;

            // SYNCHRONIZATION: Reuse existing detailed feedback if available
            if (item.ai_feedback && item.ai_feedback.length > 20) {
                btn.style.display = 'none';
                const box = btn.nextElementSibling;
                box.style.display = 'block';
                box.innerHTML = `<strong style="color: var(--on-dark);"><i data-lucide="bot" class="icon-sm"></i> AI TUTOR (Synced):</strong><br><br>` + formatText(item.ai_feedback);
                renderMath('review-container');
                window.refreshQuizmokoIcons?.();
                return;
            }

            btn.innerText = 'GENERATING...'; btn.disabled = true;
            fetch('/api/explain', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    quiz_id: quizId,
                    session_id: sessionId,
                    q_index: idx,
                    question_index: idx,
                    answer_revision: Number(item.answer_revision) || 0,
                    grade_proof: item.grade_proof,
                    question: item.question,
                    user_answer: item.user_answer,
                    correct_answer: item.correct_answer,
                    solution_snapshots: solutionSnapshots[idx] || []
                })
            })
            .then(res => res.json()).then(data => {
                btn.style.display = 'none'; const box = btn.nextElementSibling; box.style.display = 'block';
                box.innerHTML = `<strong style="color: var(--on-dark);"><i data-lucide="bot" class="icon-sm"></i> AI TUTOR:</strong><br><br>` + formatText(data.explanation);
                renderMath('review-container');
                window.refreshQuizmokoIcons?.();
            });
        }

        let resizeObserver;
        function initWhiteboard() {
            if (whiteboardInitialized) return; // PREVENT MULTIPLE EVENT LISTENERS
            canvas = document.getElementById('main-canvas'); if (!canvas) return;
            ctx = canvas.getContext('2d', { willReadFrequently: true });
            const textCont = document.getElementById('wb-text-container'), textInput = document.getElementById('wb-text-input'), resizer = textCont.querySelector('.wb-resizer');
            
            const canvasHolder = document.getElementById('canvas-holder');
            if (window.ResizeObserver && canvasHolder) {
                let debounceTimeout;
                resizeObserver = new ResizeObserver(entries => {
                    if (debounceTimeout) clearTimeout(debounceTimeout);
                    debounceTimeout = setTimeout(() => {
                        resizeCanvas();
                    }, 30);
                });
                resizeObserver.observe(canvasHolder);
            } else {
                window.addEventListener('resize', resizeCanvas);
            }
            
            whiteboardInitialized = true;
            updateWhiteboardThemeColors();
            setTimeout(resizeCanvas, 50);

            canvas.onpointerdown = e => {
                const r = canvas.getBoundingClientRect(); startX = (e.clientX - r.left); startY = (e.clientY - r.top);
                if (currentTool === 'text') {
                    if (textCont.style.display === 'block') finalizeText();
                    textCont.style.display = 'block'; textCont.style.left = startX + 'px'; textCont.style.top = startY + 'px';
                    textInput.style.color = document.getElementById('wb-color').value; textInput.style.fontSize = (document.getElementById('wb-size').value * 4) + 'px';
                    textInput.value = ''; setTimeout(() => textInput.focus(), 10); return;
                }
                if (textCont.style.display === 'block') finalizeText();
                isDrawing = true;
                currentStroke = { tool: currentTool, color: document.getElementById('wb-color').value, size: document.getElementById('wb-size').value, points: [{x: startX, y: startY}] };
            };
            canvas.onpointermove = e => {
                if (!isDrawing || !currentStroke) return;
                const r = canvas.getBoundingClientRect(); const x = (e.clientX - r.left), y = (e.clientY - r.top);
                if (currentTool === 'draw' || currentTool === 'erase') currentStroke.points.push({x, y});
                else currentStroke.points[1] = {x, y};
                redrawCanvas(); drawStroke(currentStroke, ctx);
            };
            canvas.onpointerup = () => {
                if (isDrawing && currentStroke) {
                    questionPages[currentIndex][currentPageIndex].strokes.push(currentStroke);
                    commitWhiteboardChange(currentIndex);
                }
                isDrawing = false;
                currentStroke = null;
                redrawCanvas();
            };
            textCont.onpointerdown = e => { if (e.target !== resizer) isDraggingText = true; e.stopPropagation(); };
            resizer.onpointerdown = e => { isResizingText = true; e.stopPropagation(); };
            window.addEventListener('pointermove', e => {
                if (isDraggingText) { const r = canvas.getBoundingClientRect(); textCont.style.left = (e.clientX - r.left - 50) + 'px'; textCont.style.top = (e.clientY - r.top - 20) + 'px'; }
                if (isResizingText) { const r = textCont.getBoundingClientRect(); textCont.style.width = (e.clientX - r.left) + 'px'; textCont.style.height = (e.clientY - r.top) + 'px'; }
            });
            window.addEventListener('pointerup', () => { isDraggingText = false; isResizingText = false; });
        }

        function redrawCanvas() { if (!ctx) return; ctx.clearRect(0, 0, canvas.width, canvas.height); renderToCanvas(questionPages[currentIndex][currentPageIndex], ctx); }
        function renderToCanvas(p, tCtx) { if (!p) return; p.strokes.forEach(s => drawStroke(s, tCtx)); p.texts.forEach(t => { tCtx.fillStyle = t.color; tCtx.font = `${t.size} Inter`; const lines = t.content.split('\n'), fs = parseInt(t.size), lh = fs * 1.2; lines.forEach((l, i) => tCtx.fillText(l, t.x, t.y + (i * lh) + fs)); }); }
        function drawStroke(s, tCtx) {
            tCtx.lineCap = 'round'; tCtx.lineJoin = 'round';
            if (s.tool === 'erase') { tCtx.globalCompositeOperation = 'destination-out'; tCtx.lineWidth = s.size * 6; }
            else { tCtx.globalCompositeOperation = 'source-over'; tCtx.strokeStyle = s.color; tCtx.lineWidth = s.size; }
            tCtx.beginPath(); tCtx.moveTo(s.points[0].x, s.points[0].y);
            if (s.tool === 'draw' || s.tool === 'erase') s.points.forEach(p => tCtx.lineTo(p.x, p.y));
            else if (s.tool === 'line' && s.points[1]) tCtx.lineTo(s.points[1].x, s.points[1].y);
            else if (s.tool === 'rect' && s.points[1]) tCtx.strokeRect(s.points[0].x, s.points[0].y, s.points[1].x - s.points[0].x, s.points[1].y - s.points[0].y);
            else if (s.tool === 'circle' && s.points[1]) tCtx.arc(s.points[0].x, s.points[0].y, Math.sqrt(Math.pow(s.points[1].x-s.points[0].x,2)+Math.pow(s.points[1].y-s.points[0].y,2)), 0, Math.PI*2);
            tCtx.stroke(); tCtx.globalCompositeOperation = 'source-over';
        }
        function saveCurrentPage() { console.log('[WB] Current page strokes saved.'); }
        function addNewPage() {
            questionPages[currentIndex].push({ strokes: [], texts: [] });
            currentPageIndex = questionPages[currentIndex].length - 1;
            commitWhiteboardChange(currentIndex);
            redrawCanvas();
            updatePageUI();
        }
        function nextPage() { if (currentPageIndex < questionPages[currentIndex].length - 1) { currentPageIndex++; redrawCanvas(); updatePageUI(); } }
        function prevPage() { if (currentPageIndex > 0) { currentPageIndex--; redrawCanvas(); updatePageUI(); } }
        function updatePageUI() { document.getElementById('page-indicator').innerText = `PAGE ${currentPageIndex + 1}/${questionPages[currentIndex].length}`; }
        function finalizeText() {
            const textCont = document.getElementById('wb-text-container'), textInput = document.getElementById('wb-text-input');
            if (textCont.style.display === 'none' || !textInput.value.trim()) { textCont.style.display = 'none'; return; }
            questionPages[currentIndex][currentPageIndex].texts.push({ content: textInput.value, x: parseInt(textCont.style.left), y: parseInt(textCont.style.top), color: textInput.style.color, size: textInput.style.fontSize });
            textCont.style.display = 'none';
            textInput.value = '';
            commitWhiteboardChange(currentIndex);
            redrawCanvas();
        }
        function setTool(t) { if (document.getElementById('wb-text-container').style.display === 'block') finalizeText(); currentTool = t; document.querySelectorAll('.wb-btn[data-tool]').forEach(b => b.classList.toggle('active', b.dataset.tool === t)); }
        function toggleWBGrid() { const c = document.getElementById('canvas-holder'), b = document.getElementById('wb-grid-toggle'), g = c.classList.toggle('grid-mode'); b.innerText = g ? '⬜ Grid: On' : '⬛ Grid: Off'; b.classList.toggle('active', g); }
        function clearCanvas() {
            questionPages[currentIndex][currentPageIndex] = { strokes: [], texts: [] };
            commitWhiteboardChange(currentIndex);
            redrawCanvas();
            document.getElementById('wb-text-container').style.display = 'none';
        }
        function addText() { setTool('text'); }
        function setLineWidth(w) {
            const sizeInput = document.getElementById('wb-size');
            if (sizeInput) sizeInput.value = w;
        }
        function resizeCanvas() { 
            if(!canvas) return; 
            const h = document.getElementById('canvas-holder'); 
            if (!h) return;
            const w = h.clientWidth;
            const h_val = h.clientHeight;
            if (w === 0 || h_val === 0) return;
            if (canvas.width === w && canvas.height === h_val) return;
            canvas.width = w; 
            canvas.height = h_val; 
            redrawCanvas(); 
        }

        // --- NEW: OFFLINE GUARD LOGIC ---
        window.addEventListener('online', updateOnlineStatus);
        window.addEventListener('offline', updateOnlineStatus);

        function updateOnlineStatus() {
            const dot = document.getElementById('connection-dot');
            const btnConfirm = document.getElementById('btn-confirm');
            const isOnline = navigator.onLine;

            if (isOnline) {
                dot.style.background = 'var(--success)';
                dot.title = 'Online';
                if (btnConfirm && btnConfirm.dataset.wasDisabledByOffline === 'true') {
                    btnConfirm.disabled = false;
                    btnConfirm.innerText = 'CONFIRM ANSWER';
                    delete btnConfirm.dataset.wasDisabledByOffline;
                }
            } else {
                dot.style.background = 'var(--m-red)';
                dot.title = 'Offline - Reconnecting...';
                if (btnConfirm && !btnConfirm.disabled) {
                    btnConfirm.disabled = true;
                    btnConfirm.innerHTML = '<i data-lucide="plug" class="icon-sm"></i> RECONNECTING...';
                    btnConfirm.dataset.wasDisabledByOffline = 'true';
                    window.refreshQuizmokoIcons?.();
                }
            }
        }

        window.onload = async () => {
            if (loadQuizState()) {
                console.log('[QUIZ] Restoring session for:', studentName);
                const restoredProgress = await loadProgressiveResultFromServer();
                if (restoredProgress === 'finalized') return;
                sendPing('Resumed');
                startQuizUI();
                resumePendingGradings();
            }
        };
    </script>
    <script>window.refreshQuizmokoIcons?.();</script>
</body>
</html>
