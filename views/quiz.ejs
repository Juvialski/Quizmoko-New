            <button class="btn-confirm" id="pdf-btn" onclick="openSharedSolutions()" style="display:inline-flex; background: var(--m-blue-dark); margin-bottom: 40px;"><i data-lucide="download" class="icon-sm"></i> VIEW & DOWNLOAD SOLUTIONS</button>
                    <hr style="border: 1px solid var(--hairline); margin: 64px 0;">
