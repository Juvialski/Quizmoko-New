                <button class="wb-btn" id="wb-grid-toggle" onclick="toggleWBGrid()">⬛ Grid: Off</button>
                <button class="wb-btn" onclick="clearCanvas()"><i data-lucide="trash-2" class="icon-sm"></i>️ Clear</button>
                <select class="wb-btn" id="wb-size" onchange="setLineWidth(this.value)"><option value="2">2px</option><option value="4" selected>4px</option><option value="8">8px</option><option value="12">12px</option></select>
                <div style="display: flex; align-items: center; gap: 6px; margin-left: 4px; flex-shrink: 0;">
                    <span style="font-size: 11px; font-weight: 600; color: var(--body);">Color:</span>
                    <input type="color" id="wb-color" value="#f8fafc" class="wb-btn" style="padding: 2px; width: 34px; height: 28px; border: 1px solid var(--hairline); background: var(--surface-card); cursor: pointer; border-radius: var(--radius-sm);" onchange="this.dataset.userChanged = 'true';">
                </div>
                <div style="flex:1;"></div>
                <div style="font-size:10px; color:#64748b; font-weight:800;">SOLUTION AREA</div>
            </div>
            <div class="whiteboard-container" id="canvas-holder">
                <div id="wb-text-container">
                    <textarea id="wb-text-input" spellcheck='false'></textarea>
                    <div class="wb-resizer"></div>
                </div>
                <canvas id="main-canvas"></canvas>
                <div class="wb-page-controls">
                    <button class="wb-btn" onclick="prevPage()">◀</button>
                    <span id="page-indicator">PAGE 1/1</span>
                    <button class="wb-btn" onclick="nextPage()">▶</button>
                    <button class="wb-btn" style="background:var(--primary); color:white; border:none;" onclick="addNewPage()">+ NEW PAGE</button>
                </div>
