<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - QuizMoKo</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/quizmoko-ui.css">
    <script src="/js/quizmoko-theme.js"></script>
    <style>
        body { display: flex; justify-content: center; align-items: center; min-height: 100vh; padding: 20px; }
        .auth-card { background: var(--surface-card); padding: 36px; border-radius: var(--radius-xl); border: 1px solid var(--hairline); width: 100%; max-width: 420px; box-shadow: var(--shadow-lg); }
        .error-msg { color: var(--danger); margin-bottom: 15px; font-size: 14px; font-weight: 600; }
        .role-selector { display: flex; justify-content: space-around; margin: 20px 0; background: var(--surface-soft); padding: 12px; border-radius: var(--radius-md); border: 1px solid var(--hairline); }
        .role-selector label { cursor: pointer; font-weight: 600; color: var(--body-strong); display: flex; align-items: center; gap: 8px; font-size: 14px; margin: 0; }
        .disclaimer-box { text-align: left; margin: 15px 0 20px 0; background: var(--warning-bg); padding: 16px; border: 1px solid var(--warning); border-radius: var(--radius-md); }
        .disclaimer-box label { font-size: 12px; color: var(--warning); display: flex; align-items: flex-start; gap: 10px; cursor: pointer; margin: 0; font-weight: 400; }
        .disclaimer-box input[type="checkbox"] { margin-top: 2px; width: 16px; height: 16px; cursor: pointer; accent-color: var(--warning); }
    </style>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body>
    <div class="auth-card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
            <h2 style="margin: 0; color: var(--body-strong); font-size: 24px;">Create Account</h2>
            <button type="button" onclick="toggleTheme()" data-theme-toggle class="btn btn-ghost btn-icon" title="Toggle Theme" aria-label="Switch to light theme"><i data-lucide="moon"></i></button>
        </div>
        
        
            <div id="error" class="error-msg"></div>
            <form id="register-form">
                <div class="form-group">
                    <label for="email" class="form-label">Email address</label>
                    <input type="email" id="email" class="form-control" placeholder="Email address" autocomplete="email" required>
                </div>
                <div class="form-group">
                    <label for="password" class="form-label">Password</label>
                    <input type="password" id="password" class="form-control" placeholder="PASSWORD (MIN 6 CHARS)" autocomplete="new-password" required minlength='6'>
                </div>

                <!-- MANDATORY LEGAL DISCLAIMER -->
            <div class="disclaimer-box" id="auth-disclaimer">
                <label>
                    <input type="checkbox" id="disclaimer-check" required>
                    <span style="line-height: 1.4;">
                        <b>DISCLAIMER:</b> I understand that AI can make mistakes. I agree to use my own Google API Key at my own risk, and I release QuizMoKo from any liability regarding API usage costs, account limits, or AI inaccuracies.
                    </span>
                </label>
            </div>

            <button type="submit" class="btn btn-primary btn-block" id="submit-btn">CREATE ACCOUNT</button>

            <div style="margin-top: 20px; text-align: center; border-top: 1px solid var(--hairline); padding-top: 20px;">
                <p style="margin-top: 0; margin-bottom: 12px; font-weight: 700; font-size: 11px; letter-spacing: 1px;">OR CONTINUE WITH</p>
                <button type="button" id="google-btn" class="btn btn-secondary btn-block" style="margin-top: 10px; background: white; color: black; border-color: #ddd;">
                    <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" width='18' height='18' alt='Google'>
                    GOOGLE ACCOUNT
                </button>
            </div>
        </form>
        <p>Already have an account? <a href="/login">LOG IN HERE</a></p>
    </div>

    <script>
        window.addEventListener('DOMContentLoaded', () => {
            if (localStorage.getItem('hide_auth_disclaimer') === 'true') {
                const disclaimer = document.getElementById('auth-disclaimer');
                if(disclaimer) {
                    disclaimer.style.display = 'none';
                    document.getElementById('disclaimer-check').required = false;
                }
            }
        });
    </script>

    <!-- Firebase JS SDK -->
    <script type="module">
        import { initializeApp } from 'https://www.gstatic.com/firebasejs/10.8.0/firebase-app.js';
        import { getAuth, createUserWithEmailAndPassword, sendEmailVerification, signInWithPopup, GoogleAuthProvider } from 'https://www.gstatic.com/firebasejs/10.8.0/firebase-auth.js';

        const firebaseConfig = <%- firebase_config_json %>;

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);

        document.getElementById('register-form').addEventListener('submit', async (e) => {
            e.preventDefault();
            const email = document.getElementById('email').value;
            const password = document.getElementById('password').value;
            const errorDiv = document.getElementById('error');
            const submitBtn = document.getElementById('submit-btn');
            
            errorDiv.textContent = '';
            submitBtn.textContent = 'REGISTERING...';
            submitBtn.disabled = true;

            try {
                if (document.getElementById('disclaimer-check') && document.getElementById('disclaimer-check').checked) {
                    localStorage.setItem('hide_auth_disclaimer', 'true');
                }

                // 1. Create User in Firebase Auth
                const userCredential = await createUserWithEmailAndPassword(auth, email, password);
                const user = userCredential.user;

                // 2. Initial user setup (Optional: mark as teacher if needed, or leave for dashboard default)
                // await fetch('/api/set_role', ...);

                // 3. Exchange the short-lived Firebase token for an HTTP-only app session.
                const token = await user.getIdToken();
                const sessionRes = await fetch('/api/login_session', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ token: token, remember_me: true })
                });
                if (!sessionRes.ok) throw new Error('Failed to establish session');
                
                // 4. Redirect to dashboard
                window.location.href = '/';

            } catch (error) {
                if (error.code === 'auth/email-already-in-use') {
                    errorDiv.textContent = 'THIS EMAIL IS ALREADY REGISTERED.';
                } else {
                    errorDiv.textContent = error.message;
                }
                submitBtn.textContent = 'CREATE ACCOUNT';
                submitBtn.disabled = false;
            }
        });

        const googleBtn = document.getElementById('google-btn');
        googleBtn.addEventListener('click', async () => {
            const provider = new GoogleAuthProvider();
            const errorDiv = document.getElementById('error');

            errorDiv.textContent = '';
            googleBtn.disabled = true;
            googleBtn.textContent = 'AUTHENTICATING...';

            try {
                if (document.getElementById('disclaimer-check') && document.getElementById('disclaimer-check').checked) {
                    localStorage.setItem('hide_auth_disclaimer', 'true');
                }

                const result = await signInWithPopup(auth, provider);
                const user = result.user;

                googleBtn.textContent = 'ESTABLISHING SESSION...';

                // Set an HTTP-only server session.
                const token = await user.getIdToken();
                const sessionRes = await fetch('/api/login_session', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ token: token, remember_me: true })
                });
                if (!sessionRes.ok) throw new Error('Failed to establish session');

                window.location.href = '/';
            } catch (error) {
                errorDiv.textContent = error.message;
                googleBtn.disabled = false;
                googleBtn.innerHTML = `
                    <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" width="18" height="18" alt="Google">
                    GOOGLE ACCOUNT
                `;
            }
        });
    </script>
    <script>window.refreshQuizmokoIcons?.();</script>
</body>
</html>
