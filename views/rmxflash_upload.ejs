<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>QuizMoKo - RMXFlash Mode</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/quizmoko-ui.css">
    <script src="/js/quizmoko-theme.js"></script>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>

    <style>
        * { box-sizing: border-box; }

        body { 
            font-family: 'Inter', sans-serif; 
            margin: 0; 
            padding: 40px 20px; 
            color: var(--body-strong); 
            background-color: var(--canvas);
            font-weight: 400;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        .worksheet-panel { margin-bottom: 24px; }
        h1, h2, h3 { color: var(--on-dark); margin-top: 0; }
        .m-stripe { height: 4px; width: 60px; background: var(--primary); border-radius: 2px; margin-bottom: 24px; }

        .dropzone { border: 2px dashed var(--hairline); border-radius: var(--radius-md); padding: 20px; text-align: center; background: var(--surface-soft); cursor: pointer; transition: 0.2s; position: relative; min-height: 100px; display: flex; flex-direction: column; justify-content: center; align-items: center; }
        .dropzone:hover { border-color: var(--primary); background: rgba(99, 102, 241, 0.05); }
        .dropzone input { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }

        #progress-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.9); display: none; flex-direction: column; align-items: center; justify-content: center; z-index: 1000; }
        .progress-box { width: 300px; height: 8px; background: var(--hairline); border-radius: 4px; overflow: hidden; margin-top: 20px; }
        .progress-bar { height: 100%; background: var(--primary); width: 0%; transition: 0.3s; }

        .question-item { background: var(--surface-soft); border: 1px solid var(--hairline); padding: 16px; border-radius: var(--radius-sm); margin-bottom: 16px; font-size: 14px; }
        .meta-row { display: flex; gap: 16px; margin-bottom: 12px; }
        .meta-item { font-size: 11px; color: var(--body); font-weight: 700; text-transform: uppercase; }
        .meta-item b { color: var(--on-dark); }
    </style>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body>
    <div class="top-header-bar" style="max-width: 1800px; margin: 0 auto 32px auto; display: flex; justify-content: space-between; align-items: flex-start; padding: 0;">
        <div>
            <h1 style="margin: 0; color: var(--body-strong); font-weight: 700; font-size: 36px; letter-spacing: -0.5px;" id="dashboard-header">
                <i data-lucide="rocket" class="icon-md" style="margin-right:6px;"></i> QuizMoKo <span style="font-size:16px; color:var(--body); font-weight:400; letter-spacing: 0; vertical-align: middle;">Teacher</span>
            </h1>
        </div>
        <div class="header-nav-actions" style="display: flex; gap: 16px; align-items: center;">
            <% if (typeof is_admin !== 'undefined' && is_admin) { %>
            <a href="/admin" class="btn-secondary" style="text-decoration: none; display: flex; align-items: center; gap: 8px;"><i data-lucide="shield" class="icon-sm"></i> Admin Panel</a>
            <% } %>
            <button type="button" onclick="toggleTheme()" data-theme-toggle title="Toggle Theme" aria-label="Switch to light theme" class="btn btn-ghost btn-icon"><i data-lucide="moon"></i></button>
            <button id="logout-btn" class="btn-logout" onclick="window.location.href='/logout'"><i data-lucide="log-out" class="icon-sm"></i> Logout</button>
        </div>
    </div>

    <div class="dashboard-container teacher-view">
        <div class="sticky-col">
            <div class="mode-tabs">
                <a href="/" class="mode-tab">
                    <span><i data-lucide="bot" class="icon-sm"></i></span>
                    AI GEN
                </a>
                <a href="/worksheet" class="mode-tab">
                    <span><i data-lucide="file-text" class="icon-sm"></i></span>
                    WORKSHEET
                </a>
                <a href="/worksheet_answers" class="mode-tab">
                    <span><i data-lucide="key" class="icon-sm"></i></span>
                    ANSWERS
                </a>
                <% if (typeof is_rmx_authorized === 'undefined' || is_rmx_authorized) { %>
                <a href="/rmxflash" class="mode-tab active" aria-current="page">
                    <span><i data-lucide="zap" class="icon-sm"></i></span>
                    RMXFLASH
                </a>
                <% } %>
            </div>
            <div class="card worksheet-panel" style="border-top-left-radius: 0; border-top-right-radius: 0;">
                <h1><i data-lucide="zap" class="icon-sm"></i> RMXFlash Mode</h1>
                    <div class="m-stripe"></div>

                    <form id="rmx-form" onsubmit="handleExtract(event)">
                        <label for="ws-input">1. Worksheet (Questions)</label>
                        <div class="dropzone">
                            <span><i data-lucide="file-text" class="icon-sm"></i> Upload Files</span>
                            <input type="file" id="ws-input" multiple accept='image/*,.pdf' onchange="updateFiles('ws')">
                        </div>
                        <div id="ws-list" style="margin-bottom: 16px; font-size: 11px;"></div>

                        <label for="ans-input">2. Answer Key (Optional)</label>
                        <div class="dropzone">
                            <span><i data-lucide="key" class="icon-sm"></i> Upload Key</span>
                            <input type="file" id="ans-input" multiple accept='image/*,.pdf' onchange="updateFiles('ans')">
                        </div>
                        <div id="ans-list" style="margin-bottom: 16px; font-size: 11px;"></div>

                        <div style="display: flex; align-items: center; gap: 10px; background: var(--surface-elevated); padding: 12px; border-radius: var(--radius-sm); border: 1px solid var(--hairline); margin-bottom: 16px;">
                            <input type="checkbox" id="use_screenshots" style="width: 18px; height: 18px; cursor: pointer;">
                            <label for="use_screenshots" style="margin: 0; cursor: pointer; text-transform: none; font-size: 13px; color: var(--on-dark);"><i data-lucide="camera" class="icon-sm"></i> Capture Diagrams</label>
                        </div>

                        <label>Model</label>
                        <select id="model_select">
                            <option value="gemini-3.5-flash-lite" selected>Gemini 3.5 Flash Lite</option>
                            <option value="gemini-3.1-flash-lite">Gemini 3.1 Flash Lite</option>
                        </select>

                        <label>Metadata</label>
                        <input type="text" id="year" placeholder="Year (e.g., 2024)">
                        <input type="text" id="test_name" placeholder="Test Name">
                        <input type="text" id="contest" placeholder="Contest">

                        <button type="submit" class="btn btn-primary btn-block" id="extract-btn"><i data-lucide="search" class="icon-sm"></i> EXTRACT & PROCESS</button>
                    </form>
                </div>
            </div>

            <div id="preview-col">
                <div id="empty-state" class="card worksheet-panel" style="text-align: center; padding: 80px;">
                    <span style="font-size: 48px;"><i data-lucide="zap" class="icon-sm"></i></span>
                    <h3 style="color: var(--body);">Extraction results will appear here</h3>
                </div>

                <div id="results-card" class="card worksheet-panel" style="display: none;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                        <h2><i data-lucide="eye" class="icon-sm"></i> Preview</h2>
                        <button onclick="exportToExcel()" class="btn btn-primary" style="width: auto;"><i data-lucide="download" class="icon-sm"></i> Export to Excel</button>
                    </div>
                    <div id="questions-list"></div>
                </div>
            </div>
        </div>

    <div id="progress-overlay">
        <h2 id="progress-text">AI is working...</h2>
        <div class="progress-box"><div class="progress-bar" id="progress-bar"></div></div>
    </div>

    <!-- Cropper Modal -->
    <div id="cropper-modal" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.95); display: none; flex-direction: column; align-items: center; justify-content: center; z-index: 2000; padding: 40px; box-sizing: border-box;">
        <div style="background: var(--surface-card); padding: 24px; border-radius: var(--radius-md); width: 100%; max-width: 900px; max-height: 80vh; display: flex; flex-direction: column;">
            <h2 style="margin-bottom: 8px;"><i data-lucide="scissors" class="icon-sm"></i>️ Refine Screenshot</h2>
            <div style="flex: 1; overflow: hidden; background: #000; border-radius: var(--radius-sm); margin-bottom: 24px;">
                <img id="cropper-image" src='' alt='Cropping Preview' style="max-width: 100%; display: block;">
            </div>
            <div style="display: flex; gap: 12px;">
                <button class="btn btn-primary" onclick="saveCroppedImage()" style="margin: 0; width: auto;"><i data-lucide="check-circle" class="icon-sm"></i> Save Crop</button>
                <button class="btn btn-secondary" onclick="closeCropperModal()" style="margin: 0; width: auto;"><i data-lucide="x-circle" class="icon-sm"></i> Cancel</button>
            </div>
        </div>
    </div>

    <script>
        let extractedQuestions = [];
        let cropper = null;
        let currentCroppingIndex = null;

        function updateFiles(type) {
            const input = document.getElementById(type + '-input');
            const list = document.getElementById(type + '-list');
            list.innerHTML = Array.from(input.files).map(f => `<div>• ${f.name}</div>`).join('');
        }

        async function handleExtract(e) {
            e.preventDefault();
            const wsFiles = document.getElementById('ws-input').files;
            if (wsFiles.length === 0) return alert('Please upload worksheet files.');

            const apiKey = localStorage.getItem('gemini_api_key');
            if (!apiKey) return alert('API Key missing. Set it on the Dashboard.');

            const sessionId = 'rmx_' + Math.random().toString(36).substring(7);
            document.getElementById('progress-overlay').style.display = 'flex';

            const poll = setInterval(async () => {
                try {
                    const res = await fetch(`/api/progress/${sessionId}`);
                    if (!res.ok) return;
                    const contentType = res.headers.get('content-type');
                    if (!contentType || !contentType.includes('application/json')) return;

                    const data = await res.json();
                    if (data.message) document.getElementById('progress-text').innerText = data.message;
                    if (data.percentage) document.getElementById('progress-bar').style.width = data.percentage + '%';
                } catch (e) {}
            }, 2000);

            const formData = new FormData();
            for (let f of wsFiles) formData.append('worksheet_files', f);
            for (let f of document.getElementById('ans-input').files) formData.append('answer_files', f);
            formData.append('api_key', apiKey);
            formData.append('model_name', document.getElementById('model_select').value);
            formData.append('use_screenshots', document.getElementById('use_screenshots').checked);
            formData.append('session_id', sessionId);

            try {
                const res = await fetch('/api/extract_rmxflash', { method: 'POST', body: formData });
                const data = await res.json();
                clearInterval(poll);
                if (data.success) {
                    extractedQuestions = data.questions;
                    renderPreview();
                } else {
                    alert('Error: ' + data.error);
                }
            } catch (err) {
                alert('Request failed');
            } finally {
                document.getElementById('progress-overlay').style.display = 'none';
            }
        }

        function renderPreview() {
            document.getElementById('empty-state').style.display = 'none';
            document.getElementById('results-card').style.display = 'block';
            const list = document.getElementById('questions-list');
            list.innerHTML = extractedQuestions.map((q, i) => {
                const statementText = q.statement || '';
                const imgMatch = statementText.match(/src=["']([^"']+)["']/i);
                const hasImg = !!imgMatch;

                return `
                <div class="question-item">
                    <div class="meta-row">
                        <div class="meta-item">ID: <b>${q.identifier}</b></div>
                        <div class="meta-item">Q#: <b>${q.original_index}</b></div>
                        <div style="flex-grow: 1;"></div>
                        ${hasImg ? `<button onclick="openCropRefiner(${i})" class="btn-secondary" style="font-size: 10px; padding: 4px 8px; width: auto; border-color: var(--warning); color: var(--warning); margin: 0;"><i data-lucide="scissors" class="icon-sm"></i>️ REFINE CROP</button>` : ''}
                    </div>
                    <div style="margin-bottom: 12px; white-space: pre-wrap;">${statementText.replace(/<div class="resizable-image-wrapper">.*?<\/div>\s*<\/div>/is, '').trim()}</div>
                    ${hasImg ? `<div style="margin-top: 12px; padding: 12px; background: var(--canvas); border-radius: var(--radius-sm); border: 1px solid var(--hairline); text-align: center;">${imgMatch[0].includes('data:image') ? `<img src="${imgMatch[1]}" style="max-width: 100%; height: auto;">` : ''}</div>` : ''}
                    ${q.choices && q.choices.length > 0 ? `<div style="font-size: 12px; color: var(--body); margin-bottom: 8px;">Options: ${q.choices.join(' | ')}</div>` : ''}
                    <div style="color: var(--success); font-weight: 700;">Answer: ${q.answer}</div>
                </div>
                `;
            }).join('');
            window.refreshQuizmokoIcons?.();
        }

        function openCropRefiner(index) {
            currentCroppingIndex = index;
            const q = extractedQuestions[index];
            const statementText = q.statement || '';
            const imgMatch = statementText.match(/src=["']([^"']+)["']/i);
            if (!imgMatch) return;

            const modal = document.getElementById('cropper-modal');
            const image = document.getElementById('cropper-image');
            image.src = imgMatch[1];
            modal.style.display = 'flex';

            if (cropper) cropper.destroy();
            setTimeout(() => {
                cropper = new Cropper(image, {
                    viewMode: 1,
                    dragMode: 'move',
                    autoCropArea: 0.9,
                    restore: false,
                    guides: true,
                    center: true,
                    highlight: false,
                    cropBoxMovable: true,
                    cropBoxResizable: true,
                    toggleDragModeOnDblclick: false,
                });
            }, 50);
        }

        function closeCropperModal() {
            document.getElementById('cropper-modal').style.display = 'none';
            if (cropper) {
                cropper.destroy();
                cropper = null;
            }
        }

        function saveCroppedImage() {
            if (!cropper) return;
            const canvas = cropper.getCroppedCanvas({ maxWidth: 2000, maxHeight: 2000, fillColor: '#fff' });
            const newBase64 = canvas.toDataURL('image/png');
            const q = extractedQuestions[currentCroppingIndex];
            const cleanText = q.statement.replace(/<div class="resizable-image-wrapper">.*?<\/div>\s*<\/div>/is, '').trim();
            q.statement = cleanText + `\n<div class="resizable-image-wrapper"><div class="image-content-box" style="width: 100%;"><img src="${newBase64}" alt='Source Diagram'></div></div>`;
            renderPreview();
            closeCropperModal();
        }

        async function exportToExcel() {
            const btn = document.querySelector('button[onclick="exportToExcel()"]');
            btn.innerText = '⏳ Exporting...';
            btn.disabled = true;

            try {
                const res = await fetch('/api/export_rmxflash_excel', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        questions: extractedQuestions,
                        year: document.getElementById('year').value,
                        test_name: document.getElementById('test_name').value,
                        contest: document.getElementById('contest').value
                    })
                });

                if (!res.ok) throw new Error('Export failed');

                const blob = await res.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;

                // Name based on metadata if possible
                const yr = document.getElementById('year').value.trim();
                const tst = document.getElementById('test_name').value.trim();
                const cnt = document.getElementById('contest').value.trim();
                let filename = `${yr}_${tst}_${cnt}`.replace(/[^a-zA-Z0-9]/g, '_').replace(/_+/g, '_').toLowerCase();
                if (!filename || filename === '_') filename = 'rmxflash_export';

                a.download = `${filename}.zip`;
                document.body.appendChild(a);
                a.click();
                a.remove();
            } catch (err) {
                alert('Error during export: ' + err.message);
            } finally {
                btn.innerHTML = '<i data-lucide="download" class="icon-sm"></i> Export to Excel';
                window.refreshQuizmokoIcons?.();
                btn.disabled = false;
            }
        }
    </script>
    <script>window.refreshQuizmokoIcons?.();</script>
</body>
</html>