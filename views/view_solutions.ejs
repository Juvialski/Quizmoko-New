<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>QuizMoKo - Student Solutions</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;800&display=swap" rel="stylesheet">

    <!-- MATHJAX FOR EQUATIONS -->
    <script>
      window.MathJax = {
        tex: { inlineMath: [['$', '$'], ['\\(', '\\)']], displayMath: [['$$', '$$'], ['\\[', '\\]']] },
        startup: { typeset: true }
      };
    </script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <style>
        * { box-sizing: border-box; }

        :root {
            --canvas: #f8fafc; --surface-card: #ffffff; --surface-elevated: #f1f5f9; --surface-soft: #e2e8f0;
            --on-dark: #0f172a; --body: #475569; --body-strong: #1e293b; --hairline: #cbd5e1;
            --primary: #4f46e5; --m-blue-light: #6366f1; --m-blue-dark: #4338ca; --m-red: #f43f5e;
            --success: #10b981; --warning: #fbbf24; --radius-md: 12px; --radius-sm: 8px;
            --shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --wb-height: 350px;
        }

        [data-theme="dark"] {
            --canvas: #0f172a; --surface-card: #1e293b; --surface-elevated: #0f172a; --surface-soft: #1e293b;
            --on-dark: #f8fafc; --body: #94a3b8; --body-strong: #f1f5f9; --hairline: #334155;
            --primary: #818cf8; --m-blue-light: #a5b4fc; --m-blue-dark: #4f46e5; --m-red: #fb7185;
            --success: #34d399; --warning: #fbbf24;
        }

        body { font-family: 'Inter', sans-serif; margin: 0; padding: 40px 20px; color: var(--body-strong); background-color: var(--canvas); line-height: 1.6; transition: 0.3s; overflow-x: hidden;}
        .container { max-width: 900px; margin: auto; width: 100%; }

        .header-card { background: var(--surface-card); padding: 40px; border-radius: var(--radius-md); border: 1px solid var(--hairline); box-shadow: var(--shadow); text-align: center; margin-bottom: 40px; }
        h1 { color: var(--on-dark); font-weight: 800; letter-spacing: -1px; margin-top: 0; font-size: 32px; }
        .m-stripe-divider { height: 4px; width: 80px; background: var(--primary); border-radius: 2px; margin: 20px auto; }

        .score-display { font-size: 48px; font-weight: 800; color: var(--success); margin: 20px 0; font-family: monospace; }
        .student-info { font-size: 18px; color: var(--body); }

        .solution-card { background: var(--surface-card); padding: 32px; border-radius: var(--radius-md); border: 1px solid var(--hairline); box-shadow: var(--shadow); margin-bottom: 32px; }
        .question-header { display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--hairline); padding-bottom: 16px; margin-bottom: 24px; }
        .q-num { font-weight: 800; color: var(--primary); font-size: 20px; }
        .status-badge { padding: 4px 12px; border-radius: 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; }
        .status-correct { background: #dcfce7; color: #166534; }
        .status-wrong { background: #fee2e2; color: #991b1b; }
        .status-grading { background: #fef9c3; color: #854d0e; }

        .question-text { font-size: 19px; color: var(--on-dark); margin-bottom: 24px; padding: 24px; background: var(--surface-elevated); border: 1px solid var(--hairline); border-radius: var(--radius-md); font-weight: 500; white-space: pre-wrap; }
        .workings-title { font-weight: 700; color: var(--on-dark); margin-top: 32px; margin-bottom: 16px; display: flex; align-items: center; gap: 8px; }
        .workings-img { width: 100%; max-width: 100%; height: auto; max-height: var(--wb-height); border: 1px solid var(--hairline); border-radius: var(--radius-sm); margin-bottom: 16px; box-shadow: var(--shadow); background: white; display: block; object-fit: contain;}
        .resizable-image-wrapper { display: flex; justify-content: center; margin: 24px auto; width: 100%; }
        .image-content-box { background: white; padding: 24px; border-radius: var(--radius-md); box-shadow: var(--shadow); display: inline-block; max-width: 200%; }
        .resizable-image-wrapper img { width: 100%; height: auto; display: block; margin: 0 auto; border-radius: var(--radius-sm); }

        .answer-comparison { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 24px; padding: 24px; background: var(--surface-elevated); border-radius: var(--radius-md); border: 1px solid var(--hairline); }
        .ans-box { font-size: 16px; }
        .ans-label { font-weight: 800; color: var(--primary); margin-bottom: 8px; display: block; text-transform: uppercase; font-size: 12px; letter-spacing: 0.5px; }
        .ans-value { color: var(--on-dark); font-weight: 700; font-size: 18px; word-break: break-word; white-space: pre-wrap; }

        .ai-feedback { margin-top: 24px; padding: 16px; background: rgba(99, 102, 241, 0.05); border-left: 4px solid var(--primary); border-radius: 4px; font-size: 14px; color: var(--on-dark); }
        .explanation-box { background: rgba(99, 102, 241, 0.05); border-left: 4px solid var(--primary); padding: 20px; margin-top: 15px; border-radius: 4px; }
        .wb-btn { padding: 8px 12px; border: 1px solid var(--hairline); background: var(--surface-card); cursor: pointer; border-radius: 4px; font-size: 12px; color: var(--on-dark); font-weight: 600; transition: 0.2s; white-space: nowrap;}
        .wb-btn:hover { border-color: var(--primary); }

        .footer { text-align: center; color: var(--body); font-size: 14px; margin-top: 60px; padding-bottom: 40px; }

        .theme-toggle { position: fixed; bottom: 30px; right: 30px; width: 50px; height: 50px; border-radius: 25px; background: var(--primary); color: white; border: none; cursor: pointer; display: flex; align-items: center; justify-content: center; font-size: 24px; box-shadow: var(--shadow); z-index: 100; transition: 0.2s; }
        .theme-toggle:hover { transform: scale(1.1); }

        .pdf-btn { position: fixed; bottom: 30px; right: 100px; padding: 0 20px; height: 50px; border-radius: 25px; background: var(--success); color: white; border: none; cursor: pointer; display: flex; align-items: center; gap: 8px; font-weight: 700; font-size: 14px; box-shadow: var(--shadow); z-index: 100; transition: 0.2s; }
        .pdf-btn:hover { transform: scale(1.05); background: #059669; }

        .height-control-panel { position: fixed; bottom: 100px; right: 30px; background: var(--surface-card); padding: 15px; border-radius: var(--radius-md); border: 1px solid var(--hairline); box-shadow: var(--shadow); z-index: 100; display: flex; flex-direction: column; gap: 10px; min-width: 200px; }
        .height-control-panel label { font-size: 11px; font-weight: 800; color: var(--body); text-transform: uppercase; letter-spacing: 0.5px; }
        .height-slider { width: 100%; cursor: pointer; accent-color: var(--primary); }
        .height-value { font-size: 14px; font-weight: 700; color: var(--on-dark); }

        @media print {
            .container { max-width: 100%; margin: 0; padding: 0; }
            body { padding: 0; background: white !important; color: black !important; }
            .header-card { box-shadow: none; border: none; margin-bottom: 20px; page-break-after: auto; }
            .solution-card {
                border: none;
                box-shadow: none;
                page-break-before: auto;
                page-break-inside: avoid;
                border-bottom: 2px solid #eee;
                border-radius: 0;
                padding: 15px 0;
                margin: 0;
                background: white !important;
                color: black !important;
            }
            .question-text { background: #f9f9f9 !important; border: 1px solid #ddd !important; color: black !important; padding: 15px; margin-bottom: 10px; }
            .answer-comparison { background: #f9f9f9 !important; border: 1px solid #ddd !important; color: black !important; padding: 15px; page-break-inside: avoid; }
            .ans-label { color: #4f46e5 !important; }
            .ans-value { color: black !important; font-size: 16px; }
            .status-badge { border: 1px solid #ccc; background: white !important; color: black !important; }
            .theme-toggle, .pdf-btn, .height-control-panel { display: none !important; }
            .workings-img { page-break-inside: avoid; max-width: 100%; max-height: var(--wb-height); height: auto; display: block; margin: 10px auto; border: 1px solid #ccc; object-fit: contain; }
            .workings-title { margin-top: 15px; margin-bottom: 5px; font-size: 14px; }
        }
    </style>
</head>
<body>
    <div class="height-control-panel">
        <label>Workings Box Height</label>
        <input type="range" min="100" max="800" value="350" class="height-slider" id="height-slider" oninput="updateWbHeight(this.value)">
        <div class="height-value" id="height-val-label">350px</div>
    </div>
    <button class="pdf-btn" id="main-pdf-btn" onclick="downloadThisPageAsPDF()">📄 Save as PDF</button>
    <button class="theme-toggle" onclick="toggleTheme()">🌓</button>

    <div class="container">
        <div class="header-card">
            <h1><%= typeof title !== 'undefined' ? title : '' %></h1>
            <div class="m-stripe-divider"></div>
            <div class="student-info">
                Student Name: <strong id="student-name-header"><%= typeof result.student_name !== 'undefined' ? result.student_name : '' %></strong><br>
                Date: <span id="timestamp-header"><%= typeof result.timestamp !== 'undefined' ? result.timestamp : '' %></span>
            </div>
            <div class="score-display" id="total-score-display"><%= typeof result.score !== 'undefined' ? result.score : '' %> / <%= typeof result.total !== 'undefined' ? result.total : '' %></div>
            <div id="grading-status" style="display:none; color: var(--warning); font-weight: 700; font-size: 14px; margin-top: 10px;">⏳ Grading in progress...</div>

            <div style="margin-top: 20px; display: flex; justify-content: center; gap: 10px;">
                <button id="force-sync-btn" onclick="forceSyncResults()" style="background: var(--surface-soft); color: var(--warning); border: 1px solid var(--warning); padding: 8px 16px; border-radius: 6px; font-size: 13px; font-weight: 700; cursor: pointer; transition: 0.2s;">⚡ FORCE SYNC & REPAIR</button>
            </div>
        </div>

        <div id="solutions-container">
            <% (result && result.details ? result.details : (quiz && quiz.questions ? quiz.questions : [])).forEach((item, itemIdx) => { %>
            <div class="solution-card" id="card-<%= itemIdx %>">
                <div class="question-header">
                    <span class="q-num">Question <%= itemIdx + 1 %></span>
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <span style="font-size: 13px; font-weight: 800; color: var(--body); background: var(--surface-soft); padding: 4px 12px; border-radius: 8px; border: 1px solid var(--hairline);">Points: <%= (item.score_fraction !== undefined ? item.score_fraction : (item.is_correct ? 1 : 0)).toFixed(2) %> / 1.0</span>
                        <span class="status-badge <% if (item.is_correct) { %>status-correct<% } else if (item.correct_answer == 'Finalizing...') { %>status-grading<% } else { %>status-wrong<% } %>" id="status-<%= itemIdx %>">
                            <% if (item.correct_answer == 'Finalizing...') { %>⏳ Finalizing...<% } else if (item.is_correct) { %>✓ Correct<% } else { %>✗ Incorrect<% } %>
                        </span>
                    </div>
                </div>

                <div class="question-text" id="question-text-<%= itemIdx %>">
                    <%= typeof item.question !== 'undefined' ? item.question : '' %>
                </div>

                <% let snapshots = (result && result.solution_snapshots) ? result.solution_snapshots[itemIdx] : null; %>
                <div id="snapshots-container-<%= itemIdx %>">
                    <% if (snapshots && snapshots.length > 0) { %>
                        <div class="workings-title">📝 Workings / Whiteboard Solutions:</div>
                        <% for (let img of snapshots) { %>
                            <img src="<%= img %>" class="workings-img" alt="Student Workings">
                        <% } %>
                    <% } %>
                </div>

                <div class="answer-comparison">
                    <div class="ans-box">
                        <span class="ans-label">Submitted Answer</span>
                        <div class="ans-value" id="user-ans-<%= itemIdx %>">
                            <%= typeof item.user_answer !== 'undefined' ? item.user_answer : '' %>
                        </div>
                    </div>
                    <div class="ans-box">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
                            <span class="ans-label" style="margin-bottom: 0;">Correct Answer</span>
                            <% if (typeof session !== 'undefined' && session.user) { %>
                            <div style="display: flex; gap: 8px; align-items: center;">
                                <button class="edit-btn" onclick="recheckAnswer(<%= itemIdx %>, this)" style="background: transparent; border: none; color: var(--warning); font-size: 11px; cursor: pointer; font-weight: 800;">🔄 RE-CHECK</button>
                            </div>
                            <% } %>
                        </div>
                        <div class="ans-value" id="correct-ans-<%= itemIdx %>">
                            <%= typeof item.correct_answer !== 'undefined' ? item.correct_answer : '' %>
                        </div>
                    </div>
                </div>

                <% const qType = item.type || (typeof quiz !== 'undefined' && quiz && quiz.questions && quiz.questions[itemIdx] ? quiz.questions[itemIdx].type : ''); %>
                <div class="ai-feedback" id="feedback-<%= itemIdx %>" style="display:<% if ((qType === 'open_ended' || qType === 'graphing') && item.ai_feedback && item.ai_feedback.trim()) { %>block<% } else { %>none<% } %>;">
                    <strong>🤖 AI Tutor Feedback:</strong><br>
                    <span class="feedback-text"><%= ((qType === 'open_ended' || qType === 'graphing') && item.ai_feedback) ? item.ai_feedback : '' %></span>
                </div>

                <% if (typeof session === 'undefined' || !session.user) { %>
                <% if (!item.is_correct) { %>
                <div id="student-help-<%= itemIdx %>">
                    <button class="wb-btn" style="margin-top: 15px; width: 100%; border-color: var(--primary); color: var(--primary);"
                        onclick="explainMistakeResults(this)"
                        data-q-idx="<%= itemIdx %>">
                        🤖 AI Tutor: Explain My Mistake
                    </button>
                    <div class="explanation-box" style="display:none;" id="explanation-<%= itemIdx %>"></div>
                </div>
                <% } %>
                <% } %>
            </div>
            <% }); %>
        </div>

        <div class="footer">
            Generated by <strong>QuizMoKo</strong> - High Quality Math Quizzes
        </div>
    </div>

    <script>
        const resultId = "<%= typeof result.id !== 'undefined' ? result.id : '' %>";
        let isComplete = false;
        let isEditing = false;
        let currentAnswersData = {}; // Store raw values for editing

        function explainMistakeResults(btn) {
            const qIdx = btn.getAttribute('data-q-idx');
            const item = initialDetails[qIdx];
            if (!item) return;

            btn.innerText = "GENERATING EXPLANATION..."; btn.disabled = true;
            fetch('/api/explain', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({
                    quiz_id: "<%= typeof result.quiz_id !== 'undefined' ? result.quiz_id : '' %>",
                    question: item.question,
                    user_answer: item.user_answer,
                    correct_answer: item.correct_answer,
                    q_type: item.type || ''
                })
            })
            .then(res => res.json()).then(data => {
                btn.style.display = 'none';
                const box = document.getElementById(`explanation-${qIdx}`);
                if (box) {
                    box.style.display = 'block';
                    box.innerHTML = `<strong>🤖 AI TUTOR:</strong><br><br>` + formatDisplay(data.explanation || "No explanation returned.");
                    if (window.MathJax && MathJax.typesetPromise) MathJax.typesetPromise([box]);
                }
            }).catch(err => {
                btn.innerText = "🤖 AI Tutor: Explain My Mistake";
                btn.disabled = false;
                alert("Failed to generate explanation. Please try again.");
            });
        }

        function startEditAnswer(index) {
            isEditing = true;
            const currentVal = currentAnswersData[index] || "";
            document.getElementById(`correct-ans-${index}`).style.display = 'none';
            document.getElementById(`edit-box-${index}`).style.display = 'block';
            document.getElementById(`edit-input-${index}`).value = currentVal;
        }

        function cancelEditAnswer(index) {
            isEditing = false;
            document.getElementById(`correct-ans-${index}`).style.display = 'block';
            document.getElementById(`edit-box-${index}`).style.display = 'none';
        }

        async function saveEditAnswer(index) {
            const newVal = document.getElementById(`edit-input-${index}`).value;
            const saveBtn = document.querySelector(`#edit-box-${index} button:first-child`);
            const originalText = saveBtn.innerText;

            saveBtn.innerText = "SAVING...";
            saveBtn.disabled = true;

            try {
                const res = await fetch(`/api/results/${resultId}/edit_answer`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ q_index: index, new_correct_answer: newVal })
                });

                // If not 200 OK, handle based on status code or try to parse error
                if (!res.ok) {
                    let errorMsg = `Server error (${res.status})`;
                    try {
                        const errData = await res.json();
                        errorMsg = errData.error || errorMsg;
                    } catch(e) {}
                    alert("Error: " + errorMsg);
                    return;
                }

                const data = await res.json();
                if (data.success) {
                    currentAnswersData[index] = newVal;
                    const displayHtml = formatDisplay(newVal);
                    console.log(`[DEBUG] New Display HTML for index ${index}:`, displayHtml);

                    document.getElementById(`correct-ans-${index}`).innerHTML = displayHtml;
                    cancelEditAnswer(index);

                    // Trigger MathJax re-render
                    if (window.MathJax && window.MathJax.typesetPromise) {
                        console.log("[DEBUG] Triggering MathJax re-typeset...");
                        MathJax.typesetPromise([document.getElementById(`correct-ans-${index}`)]).then(() => {
                            console.log("[DEBUG] MathJax re-typeset complete.");
                        }).catch((err) => console.error("[DEBUG] MathJax Error:", err));
                    } else {
                        console.warn("[DEBUG] MathJax not loaded or typesetPromise missing.");
                    }

                    // --- NEW: AUTO RE-CHECK AFTER EDIT ---
                    // Since we changed the answer key, we should re-evaluate the student's answer immediately
                    recheckAnswer(index);

                } else {
                    alert("Error saving: " + (data.error || "Unknown error"));
                }
            } catch (e) {
                console.error("Save error:", e);
                alert("Network or Connection error while saving. Please check your internet or session.");
            } finally {
                saveBtn.innerText = originalText;
                saveBtn.disabled = false;
            }
        }

        async function recheckAnswer(index, btn = null) {
            const targetBtn = btn || document.querySelector(`#card-${index} .edit-btn[onclick*="recheckAnswer"]`);
            const originalText = targetBtn ? targetBtn.innerText : "🔄 RE-CHECK";

            if (targetBtn) {
                targetBtn.innerText = "⌛ RE-CHECKING...";
                targetBtn.disabled = true;
            }

            try {
                const res = await fetch(`/api/results/${resultId}/recheck`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ q_index: index })
                });

                const data = await res.json();
                if (data.success) {
                    // 1. Update Status Badge
                    const statusBadge = document.getElementById(`status-${index}`);
                    statusBadge.className = `status-badge ${data.is_correct ? 'status-correct' : 'status-wrong'}`;
                    statusBadge.innerText = data.is_correct ? '✓ Correct' : '✗ Incorrect';

                    // Update Point display in parent
                    const pointBox = statusBadge.parentElement.querySelector('span[style*="background: var(--surface-soft)"]');
                    if (pointBox) pointBox.innerText = `Points: ${data.score_fraction.toFixed(2)} / 1.0`;

                    // 2. Update Total Score Header
                    const resDoc = await fetch(`/api/get_result/${resultId}`).then(r => r.json());
                    document.getElementById('total-score-display').innerText = `${resDoc.score} / ${resDoc.total}`;

                    // 3. Update AI Feedback if any
                    const feedbackBox = document.getElementById(`feedback-${index}`);
                    if (data.ai_feedback) {
                        feedbackBox.style.display = 'block';
                        feedbackBox.querySelector('.feedback-text').innerHTML = formatDisplay(data.ai_feedback);
                    } else {
                        feedbackBox.style.display = 'none';
                    }

                    // 4. Highlight success
                    if (targetBtn) {
                        targetBtn.style.color = "var(--success)";
                        setTimeout(() => {
                            targetBtn.innerText = originalText;
                            targetBtn.disabled = false;
                            targetBtn.style.color = "var(--warning)";
                        }, 2000);
                    }
                } else {
                    alert("Re-check failed: " + data.error);
                }
            } catch (e) {
                console.error("Recheck error:", e);
                alert("Network error while re-checking.");
            } finally {
                if (targetBtn && targetBtn.innerText === "⌛ RE-CHECKING...") {
                    targetBtn.innerText = originalText;
                    targetBtn.disabled = false;
                }
            }
        }

        async function reprocessAnswers(qIndex = null, btn = null) {
            const isAll = (qIndex === null);
            const targetBtn = btn || document.getElementById('reprocess-all-btn');
            const originalText = targetBtn.innerText;

            if (isAll && !confirm("Re-format all Open Ended answers into high-quality bullet points?")) return;

            targetBtn.innerText = "🪄 RE-FORMATTING...";
            targetBtn.disabled = true;

            try {
                const res = await fetch(`/api/results/${resultId}/reprocess_answers`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ q_index: qIndex })
                });

                const data = await res.json();
                if (data.success) {
                    // Update the local data and UI
                    data.details.forEach((item, i) => {
                        currentAnswersData[i] = item.correct_answer;
                        const box = document.getElementById(`correct-ans-${i}`);
                        if (box) box.innerHTML = formatDisplay(item.correct_answer);
                    });
                    // Re-run MathJax
                    if (window.MathJax && window.MathJax.typesetPromise) MathJax.typesetPromise();
                    if (!isAll) alert("Answer re-formatted successfully!");
                } else {
                    alert("Re-format failed: " + (data.error || "Unknown error"));
                }
            } catch (e) {
                console.error("Reprocess error:", e);
                alert("Network error during re-formatting.");
            } finally {
                targetBtn.innerText = originalText;
                targetBtn.disabled = false;
            }
        }

        function updateWbHeight(val) {
            document.documentElement.style.setProperty('--wb-height', val + 'px');
            document.getElementById('height-val-label').innerText = val + 'px';
        }

        function toggleTheme() {
            const current = document.documentElement.getAttribute('data-theme');
            const next = current === 'dark' ? 'light' : 'dark';
            document.documentElement.setAttribute('data-theme', next);
            localStorage.setItem('theme', next);
        }

        // Initialize Theme
        const savedTheme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', savedTheme);

        function formatDisplay(val) {
            if (!val) return "";

            // 1. Unpack JSON Objects/Lists (if any)
            let data = val;
            if (typeof val === 'string' && (val.trim().startsWith('{') || val.trim().startsWith('['))) {
                try {
                    let jsonStr = val.replace(/'/g, '"');
                    data = JSON.parse(jsonStr);
                } catch(e) {}
            }

            if (typeof data === 'object' && data !== null) {
                if (Array.isArray(data)) {
                    return '<ul style="margin: 5px 0; padding-left: 20px;">' +
                           data.map(v => `<li>${formatDisplay(v)}</li>`).join('') +
                           '</ul>';
                }
                let html = '<ul style="margin: 5px 0; padding-left: 20px;">';
                for (const [k, v] of Object.entries(data)) {
                    html += `<li><strong>${k.charAt(0).toUpperCase() + k.slice(1)}:</strong> ${formatDisplay(v)}</li>`;
                }
                return html + '</ul>';
            }

            // 2. Pure Standard Mode with Identical Line Break Logic to Edit/Quiz Page
            let str = String(data);

            // FIX: Sanitization was stripping \n (0x0A) and \r (0x0D)!
            // We only strip truly non-printable control characters, but PRESERVE \n, \r, and \t
            str = str.replace(/[\x00-\x09\x0B-\x0C\x0E-\x1F\x7F-\x9F]/g, '');

            // Use the same logic as the Quiz/Edit pages: split by image blocks and replace \n with <br>
            const parts = str.split(/(<div class="resizable-image-wrapper"[\s\S]*?<\/div>)/gi);
            return parts.map(part => {
                if (part.startsWith('<div class="resizable-image-wrapper"')) return part;

                // Process bullets and line breaks in the text parts
                // Use a regex to catch both Windows (\r\n) and Unix (\n) line endings
                const lines = part.split(/\r?\n/);
                return lines.map(line => {
                    const trimmedLine = line.trim();
                    if (trimmedLine.startsWith('- ') || trimmedLine.startsWith('* ')) {
                        return `• ${trimmedLine.substring(2)}`;
                    }
                    return line;
                }).join('<br>');
            }).join('');
        }

        async function forceSyncResults() {
            const btn = document.getElementById('force-sync-btn');
            const originalText = btn.innerText;
            btn.innerText = "⚡ REPAIRING...";
            btn.disabled = true;

            try {
                // Reset completion flag to allow pollResults to run once more and update UI
                isComplete = false;
                await pollResults();

                // Add a small delay for visual feedback
                await new Promise(r => setTimeout(r, 1000));

                if (!isComplete) {
                    alert("Sync completed, but some items might still be grading. Try again in a few seconds.");
                } else {
                    btn.style.borderColor = "var(--success)";
                    btn.style.color = "var(--success)";
                    btn.innerText = "✅ REPAIRED";
                }
            } catch (err) {
                console.error("Force sync failed:", err);
                alert("Failed to sync: " + err.message);
            } finally {
                setTimeout(() => {
                    btn.innerText = originalText;
                    btn.disabled = false;
                    btn.style.borderColor = "var(--warning)";
                    btn.style.color = "var(--warning)";
                }, 3000);
            }
        }

        async function pollResults() {
            if (isComplete) return;
            try {
                const res = await fetch(`/api/get_result/${resultId}`);
                const data = await res.json();
                if (data.error) return;

                document.getElementById('total-score-display').innerText = `${data.score} / ${data.total}`;

                let stillGrading = false;
                data.details.forEach((item, i) => {
                    const statusBadge = document.getElementById(`status-${i}`);
                    const qTextBox = document.getElementById(`question-text-${i}`);
                    const userAnsBox = document.getElementById(`user-ans-${i}`);
                    const correctAnsBox = document.getElementById(`correct-ans-${i}`);
                    const feedbackBox = document.getElementById(`feedback-${i}`);
                    const snapContainer = document.getElementById(`snapshots-container-${i}`);

                    if (qTextBox) qTextBox.innerHTML = formatDisplay(item.question);
                    if (userAnsBox) userAnsBox.innerHTML = formatDisplay(item.user_answer);

                    // Track raw data for editing
                    currentAnswersData[i] = item.correct_answer;

                    // Update snapshots if any
                    const snaps = (data.solution_snapshots && data.solution_snapshots[String(i)]) ? data.solution_snapshots[String(i)] : null;
                    if (snaps && snaps.length > 0) {
                        let snapHtml = '<div class="workings-title">📝 Workings / Whiteboard Solutions:</div>';
                        snaps.forEach(img => {
                            snapHtml += `<img src="${img}" class="workings-img" alt="Student Workings">`;
                        });
                        // Only update if changed to avoid unnecessary re-renders
                        if (snapContainer.innerHTML.trim() !== snapHtml.trim()) {
                            snapContainer.innerHTML = snapHtml;
                        }
                    }

                    if (item.correct_answer === 'Finalizing...') {
                        stillGrading = true;
                        correctAnsBox.innerHTML = "⏳ Finalizing...";
                    } else {
                        // Update Status
                        statusBadge.className = `status-badge ${item.is_correct ? 'status-correct' : 'status-wrong'}`;
                        statusBadge.innerText = item.is_correct ? '✓ Correct' : '✗ Incorrect';

                        // Update Correct Answer
                        correctAnsBox.innerHTML = formatDisplay(item.correct_answer);

                        // Update Feedback
                        if (item.ai_feedback) {
                            feedbackBox.style.display = 'block';
                            feedbackBox.querySelector('.feedback-text').innerHTML = formatDisplay(item.ai_feedback);
                        }
                    }
                });

                document.getElementById('grading-status').style.display = stillGrading ? 'block' : 'none';

                if (!stillGrading) {
                    isComplete = true;
                    console.log("[POLLING] Grading complete.");
                } else {
                    setTimeout(pollResults, 3000);
                }

                // Re-run MathJax
                if (window.MathJax && MathJax.typesetPromise) {
                    MathJax.typesetPromise();
                }

            } catch (e) {
                console.error("Polling error:", e);
                setTimeout(pollResults, 5000);
            }
        }

        // Start polling or initial render
        const initialDetails = <%- JSON.stringify(result.details) %>;
        initialDetails.forEach((item, i) => {
            currentAnswersData[i] = item.correct_answer; // Store for edit
            const qTextBox = document.getElementById(`question-text-${i}`);
            if (qTextBox) qTextBox.innerHTML = formatDisplay(item.question);

            document.getElementById(`user-ans-${i}`).innerHTML = formatDisplay(item.user_answer);
            document.getElementById(`correct-ans-${i}`).innerHTML = formatDisplay(item.correct_answer);
            if (item.ai_feedback) {
                document.getElementById(`feedback-${i}`).querySelector('.feedback-text').innerHTML = formatDisplay(item.ai_feedback);
            }
        });

        if (initialDetails.some(d => d.correct_answer === 'Finalizing...')) {
            document.getElementById('grading-status').style.display = 'block';
            setTimeout(pollResults, 1000);
        } else {
            // Ensure MathJax runs on initial render
            if (window.MathJax && MathJax.typesetPromise) {
                MathJax.typesetPromise();
            }

            // AUTO-PDF if requested via URL
            if (window.location.search.includes('download=true')) {
                setTimeout(downloadThisPageAsPDF, 1500);
            }
        }

        async function downloadThisPageAsPDF() {
            const btn = document.getElementById('main-pdf-btn');
            const originalText = btn.innerHTML;
            btn.innerText = "⏳ Preparing for Print...";
            btn.disabled = true;

            try {
                // Ensure MathJax is finished
                if (window.MathJax && MathJax.typesetPromise) {
                    await MathJax.typesetPromise();
                }

                // Small delay to ensure images are painted
                await new Promise(resolve => setTimeout(resolve, 500));

                // NEW RELIABLE STRATEGY: Use Browser's Native Print
                // This is 100% immune to "blank canvas" issues
                window.print();

            } catch (err) {
                console.error("Print failed:", err);
                window.print();
            } finally {
                btn.innerHTML = originalText;
                btn.disabled = false;
            }
        }
    </script>
</body>
</html>
