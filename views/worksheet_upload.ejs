            <% } %>
            <button type="button" onclick="toggleTheme()" data-theme-toggle title="Toggle Theme" aria-label="Switch to light theme" class="btn btn-ghost btn-icon"><i data-lucide="moon"></i></button>
            <button id="logout-btn" class="btn-logout" onclick="window.location.href='/logout'"><i data-lucide="log-out" class="icon-sm"></i> Logout</button>
        </div>
