                <a href="/worksheet" class="mode-tab active" aria-current="page">
                    <span><i data-lucide="file-text" class="icon-sm"></i></span>
                    WORKSHEET
                </a>
                <a href="/worksheet_answers" class="mode-tab">
                    <span><i data-lucide="key" class="icon-sm"></i></span>
                    ANSWERS
                </a>
                <% if (typeof is_rmx_authorized === 'undefined' || is_rmx_authorized) { %>
                <a href="/rmxflash" class="mode-tab">
                    <span><i data-lucide="zap" class="icon-sm"></i></span>
                    RMXFLASH
                </a>
                <% } %>
            </div>
                <div class="card worksheet-panel" id="upload-card" style="border-top-left-radius: 0; border-top-right-radius: 0;">
                    <h1><i data-lucide="file-text" class="icon-sm"></i> Worksheet to Quiz</h1>
                    <ol class="r4-steps" aria-label="Worksheet workflow"><li>Upload</li><li>Review extraction</li><li>Check answers</li><li>Create draft</li><li>Review and publish</li></ol>
                    <p class="r4-muted">PNG, JPEG, WebP, GIF or PDF. Default limits: 12 files, 20 MB each, 60 MB total and 40 pages per upload. Larger files may need splitting; server limits still apply.</p>
                    <div class="m-stripe"></div>
                    <p style="color: var(--body); margin-bottom: 32px;">Convert your existing worksheet images or PDFs into a live, interactive quiz with AI.</p>

                    <form id="worksheet-form" onsubmit="handleExtract(event)">
                        <label for="file-input">Step 1: Upload Files (Images or PDF)</label>
                        <div class="dropzone" id="dropzone">
                            <div style="font-size: 40px; margin-bottom: 8px;"><i data-lucide="upload" class="icon-sm"></i></div>
                            <div style="font-weight: 700;">Click, Drag, or Paste Worksheet Files</div>
                            <div style="font-size: 12px; color: var(--body); margin-top: 4px;">Supports PNG, JPEG, WebP, GIF, and PDF</div>
