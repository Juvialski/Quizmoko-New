                        </div>
                        <div class="file-list" id="file-list"></div>

<details class="r4-details"><summary>Extraction options</summary>                        <div style="margin-top: 24px; display: grid; grid-template-columns: 1fr; gap: 16px;">
                            <div style="display: flex; align-items: center; gap: 10px; background: var(--surface-elevated); padding: 12px; border-radius: var(--radius-sm); border: 1px solid var(--hairline);">
                                <input type="checkbox" id="use_screenshots" style="width: 18px; height: 18px; cursor: pointer;">
                                <label for="use_screenshots" style="margin: 0; cursor: pointer; text-transform: none; letter-spacing: normal; font-size: 13px; color: var(--on-dark);"><i data-lucide="camera" class="icon-sm"></i> Keep source images for diagrams</label>
                            </div>
                            <div>
                                <label>AI Model</label>
                                <div style="display: grid; grid-template-columns: 1fr 120px; gap: 10px; align-items: center;">
                                    <select id="model_select" onchange="updateCounterUI()">
                                        <option value="gemini-3.5-flash-lite" selected>Gemini 3.5 Flash Lite (Best limits)</option>
                                        <option value="gemini-3.1-flash-lite">Gemini 3.1 Flash Lite</option>
                                    </select>
                                    <div id="api-counter-badge" style="background: var(--surface-soft); color: var(--on-dark); padding: 8px; border: 1px solid var(--hairline); font-weight: 700; white-space: nowrap; font-size: 10px; text-align: center; text-transform: uppercase; border-radius: var(--radius-sm);">
                                        Quota unavailable
                                    </div>
                                </div>
                            </div>
                            <div>
                                <label>Topic / Hint</label>
                                <input type="text" id="topic_hint" placeholder="e.g. Algebra 1 Worksheet">
                            </div>
                            <div>
                                <label>Subject Type (Optimization)</label>
                                <select id="subject_input">
                                    <option value="General" selected>General (Safe - Handles Math & Text)</option>
                                    <option value="Math">Mathematics / Calculus</option>
                                    <option value="Science">Science / Physics / Chemistry</option>
                                    <option value="English">English / Literature (No Math)</option>
                                    <option value="History">History / Social Studies (No Math)</option>
                                    <option value="Biology">Biology (No Math)</option>
                                </select>
                                <p style="font-size: 10px; color: var(--body); margin-top: 4px; opacity: 0.85;">Choosing a specific non-math subject improves extraction quality for text-heavy content.</p>
                            </div>
                        </div>

</details>                        <button type="submit" class="btn btn-primary btn-block" id="extract-btn" style="margin-top: 16px;"><i data-lucide="search" class="icon-sm"></i> EXTRACT QUESTIONS</button>
                    </form>
                </div>
            </div>

            <div id="right-col">
                <div id="extraction-preview" class="card worksheet-panel" style="margin-top: 0;">
                    <h2><i data-lucide="edit-3" class="icon-sm"></i> Review Extraction</h2>
                    <div class="m-stripe"></div>
                    <p style="font-size: 14px; color: var(--body); margin-bottom: 24px;">Review the extracted questions below. If everything looks good, proceed to solve and generate the quiz.</p>

                    <div id="questions-list"></div>

                    <div id="missing-alert" style="display: none; background: rgba(251, 113, 133, 0.1); border: 1px solid var(--m-red); border-radius: var(--radius-sm); padding: 12px; margin-top: 16px; color: var(--m-red); font-size: 13px; display: flex; align-items: center; justify-content: space-between;">
                        <span><i data-lucide="alert-triangle" class="icon-sm"></i>️ Missing or Incomplete (Null Answers) detected: <b id="missing-indices-text"></b></span>
                        <button onclick="handleTargetedRetry()" class="btn-secondary" id="retry-recovery-btn" style="padding: 6px 12px; font-size: 11px; margin: 0; border-color: var(--m-red); color: var(--m-red);"><i data-lucide="search" class="icon-sm"></i> Targeted Recovery</button>
                    </div>

                    <div style="margin-top: 32px; padding-top: 24px; border-top: 1px solid var(--hairline);">
                        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 16px;">
                            <div>
                                <label>Solve Batch Size</label>
                                <input type="number" id="batch_size" value="3" min='1' max='10'>
                            </div>
                            <div>
                                <label>Sec/Question</label>
                                <input type="number" id="time_limit" value="20">
                            </div>
                            <div>
                                <label>Quiz Mode</label>
                                <select id="quiz_mode">
                                    <option value="sequential">Sequential</option>
                                    <option value="back_and_forth" selected>Back-and-Forth</option>
                                </select>
                            </div>
                        </div>

                        <div style="margin-bottom: 24px; display: flex; align-items: center; gap: 10px; background: var(--surface-soft); padding: 16px; border: 1px solid var(--hairline); border-radius: var(--radius-md);">
                            <input type="checkbox" id="require_solution" style="width: 20px; height: 20px; cursor: pointer;">
                            <label for="require_solution" style="margin: 0; cursor: pointer; font-size: 15px; color: var(--on-dark);"><i data-lucide="edit-3" class="icon-sm"></i> Require Solution for All Questions</label>
                        </div>

                        <section id="worksheet-solve-progress" class="qm-owned-tasks" role="status" aria-live="polite" hidden></section>
                        <button onclick="handleSolve()" class="btn btn-primary btn-block" id="solve-btn"><i data-lucide="sparkles" class="icon-sm"></i> CHECK ANSWERS & CREATE DRAFT</button>
                    </div>
                </div>

                <!-- Empty State for Right Column -->
                <div id="empty-preview" class="card worksheet-panel" style="margin-top: 0; text-align: center; padding: 100px 40px;">
                    <div style="font-size: 64px; margin-bottom: 24px; opacity: 0.3;"><i data-lucide="file-text" class="icon-sm"></i></div>
                    <h3 style="color: var(--body);">Your questions will appear here</h3>
                    <p style="color: var(--body); font-size: 14px;">Upload your worksheet on the left to begin.</p>
                </div>
            </div>
        </div>

    <div id="progress-overlay">
        <h2 id="progress-text" style="color: white; margin: 0;">Processing...</h2>
        <div class="progress-box">
            <div class="progress-bar" id="progress-bar"></div>
        </div>
        <p id="progress-subtext" style="color: var(--body); margin-top: 12px; font-size: 14px;">This may take a minute depending on worksheet size.</p>
    </div>

    <!-- Cropper Modal -->
    <div id="cropper-modal">
        <div class="cropper-container-box">
            <h2 style="margin-bottom: 8px;"><i data-lucide="scissors" class="icon-sm"></i>️ Refine Screenshot</h2>
            <p style="color: var(--body); font-size: 13px; margin-bottom: 20px;">Adjust the crop to remove extra text or whitespace around the diagram.</p>
            <div class="cropper-image-wrapper">
                <img id="cropper-image" src=''>
            </div>
            <div style="display: flex; gap: 12px;">
                <button class="btn btn-primary" onclick="saveCroppedImage()" style="margin: 0;"><i data-lucide="check-circle" class="icon-sm"></i> Save Crop</button>
                <button class="btn btn-secondary" onclick="closeCropperModal()" style="margin: 0;"><i data-lucide="x-circle" class="icon-sm"></i> Cancel</button>
            </div>
