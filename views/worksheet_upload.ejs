    <script>
        const dropzone = document.getElementById('dropzone');
        const fileInput = document.getElementById('file-input');
        const fileListContainer = document.getElementById('file-list');
        const overlay = document.getElementById('progress-overlay');
        const progressBar = document.getElementById('progress-bar');
        const progressText = document.getElementById('progress-text');

        // --- RATE LIMIT TRACKER LOGIC ---
        const API_LIMITS = {
            'gemini-3.5-flash-lite': 500,
            'gemini-3.1-flash-lite': 500
        };

        let GLOBAL_DAILY_STATS = {};

        async function getHash(text) {
            if (!text) return 'default';
            const msgUint8 = new TextEncoder().encode(text);
            const hashBuffer = await crypto.subtle.digest('SHA-256', msgUint8);
            const hashArray = Array.from(new Uint8Array(hashBuffer));
            const hashHex = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
            return hashHex.substring(0, 8);
        }

        async function fetchUsageStats() {
            try {
                const res = await fetch('/api/usage/stats');
                const data = await res.json();
                if (data.success) {
                    GLOBAL_DAILY_STATS = data.daily_stats;
                    updateCounterUI();
                }
            } catch (e) {
                console.error('Failed to fetch usage stats:', e);
            }
        }

        async function updateCounterUI() {
            let model = document.getElementById('model_select').value;
            // Provider quota is unavailable; the legacy usage endpoint returns no accounting.
            const badge = document.getElementById('api-counter-badge');
            if (badge) {
                badge.textContent = model.startsWith('ollama:') ? 'Local model' : 'Quota unavailable';
                badge.title = 'Provider quota is not tracked here. Requests may be queued or rate limited.';
                badge.style.color = 'var(--body)';
                badge.style.borderColor = 'var(--hairline)';
            }
        }

        async function getUsableKey(model, needed = 1) {
            const keys = JSON.parse(localStorage.getItem('gemini_api_keys') || '[]');
            if (keys.length === 0 && localStorage.getItem('gemini_api_key')) keys.push(localStorage.getItem('gemini_api_key'));

            const today = new Date().toISOString().split('T')[0];
            const modelStats = (GLOBAL_DAILY_STATS[today] && GLOBAL_DAILY_STATS[today][model]) || {};
            const baseLimit = API_LIMITS[model] || 20;

            for (const key of keys) {
                const kid = await getHash(key);
                const used = modelStats[kid] || 0;
                if (used + needed <= baseLimit) return key;
            }
            return keys[0] || null;
        }

        window.addEventListener('DOMContentLoaded', fetchUsageStats);

        let extractedQuestions = [];
        let missingIndices = [];
        let pastedFiles = [];

        function getSourceQuestionId(question, fallback = '') {
            const value = question?.source?.original_index
                ?? question?.original_index
                ?? question?.source_id
                ?? fallback;
            return String(value ?? '').trim();
        }

        const sourceSuffixCollator = new Intl.Collator('en', { numeric: true, sensitivity: 'base' });
        const sourcePrefixPattern = /^(?:(?:question|q)\s*[:#.-]?\s*|#\s*)/i;

        function sourceIdForComparison(value) {
            if (typeof value === 'string' || typeof value === 'number' || typeof value === 'bigint') {
                return String(value).trim();
            }
            return getSourceQuestionId(value);
        }

        function romanIdentifierValue(value) {
            const normalized = String(value || '').toUpperCase();
            if (!/^(?=.)M{0,3}(CM|CD|D?C{0,3})(XC|XL|L?X{0,3})(IX|IV|V?I{0,3})$/.test(normalized)) return null;
            const values = { I: 1, V: 5, X: 10, L: 50, C: 100, D: 500, M: 1000 };
            let total = 0;
            for (let index = 0; index < normalized.length; index += 1) {
                const current = values[normalized[index]];
                const next = values[normalized[index + 1]] || 0;
                total += current < next ? -current : current;
            }
            return total > 0 ? total : null;
        }

        function parseSourceIdentifier(value) {
            const raw = sourceIdForComparison(value);
            const comparable = raw.replace(sourcePrefixPattern, '').trim();
            const match = comparable.match(/^(\d+)(.*)$/);
            if (match) {
                return {
                    parsed: true,
                    digits: match[1].replace(/^0+(?=\d)/, '') || '0',
                    suffix: match[2].trim()
                };
            }
            const romanMatch = comparable.match(/^\(?([IVXLCDM]+)\)?(.*)$/i);
            if (romanMatch && (!romanMatch[2] || /^[.):\-]/.test(romanMatch[2].trim()))) {
                const roman = romanIdentifierValue(romanMatch[1]);
                if (roman !== null) return { parsed: true, digits: String(roman), suffix: romanMatch[2].trim() };
            }
            return { parsed: false, digits: '', suffix: '' };
        }

        function compareSourceIdentifiers(left, right) {
            const leftKey = parseSourceIdentifier(left);
            const rightKey = parseSourceIdentifier(right);
            if (leftKey.parsed !== rightKey.parsed) return leftKey.parsed ? -1 : 1;
            if (!leftKey.parsed) return 0;
            if (leftKey.digits.length !== rightKey.digits.length) {
                return leftKey.digits.length - rightKey.digits.length;
            }
            const numericComparison = leftKey.digits.localeCompare(rightKey.digits);
            if (numericComparison !== 0) return numericComparison;
            return sourceSuffixCollator.compare(leftKey.suffix, rightKey.suffix);
        }

        function sourceIdentifierMatchKey(value) {
            const raw = sourceIdForComparison(value);
            const comparable = raw.replace(sourcePrefixPattern, '').trim();
            const match = comparable.match(/^(\d+)(.*)$/);
            if (match) return `numeric:${match[1]}:${match[2].trim().toLowerCase()}`;
            const romanMatch = comparable.match(/^\(?([IVXLCDM]+)\)?(.*)$/i);
            if (romanMatch && (!romanMatch[2] || /^[.):\-]/.test(romanMatch[2].trim()))) {
                const roman = romanIdentifierValue(romanMatch[1]);
                if (roman !== null) {
                    return `roman:${romanMatch[1].toUpperCase()}:${romanMatch[2].trim().toLowerCase()}`;
                }
            }
            return `text:${comparable.toLowerCase()}`;
        }

        function sourceIdentifiersEqual(left, right) {
            return sourceIdentifierMatchKey(left) === sourceIdentifierMatchKey(right);
        }

        function sortSourceIdentifiers(values) {
            return values
                .map((value, index) => ({ value, index }))
                .sort((left, right) => compareSourceIdentifiers(left.value, right.value) || left.index - right.index)
                .map(item => item.value);
        }

        function sortExtractedQuestions() {
            const sorted = sortSourceIdentifiers(extractedQuestions);
            extractedQuestions.splice(0, extractedQuestions.length, ...sorted);
        }

        function normalizeQuestionEditorText(value) {
            const source = String(value == null ? '' : value);
            if (window.QuizMoKoMath && typeof window.QuizMoKoMath.normalizeQuestionLayoutText === 'function') {
                return window.QuizMoKoMath.normalizeQuestionLayoutText(source);
            }
            return source;
        }

        function updateFileList() {
            window.worksheetRecoveryId=undefined; window.worksheetIncomplete=false;
            fileListContainer.innerHTML = '';

            // Show files from the input
            for (let [fileIndex,file] of Array.from(fileInput.files).entries()) {
                const tag = document.createElement('div');
                tag.className = 'file-tag';
                tag.innerText = file.name;
                const remove = document.createElement('button'); remove.type='button'; remove.className='btn btn-secondary';
                remove.textContent='Remove'; remove.setAttribute('aria-label','Remove '+file.name);
                remove.onclick=()=>{const transfer=new DataTransfer(); Array.from(fileInput.files).forEach((f,i)=>{if(i!==fileIndex) transfer.items.add(f);}); fileInput.files=transfer.files;updateFileList();}; tag.appendChild(remove);
                fileListContainer.appendChild(tag);
            }

            // Show pasted files
            pastedFiles.forEach((file, index) => {
                const tag = document.createElement('div');
                tag.className = 'file-tag';
                tag.style.borderColor = 'var(--primary)';
                tag.textContent=file.name;
                const remove=document.createElement('button');remove.type='button';remove.textContent='Remove';remove.className='btn btn-secondary';remove.onclick=()=>removePasted(index);tag.appendChild(remove);
                fileListContainer.appendChild(tag);
            });
            window.refreshQuizmokoIcons?.();
        }

        function removePasted(index) {
            pastedFiles.splice(index, 1);
            updateFileList();
        }

        // --- PASTE FUNCTIONALITY ---
        window.addEventListener('paste', e => {
            const items = (e.clipboardData || e.originalEvent.clipboardData).items;
            let foundImage = false;
            for (let item of items) {
                if (item.type.indexOf('image') !== -1) {
                    const blob = item.getAsFile();
                    const timestamp = new Date().getTime();
                    const file = new File([blob], `pasted-image-${timestamp}.png`, { type: 'image/png' });
                    pastedFiles.push(file);
                    foundImage = true;
                }
            }
            if (foundImage) updateFileList();
        });

        ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
            dropzone.addEventListener(eventName, e => { e.preventDefault(); e.stopPropagation(); });
        });

        dropzone.addEventListener('dragover', () => dropzone.classList.add('dragover'));
        dropzone.addEventListener('dragleave', () => dropzone.classList.remove('dragover'));
        dropzone.addEventListener('drop', e => {
            dropzone.classList.remove('dragover');
            fileInput.files = e.dataTransfer.files;
            updateFileList();
        });

        let isExtracting = false;
        async function handleExtract(e) {
            if (e) e.preventDefault();
            if (isExtracting) return;
            if (fileInput.files.length === 0 && pastedFiles.length === 0) return alert('Please upload or paste at least one file.');

            const model = document.getElementById('model_select').value;
            const isLocal = model.startsWith('ollama:');
            const apiKey = isLocal ? null : await getUsableKey(model, 1);

            if (!isLocal && !apiKey) return alert('No API keys with remaining quota found today. Please add more keys or wait for reset.');

            isExtracting = true;
            const extractBtn = document.getElementById('extract-btn');
            if (extractBtn) {
                extractBtn.disabled = true;
                extractBtn.innerHTML = '⏳ Extracting...';
            }

            const sessionId = 'ws_' + Math.random().toString(36).substring(2, 15);
            progressText.innerHTML = '<i data-lucide="search" class="icon-sm"></i> Extracting Worksheet Content...';
            window.refreshQuizmokoIcons?.();
            overlay.style.display = 'flex';
            progressBar.style.width = '10%';

            const startTime = Date.now();
            const POLL_TIMEOUT = 600000; // 10 minutes total max for solving

            // Start Polling
            const pollInterval = setInterval(async () => {
                try {
                    // Check for client-side timeout
                    if (Date.now() - startTime > POLL_TIMEOUT) {
                        clearInterval(pollInterval);
                        alert('Solving timed out. Please check your internet connection and dashboard to see if the quiz was created.');
                        overlay.style.display = 'none';
                        return;
                    }

                    const res = await fetch(`/api/progress/${sessionId}`);
                    if (!res.ok) return;
                    const contentType = res.headers.get('content-type');
                    if (!contentType || !contentType.includes('application/json')) return;
                    
                    const data = await res.json();
                    if (data.message) progressText.innerText = window.QuizMoKoTeacher.progressLabel(data.message);
                    if (data.percentage) progressBar.style.width = data.percentage + '%';
                } catch(e) {}
            }, 2000);

            const formData = new FormData();
            for (let file of fileInput.files) formData.append('files', file);
            for (let file of pastedFiles) formData.append('files', file);

            formData.append('api_key', apiKey);
            formData.append('model_name', document.getElementById('model_select').value);
            formData.append('topic_hint', document.getElementById('topic_hint').value);
            formData.append('subject', document.getElementById('subject_input').value);
            formData.append('use_screenshots', document.getElementById('use_screenshots').checked);
            formData.append('session_id', sessionId);
            if (window.worksheetRecoveryId) formData.append('recovery_id',window.worksheetRecoveryId);

            try {
                const res = await fetch('/api/extract_worksheet', { method: 'POST', body: formData });
                const data = await res.json();
                clearInterval(pollInterval);

                if (data.success) {
                    progressBar.style.width = '100%';
                    progressText.innerHTML = '<i data-lucide="check-circle" class="icon-sm"></i> Extraction Complete!';
                    window.refreshQuizmokoIcons?.();

                    window.worksheetRecoveryId=data.recovery_id;
                    window.worksheetIncomplete=Boolean(data.incomplete);
                    if (data.incomplete) {
                        const warning=document.getElementById('page-recovery-warning') || document.createElement('div');
                        warning.id='page-recovery-warning'; warning.className='qm-owned-tasks'; warning.replaceChildren();
                        const text=document.createElement('p'); text.textContent='Some worksheet pages need another extraction attempt. Successful pages are retained. Keep these files selected; recovery expires after 30 minutes or a server restart.';
                        const retry=document.createElement('button');retry.type='button';retry.className='btn-secondary';retry.textContent='Retry failed pages';
                        retry.onclick=()=>{ isExtracting=false; handleExtract(); }; warning.append(text,retry);document.getElementById('extraction-preview').prepend(warning);
                    } else document.getElementById('page-recovery-warning')?.remove();
                    extractedQuestions = data.questions;
                    const priorWarning=document.getElementById('source-task-warning');priorWarning?.remove();
                    if (extractedQuestions.some(q=>q.source_review_required)) {
                        const warning=document.createElement('p');warning.id='source-task-warning';warning.className='qm-owned-tasks';
                        warning.textContent='Some source questions need review of shared context, drawings or task requirements. Solver agreement alone does not clear this source warning.';
                        document.getElementById('extraction-preview').prepend(warning);
                    }

                    missingIndices = data.missing_indices || [];
                    renderPreview();

                    const missingAlert = document.getElementById('missing-alert');
                    if (missingIndices.length > 0) {
                        missingAlert.style.display = 'flex';
                        document.getElementById('missing-indices-text').innerText = missingIndices.join(', ');
                    } else {
                        missingAlert.style.display = 'none';
                    }

                    setTimeout(() => {
                        document.getElementById('upload-card').style.display = 'none';
                        document.getElementById('extraction-preview').style.display = 'block';
                        overlay.style.display = 'none';
                        progressBar.style.width = '0%';
                        isExtracting = false;
                        if (extractBtn) {
                            extractBtn.disabled = false;
                            extractBtn.innerHTML = '<i data-lucide="search" class="icon-sm"></i> EXTRACT QUESTIONS';
                            window.refreshQuizmokoIcons?.();
                        }
                    }, 1000);
                } else {
                    alert('Extraction failed: ' + data.error);
                    isExtracting = false;
                    if (extractBtn) {
                        extractBtn.disabled = false;
                        extractBtn.innerHTML = '<i data-lucide="search" class="icon-sm"></i> EXTRACT QUESTIONS';
                        window.refreshQuizmokoIcons?.();
                    }
                }
            } catch (err) {
                alert('An error occurred during extraction.');
                isExtracting = false;
                if (extractBtn) {
                    extractBtn.disabled = false;
                    extractBtn.innerHTML = '<i data-lucide="search" class="icon-sm"></i> EXTRACT QUESTIONS';
                    window.refreshQuizmokoIcons?.();
                }
            } finally {
                overlay.style.display = 'none';
                progressBar.style.width = '0%';
            }
        }

        async function handleTargetedRetry() {
            const model = document.getElementById('model_select').value;
            const apiKey = await getUsableKey(model, 2);
            if (!apiKey) return alert('No API key available.');

            progressText.innerHTML = `<i data-lucide="search" class="icon-sm"></i> Recovering questions ${missingIndices.join(', ')}...`;
            window.refreshQuizmokoIcons?.();
            overlay.style.display = 'flex';

            const formData = new FormData();
            for (let file of fileInput.files) formData.append('files', file);
            for (let file of pastedFiles) formData.append('files', file);
            formData.append('missing_numbers', JSON.stringify(missingIndices));
            formData.append('topic_hint', document.getElementById('topic_hint').value);
            formData.append('subject', document.getElementById('subject_input').value);
            formData.append('api_key', apiKey);
            formData.append('model_name', model);

            try {
                const res = await fetch('/api/recover_questions', { method: 'POST', body: formData });
                const data = await res.json();
                if (data.success) {
                    data.recovered.forEach(rq => {
                        // Keep both legacy text aliases so recovery never drops
                        // source content while normalizing the response.
                        if (rq.question && !rq.raw_text) {
                            rq.raw_text = rq.question;
                        } else if (rq.raw_text && !rq.question) {
                            rq.question = rq.raw_text;
                        }

                        const idx = extractedQuestions.findIndex(q => sourceIdentifiersEqual(
                            getSourceQuestionId(q),
                            getSourceQuestionId(rq)
                        ));
                        if (idx !== -1) extractedQuestions[idx] = rq;
                        else extractedQuestions.push(rq);
                    });

                    sortExtractedQuestions();
                    missingIndices = Array.isArray(data.missing_numbers_remaining)
                        ? data.missing_numbers_remaining.map(value => String(value).trim()).filter(Boolean)
                        : missingIndices.filter(missingId => !data.recovered.some(question =>
                            sourceIdentifiersEqual(missingId, getSourceQuestionId(question))
                        ));

                    const missingAlert = document.getElementById('missing-alert');
                    if (missingIndices.length > 0) {
                        document.getElementById('missing-indices-text').innerText = missingIndices.join(', ');
                    } else {
                        missingAlert.style.display = 'none';
                    }
                    renderPreview();
                    alert(`Successfully recovered ${data.recovered.length} items!`);
                } else {
                    alert('Recovery failed: ' + data.error);
                }
            } catch (e) {
                alert('Error during recovery.');
            } finally {
                overlay.style.display = 'none';
            }
        }

        function renderPreview() {
            sortExtractedQuestions();
            const list = document.getElementById('questions-list');
            list.innerHTML = '';

            if (extractedQuestions.length > 0) {
                document.getElementById('empty-preview').style.display = 'none';
                document.getElementById('extraction-preview').style.display = 'block';
            }

            extractedQuestions.forEach((q, i) => {
                const item = document.createElement('div');
                item.className = 'question-item';
                const sourceQuestionId = getSourceQuestionId(q, i + 1) || String(i + 1);

                // --- NEW: TYPE SELECTION DROPDOWN ---
                const typeOptions = [
                    { val: 'multiple_choice', label: 'Multiple Choice' },
                    { val: 'multiple_choice_multi', label: 'Multiple Choice (Multi-Answers)' },
                    { val: 'true_false', label: 'True/False' },
                    { val: 'identification', label: 'Identification (Integer)' },
                    { val: 'open_ended', label: 'Open Ended / Descriptive' },
                    { val: 'graphing', label: 'Graphing / Drawing' }
                ];

                let typeSelectorHtml = `<select onchange="updateQuestionType(${i}, this.value)" style="width: auto; padding: 4px 8px; font-size: 11px; margin: 0; margin-right: 12px; background: var(--surface-elevated); color: var(--on-dark); border: 1px solid var(--primary); border-radius: 4px; font-weight: 700; cursor: pointer;">`;
                typeOptions.forEach(opt => {
                    typeSelectorHtml += `<option value="${opt.val}" ${q.type === opt.val ? 'selected' : ''}>${opt.label}</option>`;
                });
                typeSelectorHtml += `</select>`;

                // Check for captured screenshot in raw_text. Normalize only the
                // editable text so image markup/data URIs remain byte-for-byte intact.
                const rawQuestionText = String(q.raw_text || q.question || '');
                const imgMatch = rawQuestionText.match(/<div class="resizable-image-wrapper">.*?src="([^"]+)".*?<\/div>\s*<\/div>/is);
                const hasScreenshot = !!imgMatch;
                const imageMarkup = imgMatch ? imgMatch[0] : '';
                const cleanQuestionText = normalizeQuestionEditorText(
                    rawQuestionText.replace(/<div class="resizable-image-wrapper">.*?<\/div>\s*<\/div>/is, '').trim()
                );
                q.raw_text = cleanQuestionText + (imageMarkup ? '\n' + imageMarkup : '');
                if (q.question !== undefined) q.question = q.raw_text;

                item.innerHTML = `
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px;">
                        <div style="display: flex; align-items: center;">
                            ${typeSelectorHtml}
                            <span data-source-question-label style="font-weight: 800; color: var(--on-dark); font-size: 13px;"></span>
                        </div>
                        <div style="display: flex; gap: 8px;">
                            ${hasScreenshot ? `<button onclick="openCropRefiner(${i})" class="btn-secondary" style="font-size: 10px; padding: 4px 8px; border-color: var(--warning); color: var(--warning);"><i data-lucide="scissors" class="icon-sm"></i>️ REFINE CROP</button>` : ''}
                            <button onclick="removeQuestion(${i})" style="background: transparent; border: none; color: var(--m-red); font-size: 18px; cursor: pointer; padding: 4px;"><i data-lucide="trash-2" class="icon-sm"></i>️</button>
                        </div>
                    </div>
                    <div class="question-editor" contenteditable='true' data-index="${i}" style="padding: 12px; border: 1px solid var(--hairline); border-radius: 4px; background: var(--canvas); color: var(--on-dark); font-size: 14px; line-height: 1.5; white-space: pre-wrap; outline: none; transition: 0.2s;"></div>

                    ${hasScreenshot ? `<div style="margin-top: 12px; padding: 12px; background: var(--canvas); border-radius: var(--radius-sm); border: 1px solid var(--hairline); text-align: center;">${imageMarkup}</div>` : ''}
                `;
                item.querySelector('[data-source-question-label]').textContent = `Question ${sourceQuestionId}`;
                const editor = item.querySelector('.question-editor');
                editor.setAttribute('role','textbox');editor.setAttribute('aria-label','Worksheet question '+sourceQuestionId);
                if (editor) editor.textContent = cleanQuestionText;
                list.appendChild(item);
            });

            window.refreshQuizmokoIcons?.();
        }

        function syncAllDomEditors() {
            const list = document.getElementById('questions-list');
            if (!list) return;
            const editors = list.querySelectorAll('.question-editor');
            editors.forEach(ed => {
                const i = parseInt(ed.getAttribute('data-index'), 10);
                if (!isNaN(i) && extractedQuestions[i]) {
                    const text = normalizeQuestionEditorText(ed.innerText.trim());
                    const q = extractedQuestions[i];
                    const oldText = q.raw_text || q.question || '';
                    const imgMatch = oldText.match(/<div class="resizable-image-wrapper">.*?<\/div>\s*<\/div>/is);
                    const newFullText = text + (imgMatch ? '\n' + imgMatch[0] : '');
                    q.raw_text = newFullText;
                    q.question = newFullText;
                }
            });
        }

        // --- CROP REFINER LOGIC ---
        let cropper = null;
        let currentCroppingIndex = null;

        function openCropRefiner(index) {
            syncAllDomEditors();
            currentCroppingIndex = index;
            const q = extractedQuestions[index];
            const textContent = q.raw_text || q.question || '';
            const imgMatch = textContent.match(/src=["']([^"']+)["']/i);
            if (!imgMatch) return;

            const modal = document.getElementById('cropper-modal');
            const image = document.getElementById('cropper-image');

            if (cropper) {
                cropper.destroy();
                cropper = null;
            }

            modal.style.display = 'flex';

            image.onload = () => {
                cropper = new Cropper(image, {
                    viewMode: 1,
                    dragMode: 'move',
                    autoCropArea: 0.9,
                    restore: false,
                    guides: true,
                    center: true,
                    highlight: false,
                    cropBoxMovable: true,
                    cropBoxResizable: true,
                    toggleDragModeOnDblclick: false,
                });
                image.onload = null; // Prevent re-triggering
            };

            image.src = imgMatch[1];
        }

        function closeCropperModal() {
            document.getElementById('cropper-modal').style.display = 'none';
            if (cropper) {
                cropper.destroy();
                cropper = null;
            }
        }

        function saveCroppedImage() {
            if (!cropper) return;

            const canvas = cropper.getCroppedCanvas({
                maxWidth: 2000,
                maxHeight: 2000,
                fillColor: '#fff',
                imageSmoothingEnabled: true,
                imageSmoothingQuality: 'high',
            });

            const newBase64 = canvas.toDataURL('image/png');
            syncAllDomEditors();
            const q = extractedQuestions[currentCroppingIndex];

            // Replace old image HTML with new one
            const imgHtml = `<div class="resizable-image-wrapper"><div class="image-content-box" style="width: 100%;"><img src="${newBase64}" alt='Source Diagram'></div></div>`;

            // Strip old image wrapper and append new one
            const oldText = q.raw_text || q.question || '';
            const cleanText = oldText.replace(/<div class="resizable-image-wrapper">.*?<\/div>\s*<\/div>/is, '').trim();
            const updatedText = cleanText + '\n' + imgHtml;
            q.raw_text = updatedText;
            q.question = updatedText;

            renderPreview();
            closeCropperModal();
        }

        function updateQuestionType(index, type) {
            syncAllDomEditors();
            extractedQuestions[index].type = type;
        }

        function removeQuestion(index) {
            syncAllDomEditors();
            if (confirm('Remove this question from extraction?')) {
                extractedQuestions.splice(index, 1);
                renderPreview();
            }
        }

        function updateQuestionText(index, text) {
            const q = extractedQuestions[index];
            const oldText = q.raw_text || q.question || '';
            const imgMatch = oldText.match(/<div class="resizable-image-wrapper">.*?<\/div>\s*<\/div>/is);
            const updatedText = text + (imgMatch ? '\n' + imgMatch[0] : '');
            q.raw_text = updatedText;
            q.question = updatedText;
        }

        let isSolving = false;
        let trackedSolveId=sessionStorage.getItem('qm-worksheet-job');
        function showSolveStatus(text) {
            document.getElementById('extraction-preview').style.display='block';document.getElementById('empty-preview').style.display='none';
            const area=document.getElementById('worksheet-solve-progress');area.hidden=false;area.textContent=text;
        }
        window.addEventListener('qm-tasks-updated',event=>{
            const jobs=event.detail.filter(j=>j.task==='worksheet_solving');
            const job=jobs.find(j=>j.id===trackedSolveId) || jobs.find(j=>j.status==='running') || jobs[0];
            if(!job)return;
            trackedSolveId=job.id;sessionStorage.setItem('qm-worksheet-job',job.id);
            isSolving=job.status==='running';
            const button=document.getElementById('solve-btn');button.disabled=isSolving;
            button.textContent=isSolving?'Checking answers…':'Check answers & create draft';
            const published=!isSolving && job.quiz_state==='published';
            showSolveStatus(isSolving?(job.total && job.completed>=job.total?'Finalizing draft...':`Checking answers — ${job.completed}/${job.total}`):(published?'Saved quiz is Published.':job.error || 'Draft ready for review.'));
            if(!isSolving && job.quiz_id && job.quiz_state!==null){const link=document.createElement('a');link.className='btn btn-primary';link.href='/edit/'+encodeURIComponent(job.quiz_id);link.textContent=published?'Open Quiz':'Open Draft';document.getElementById('worksheet-solve-progress').append(link);}
            if(!isSolving){const again=document.createElement('button');again.type='button';again.className='btn btn-secondary';again.textContent='Start another';again.onclick=()=>{sessionStorage.removeItem('qm-task-worksheet_solving');sessionStorage.removeItem('qm-worksheet-job');trackedSolveId=null;again.disabled=true;again.textContent='Ready for a new worksheet';};document.getElementById('worksheet-solve-progress').append(again);}
        });
        async function handleSolve() {
            if (window.worksheetIncomplete) return alert('Retry the failed worksheet pages before checking answers.');
            if (isSolving) return;
            isSolving=true;document.getElementById('solve-btn').disabled=true;showSolveStatus('Starting answer checks…');
            syncAllDomEditors();
            const batchSize = parseInt(document.getElementById('batch_size').value);
            const model = document.getElementById('model_select').value;
            const isLocal = model.startsWith('ollama:');

            const estimatedRequests = Math.ceil(extractedQuestions.length / batchSize);
            let apiKey;
            try {apiKey=isLocal?null:await getUsableKey(model,estimatedRequests);}
            catch(error){isSolving=false;document.getElementById('solve-btn').disabled=false;showSolveStatus('Could not start answer checks: '+error.message);return;}

            if (!isLocal && !apiKey) {isSolving=false;document.getElementById('solve-btn').disabled=false;showSolveStatus(`No API keys with enough remaining quota (${estimatedRequests} calls needed) found today.`);return;}

            isSolving = true;
            const solveBtn = document.getElementById('solve-btn');
            if (solveBtn) {
                solveBtn.disabled = true;
                solveBtn.innerHTML = '⏳ Generating...';
            }

            const subject = document.getElementById('subject_input').value;
            const timeLimit = document.getElementById('time_limit').value;
            const topicHint = document.getElementById('topic_hint').value;
            const requireSolution = document.getElementById('require_solution').checked;

            const sessionId = 'solve_' + Math.random().toString(36).substring(2, 15);
            progressText.innerHTML = '<i data-lucide="sparkles" class="icon-sm"></i> Solving & Generating Quiz...';
            window.refreshQuizmokoIcons?.();
            showSolveStatus('Checking answers — 0/'+extractedQuestions.length);
            progressBar.style.width = '0%';

            const startTime = Date.now();
            const POLL_TIMEOUT = 600000; // 10 minutes total max for solving

            // Start Polling
            const pollInterval = setInterval(async () => {
                try {
                    // Check for client-side timeout
                    if (Date.now() - startTime > POLL_TIMEOUT) {
                        clearInterval(pollInterval);
                        alert('Solving timed out. Please check your internet connection and dashboard to see if the quiz was created.');
                        overlay.style.display = 'none';
                        isSolving = false;
                        if (solveBtn) {
                            solveBtn.disabled = false;
                            solveBtn.innerHTML = '<i data-lucide="sparkles" class="icon-sm"></i> CHECK ANSWERS & CREATE DRAFT';
                            window.refreshQuizmokoIcons?.();
                        }
                        return;
                    }

                    const res = await fetch(`/api/progress/${sessionId}`);
                    if (!res.ok) return;
                    const contentType = res.headers.get('content-type');
                    if (!contentType || !contentType.includes('application/json')) return;

                    const data = await res.json();

                    if (data.message) progressText.innerText = window.QuizMoKoTeacher.progressLabel(data.message);
                    if (data.percentage) progressBar.style.width = data.percentage + '%';

                    if (data.status === 'completed' && data.quiz_id) {
                        clearInterval(pollInterval);
                        progressBar.style.width = '100%';
                        setTimeout(() => {
                            window.location.href = `/edit/${data.quiz_id}`;
                        }, 500);
                    } else if (data.status === 'error') {
                        clearInterval(pollInterval);
                        alert('Solving failed: ' + (data.error || data.message));
                        overlay.style.display = 'none';
                        isSolving = false;
                        if (solveBtn) {
                            solveBtn.disabled = false;
                            solveBtn.innerHTML = '<i data-lucide="sparkles" class="icon-sm"></i> CHECK ANSWERS & CREATE DRAFT';
                            window.refreshQuizmokoIcons?.();
                        }
                    }
                } catch(e) {
                    // Suppress polling error logging to console when server restarts or network has transient issues
                }
            }, 2000);

            try {
                const res = await fetch('/api/solve_worksheet', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        async_job: true,
                        idempotency_key: await window.QuizMoKoTasks.key('worksheet_solving',{questions:extractedQuestions,batchSize,topic:topicHint,subject,timeLimit,requireSolution,model:document.getElementById('model_select').value,quizMode:document.getElementById('quiz_mode').value}),
                        questions: extractedQuestions,
                        create_draft: true,
                        batch_size: batchSize,
                        api_key: apiKey,
                        subject: subject,
                        time_limit: timeLimit,
                        quiz_mode: document.getElementById('quiz_mode').value,
                        topic: topicHint || 'Worksheet Quiz',
                        require_solution: requireSolution,
                        model_name: document.getElementById('model_select').value,
                        session_id: sessionId
                    })
                });

                if (!res.ok) {
                    const errData = await res.json();
                    throw new Error(errData.error || 'Failed to start solving');
                }

                const accepted = await res.json();
                if (accepted.job_id) {
                    clearInterval(pollInterval); overlay.style.display='none';
                    trackedSolveId=accepted.job_id;sessionStorage.setItem('qm-worksheet-job',trackedSolveId);
                    window.QuizMoKoTasks.accepted('worksheet_solving',accepted.job);
                }
                // Legacy servers retain the progress polling contract.
            } catch (error) {
                clearInterval(pollInterval);
                showSolveStatus('Solving failed: ' + error.message);
                overlay.style.display = 'none';
                isSolving = false;
                if (solveBtn) {
                    solveBtn.disabled = false;
                    solveBtn.innerHTML = '<i data-lucide="sparkles" class="icon-sm"></i> CHECK ANSWERS & CREATE DRAFT';
                    window.refreshQuizmokoIcons?.();
                }
            }
        }

        window.addEventListener('pageshow', () => {
            isExtracting=false;
            const button=document.getElementById('extract-btn');if(button)button.disabled=false;
            if(trackedSolveId){isSolving=true;document.getElementById('solve-btn').disabled=true;showSolveStatus('Restoring answer-check progress…');}
            window.QuizMoKoTasks.refresh();
        });

        // Use event delegation for question editing
        document.getElementById('questions-list').addEventListener('blur', function(e) {
            if (e.target && e.target.classList.contains('question-editor')) {
                const index = parseInt(e.target.getAttribute('data-index'), 10);
                updateQuestionText(index, e.target.innerText);
            }
        }, true);
    </script>
    <script>window.refreshQuizmokoIcons?.();</script>
</body>
</html>
