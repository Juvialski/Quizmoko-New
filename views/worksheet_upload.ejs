<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>QuizMoKo - Worksheet to Quiz</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/quizmoko-ui.css">
    <script src="/js/quizmoko-theme.js"></script>
    <script src="/js/math-display.js"></script>

    <!-- Cropper.js for manual screenshot refinement -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>

    <!-- MathJax for Math & LaTeX Equations -->
    <script>
        window.MathJax = {
            tex: { inlineMath: [['$', '$'], ['\\(', '\\)']], displayMath: [['$$', '$$'], ['\\[', '\\]']] },
            startup: { typeset: false }
        };
    </script>
    <script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>

    <style>
        * { box-sizing: border-box; }
        body { 
            font-family: 'Inter', sans-serif; 
            margin: 0; 
            padding: 40px 20px; 
            color: var(--body-strong); 
            background-color: var(--canvas);
            font-weight: 400;
            transition: background-color 0.3s ease, color 0.3s ease;
        }

        .file-list { margin-top: 16px; display: flex; flex-wrap: wrap; gap: 8px; }
        .file-tag { background: var(--surface-elevated); padding: 4px 12px; border-radius: 16px; font-size: 12px; border: 1px solid var(--hairline); word-break: break-all; overflow-wrap: anywhere; }

        .worksheet-panel { margin-bottom: 24px; }

        h1, h2, h3 { color: var(--on-dark); margin-top: 0; }
        .m-stripe { height: 4px; width: 60px; background: var(--primary); border-radius: 2px; margin-bottom: 24px; }

        .dropzone {
            border: 2px dashed var(--hairline); border-radius: var(--radius-md); padding: 40px; text-align: center;
            background: var(--surface-soft); cursor: pointer; transition: 0.2s; position: relative;
        }
        .dropzone:hover, .dropzone.dragover { border-color: var(--primary); background: rgba(99, 102, 241, 0.05); }
        .dropzone input { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }

        .file-list { margin-top: 16px; display: flex; flex-wrap: wrap; gap: 8px; }
        .file-tag { background: var(--surface-elevated); padding: 4px 12px; border-radius: 16px; font-size: 12px; border: 1px solid var(--hairline); }



        #extraction-preview { display: none; margin-top: 32px; }
        .question-item {
            background: var(--surface-soft); border: 1px solid var(--hairline); padding: 16px; border-radius: var(--radius-sm);
            margin-bottom: 12px; position: relative;
        }
        .q-type-badge {
            font-size: 10px; padding: 2px 8px; border-radius: 4px; background: var(--primary); color: white;
            text-transform: uppercase; font-weight: 800; margin-right: 8px;
        }
        .q-img-desc { font-style: italic; color: var(--primary); font-size: 12px; margin-top: 8px; }

        #progress-overlay {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.9);
            display: none; flex-direction: column; align-items: center; justify-content: center; z-index: 1000;
        }
        .progress-box { width: 300px; height: 8px; background: var(--hairline); border-radius: 4px; overflow: hidden; margin-top: 20px; }
        .progress-bar { height: 100%; background: var(--primary); width: 0%; transition: 0.3s; }

        /* Cropper Modal */
        #cropper-modal {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(15, 23, 42, 0.95);
            display: none; flex-direction: column; align-items: center; justify-content: center; z-index: 2000;
            padding: 40px; box-sizing: border-box;
        }
        .cropper-container-box { background: var(--surface-card); padding: 24px; border-radius: var(--radius-md); width: 100%; max-width: 900px; max-height: 80vh; display: flex; flex-direction: column; }
        .cropper-image-wrapper { flex: 1; overflow: hidden; background: #000; border-radius: var(--radius-sm); margin-bottom: 24px; }
        #cropper-image { max-width: 100%; display: block; }
    
        
        .question-editor:focus {
            border-color: var(--primary) !important;
            box-shadow: 0 0 0 2px rgba(99, 102, 241, 0.2);
            outline: none;
        }

    </style>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="/js/teacher-workflow.js"></script>
    <script src="/js/owned-tasks.js"></script>
</head>
<body class="r4-teacher r4-worksheet-upload">
    <div class="top-header-bar" style="max-width: 1800px; margin: 0 auto 32px auto; display: flex; justify-content: space-between; align-items: flex-start; padding: 0;">
        <div>
            <h1 style="margin: 0; color: var(--body-strong); font-weight: 700; font-size: 36px; letter-spacing: -0.5px;" id="dashboard-header">
                <i data-lucide="rocket" class="icon-md" style="margin-right:6px;"></i> QuizMoKo <span style="font-size:16px; color:var(--body); font-weight:400; letter-spacing: 0; vertical-align: middle;">Teacher</span>
